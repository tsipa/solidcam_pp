#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
run_python() {
    if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1; then
        python3 "$@"
        return
    fi
    if command -v python >/dev/null 2>&1 && python -c 'import sys' >/dev/null 2>&1; then
        python "$@"
        return
    fi
    if command -v py >/dev/null 2>&1 && py -3 -c 'import sys' >/dev/null 2>&1; then
        py -3 "$@"
        return
    fi
    echo 'Commit checks require Python 3; refusing the Git operation.' >&2
    return 1
}
status=0
run_python .githooks/check_commit_identity.py --staged || status=1
run_python .codex/skills/sinumerik-backups/scripts/check_credentials.py --staged || status=1
exit $status
