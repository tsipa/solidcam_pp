#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys' >/dev/null 2>&1; then
    exec python3 .codex/skills/sinumerik-backups/scripts/check_credentials.py --staged
fi
if command -v python >/dev/null 2>&1 && python -c 'import sys' >/dev/null 2>&1; then
    exec python .codex/skills/sinumerik-backups/scripts/check_credentials.py --staged
fi
if command -v py >/dev/null 2>&1 && py -3 -c 'import sys' >/dev/null 2>&1; then
    exec py -3 .codex/skills/sinumerik-backups/scripts/check_credentials.py --staged
fi
echo 'Credential check requires Python 3; refusing the Git operation.' >&2
exit 1
