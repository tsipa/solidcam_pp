@init_post

    global string sUS_date sUS_time sUsrmsg sHomestr sHomestrbegin sHomestrtc sHomestrend sHomestrstpdiff sHomestrstpsame sHomeline
    global string cWo cPb cPe cG84 cG84p cCycs cHomep cTCcodep cTCcodes fG84spin cDr cCb cCe cOMb cOMe
    global logical bStartFile bTlchg bWorkoffsettc bFirstMove bFirstRapid
    global logical bTlist bTlseperation bTcseperation bDateTimeOutput bStopM00difftool bToolPreselect bToolChangeAtEnd
    global logical bSafetyprep bSyncdrapid bFeedoutput bNnumtc bskipline bVertical bFirstVert bR1useDir5a bR1forceOutput
    global logical bOptstpbegin bOptstptc bOptstpend bUseprognum bUseprogname bCoolspinaftertc
    global logical bCoolExist bCoolofftc bSpinofftc bCooloffend bSpinoffend bG84spin bTmatrixIndexPending
    ; bPostHomed: the post homed the axes after the last positioning move (usr_home_axis); the next
    ; move reprograms X/Y/Z. usr_rapid_xyz keeps it set to its end as the homed-return marker.
    global logical bIndexClearancePending bCamLinkRetract bJobPositioned bPostHomed bClimbZValid bFeedPrevValid
    ; Per-rapid decisions of usr_rapid, shared by its stages (set before they are read).
    global logical bCamLinkRapid bRapidRotaryChanged
    global logical bWorkpieceBuffered bWorkpieceUsesA
    global string sWorkpieceBodyPath sWorkpieceArgs
    global integer iFeedMode iCompActive
    global numeric nInvFeed nMaxInverseFeed nSqrt nFeedPrevX nFeedPrevY nFeedPrevZ nFeedPrevA nFeedPrevR1 nR1posstep
    global string nInvFeed_f
    global numeric nLastPathZ nLastPathWorkoffset
    global integer iMplane iAbsincmode iWorkoffset iStopmode iMotionmode iPworkoffset
    global integer iDiametercomp iDrillmode iTcnumber iSpindleDir iR1dirMode
    global integer iDiameteroffset iArcmode
    global integer iHomingmode iWorkOffsetmode iProgendmode iG187_P_gpp iPal1 iPal2
    global integer iCoolantM1 iCoolantM2 iCoolantM3 iCoolantM4 iCoolantM5 iCoolantM6 iCoolantM7 iCoolantM8
    global integer iCoolantM1ON iCoolantM2ON iCoolantM3ON iCoolantM4ON iCoolantM5ON iCoolantM6ON iCoolantM7ON iCoolantM8ON
    global integer iCoolantM1OFF iCoolantM2OFF iCoolantM3OFF iCoolantM4OFF iCoolantM5OFF iCoolantM6OFF iCoolantM7OFF iCoolantM8OFF
    global numeric nTcXnext nTcYnext nTcCnext nRapidfeed nG187_E_gpp

    global numeric nR1pos nR1pos5x nR1postmatrix nR1postransform nR1poscpos iR1dir nPR1pos nR1postemp nPR1postemp
    global numeric nR2pos nR2pos5x nR2postmatrix iR2dir nPR2pos
    global numeric nPtool_start_plane nPtool_z_level
    global string  cR1 cR2 sHomestrrot sHomestrrotv sHomestrroth nR1pos_f bpos_f
    global integer i4xIndexMode i4xIndexClearanceMode i4xFeedMode
    global integer iGear1 iGear2 iGear3 iGear4
    global string P_Dwell_f
    global numeric last_spin spindle_accel

    ; Non GPPL variables
    last_spin = 0
    spindle_accel = 500 ; rpm/s
    bR1forceOutput = true

    num_user_procs =    1
    remove_blanks = FALSE
    line_labels    = FALSE     ; Jump to N...
    clear_change_after_gen = 1

    ; GPPL variables
    numeric_def_f   = '8.5'
    integer_def_f   = '5.0(p)'
    gcode_f         = '2.0(p)'
    mcode_f         = '2.0(p)'
    xpos_f          = '8.5'
    ypos_f          = '8.5'
    ; zpos_f becomes '5.4' at the first head homing (usr_head_home_select: first rapid or tool change).
    zpos_f          = '8.5'
    nR1pos_f        = '7.3'
    apos_f          = '5.3'
    bpos_f          = '5.3'
    feed_f          = '4.4(P)'
    nInvFeed_f      = '5.3'
    P_Dwell_f       = '4.4(P)'
    blknum_f        = '5.0(p)'
    blknum_gen      = true
    call @usr_ip_useroptions
    call @usr_ip_postwriteroptions
endp

@usr_ip_useroptions
    ; Handle setting of options -- For users
    ;Machine Definition
    bToolPreselect        = TRUE                ;True = Next tool is Preselected after tool change
    bSyncdrapid           = TRUE                ;True = Machine Sync's Rapid Motion (Non-Box Move)
    nRapidfeed            = 650.                ;Set your value for Max Feed in G1 (Used with Non-Sync'd Rapid Moves)
    bUseprognum           = false               ;True = Outputs Program Number
    bUseprogname          = TRUE                ;True = Outputs Program Name
    iArcmode              = 2                   ;Sets Arc Output Mode (1=AbsIJK, 2=IncIJK, 3=R 360AbsIJK, 4=R 360IncIJK)
    ; Only iArcmode 2 is Sinumerik syntax: 1/3/4 print Fanuc words (absolute centre as plain I/J/K,
    ; R instead of CR=), known defect PP-022.
    cTCcodep              = 'M06 '             ;Sets the Prefix Code(s) used for Tool Change (i.e. 'M06')
    cTCcodes              = ''                  ;Sets the Suffix Code(s) used for Tool Change (i.e. 'M06')
    cWo                   = 'G'                 ;Sets the Character(s) used for Work Offset (i.e. G,E,G54.1 P)
    iWorkOffsetmode       = 1                   ;Sets the Mode used for Work Offset (1=G54, 2=E1, 3=G54.1 P1)
    iProgendmode          = 1                   ;Sets the code for ending a program (1=M30,2=M2)
    cPb                   = ';%_N_'              ;Sets the Character(s) used for the beginning of file (i.e %)
    cPe                   = ''                 ;Sets the Character(s) used for the end of file (i.e %)
    cCb                   = ';'                 ;Sets the begginning Character(s) for comments
    cCe                   = ''                  ;Sets the ending Character(s) for comments
    cOMb                   = 'MSG("'            ;Sets the begginning Character(s) for operator message
    cOMe                   = '")'               ;Sets the ending Character(s) for operator message
    ; cDr, cG84, cG84p, bG84spin, fG84spin and cCycs are Fanuc template options: not read by this post.
    cDr                   = ''                  ;Sets the Character(s) used at the begging of a drill cycle (i.e. G98,G98,or nothing '')
    cG84                  = ''                  ;Sets the Drill Cycle Character(s) used tapping (i.e. G84, G84.1)
    cG84p                 = ''                  ;Sets the Preperation Line used for G84 Tapping (i.e. G84.2)**FADAL setting
    bG84spin              = false               ;True = RPM is output during G84 Tapping Cycles
    fG84spin              = '5.1'               ;Sets Formatting for RPM used for G84 Tapping Cycles ('5.1' = Decimal point 1 place)
    cCycs                 = 'L0 '               ;Sets the Suppression Code to ignore Drill Cycles (i.e. LO)

    ;Coolant & Spindle Control
    flood_coolant               = 1
    bCoolExist					= true          ;True = Outputs Coolant codes (Coolant,Air,Mist,etc)
    bCoolofftc					= true          ;True = Outputs Coolant off between Tool Changes
    bSpinofftc					= true          ;True = Outputs Spindle off between Tool Changes
    ; bCoolofftc and bSpinofftc are not read: tool changes use bCooloffend and bSpinoffend.
    bCooloffend					= true          ;True = Outputs Coolant off at end of program
    bSpinoffend					= true          ;True = Outputs Spindle off at end of program
    bCoolspinaftertc			= false         ;True = Outputs Coolant&Spindle directly after Tool Change
    ; iGear1-4 and iPal1/iPal2 are not read by this post.
    iGear1						= 41            ;Code: M code for low spindle gear
    iGear2						= 42            ;Code: M code for low spindle gear
    iGear3						= 43            ;Code: M code for low spindle gear
    iGear4						= 44            ;Code: M code for low spindle gear
    iCoolantM1ON				= 8             ;Code: Flood Coolant ON
    iCoolantM1OFF				= 9             ;Code: Flood Coolant OFF
    iCoolantM2ON				= 7             ;Code: Mist Coolant ON
    iCoolantM2OFF				= 9             ;Code: Mist Coolant OFF
    iCoolantM3ON				= 130           ;Code: HP-Flood Coolant ON
    iCoolantM3OFF				= 9             ;Code: HP-Flood Coolant OFF
    iCoolantM4ON				= 8             ;Code: LP-Flood Coolant ON
    iCoolantM4OFF				= 9             ;Code: LP-Flood Coolant OFF
    iCoolantM5ON				= 77           ;Code: High Pressure Coolant Through Tool ON
    iCoolantM5OFF				= 9             ;Code: High Pressure Coolant Through Tool OFF
    iCoolantM6ON				= 51            ;Code: Low Pressure Coolant Through Tool ON
    iCoolantM6OFF				= 9             ;Code: Low Pressure Coolant Through Tool OFF
    iCoolantM7ON				= 50            ;Code: Air Blast ON
    iCoolantM7OFF				= 9             ;Code: Air Blast OFF
    iCoolantM8ON				= 92            ;Code: Air Through Tool ON
    iCoolantM8OFF				= 9             ;Code: Air Through Tool OFF
    iPal1						= 911           ;code: pallet in
    iPal2						= 912           ;code: pallet in

    ;User Preferences
    bTlist						= true          ;True = Outputs tool list at beginning of program
    bTlseperation				= false         ;True = Seperates Tool List by blank line(s)
    bTcseperation				= false         ;True = Outputs a blank line before every tool change after the first
    bDateTimeOutput             = true          ;True = Outputs Date & Time
    bToolChangeAtEnd			= false         ;True = Tool Change for First Tool at end of program
    bOptstpbegin				= false         ;True = Outputs Optional Stop at beginning of program
    bOptstptc					= true          ;True = Outputs Optional Stop between Tool Changes
    bOptstpend					= false         ;True = Outputs Optional Stop at end of program
    bWorkoffsettc				= true          ;True = Forces output of Work Offset at each Tool Change
    bNnumtc						= False         ;True = Outputs N Numbers at Tool Changes (i.e. N1,N2,N3)
    blknum_exist				= False         ;True = Outputs Line Numbers
    blknum						= 200           ;Sets Starting Line Number
    blknum_delta				= 10            ;Sets the delta for Line Numbers
    blknum_max					= 99999         ;Sets the maximum value for Line Numbers

    ;Homing Format Definitions
    ;[integer:][Prepstr :][AxisStr1 ;][AxisStrN]
    ;integer = Homing Output Mode (1=G28, 2=G28 G91, 3=G53 Non-Modal, 4=G53 Modal, 5=G30, 6=G30 G91 7=G90 G54 8= ANY STRING)
    ;PrepStr = Sets the code(s) for the begging of line used for Homing Axis (i.e. 'G00')
    ;AxisStr = Homing Axis Definition (i.e. 'Z0.0', 'H0.0 W0.')
    ;Note: You can define up to 49 "Homing Lines" seperated by ";"
    ;Note: Only use ";" if using more then 1 "Homing Line"
    ;Note: Define string as empty '' to ignore Specific Homing Definition
    ;Note: Only mode 8 (the line as given, here Sinumerik G75) suits this control; 1-7 are Fanuc forms.
    sHomestrbegin         = '8::G75 Z1=0. ;8::G75 Y1=0 X1=0'                           ; Program Begin Homing Definition
    sHomestrtc            = '8::G75 Z1=0. ;8::G75 Y1=0 X1=0'                           ; Tool Change Homing Definition
    sHomestrend           = '8::G75 Z1=0. ;8::G75 Y1=0 X1=0'                     ; Program End Homing Definition
    sHomestrstpsame       = ''                 ; M00 Same Tool Homing Definition
    sHomestrstpdiff       = ''      ; M00 Different Tool Homing Definition
    sHomestrrotv           = '8::G75 Z1=0. ;8::G75 Y1=0 X1=0'                     ;Between Rotations
    sHomestrroth           = '8::G75 Z1=0. ;8::G75 Y1=0 X1=0'                     ;Between Rotations

    iR1dir                = -1         ;Rotary 1 direction 1=+CCW -1=+CW
    iR2dir                = 1         ;Rotary 2 direction 1=+CCW -1=+CW
    cR1                   = 'A'       ;Rotary 1 Axis
    cR2                   = 'B'       ;Rotary 2 Axis
    i4xIndexMode          = 0         ;4x-Indexing control (0=Simple Rotation, 1=New WorkOffset)
    i4xIndexClearanceMode = 0         ;4x-Index Clearance control (0=Z-Homing, 1=Z-Tool_Z_Level, 2=Z-Tool_start_plane)
    i4xFeedMode           = 1         ;4x-Simultanious control (0=Programed feedRate, 1=Inverse Time FeedRate, 2=Deg. per Minute)
    nMaxInverseFeed       = 59999.99  ;G93 F limit, 1/min (VMID MaxInverseFeed)

endp

@usr_ip_postwriteroptions
    ; Options for post writers: tracing.
    ; trace "all":5
    ; trace "@tmatrix":5
    ; trace "@def_tool":5
    ; trace "@drill_point":5
endp

;-------------------

@start_of_file
    ; Start of the NC file (first event after @init_post): file name, path, date, the part messages.
    bWorkpieceBuffered = false
    bWorkpieceUsesA = false
    call @usr_check_options
    call @usr_init_gmstates
    call @usr_sof_character
    call @usr_sof_progname
    call @usr_sof_commentsbeforecodes
    call @usr_sof_gmcodes
    call @usr_sof_commentsaftercodes
    bStartFile = true
    if message1 ne ''
        {NL, cCb message1 cCe }
    endif
    if message2 ne ''
        {NL, cCb message2 cCe }
    endif
    if message3 ne ''
        {NL, cCb message3 cCe }
    endif
    if message4 ne ''
        {NL, cCb message4 cCe }
    endif
    if message5 ne ''
        {NL, cCb message5 cCe }
    endif
    if message6 ne ''
        {NL, cCb message6 cCe }
    endif
    if message7 ne ''
        {NL, cCb message7 cCe }
    endif
    if message8 ne ''
        {NL, cCb message8 cCe }
    endif
    if message9 ne ''
        {NL, cCb message9 cCe }
    endif
    if message10 ne ''
        {NL, cCb message10 cCe }
    endif
endp

@usr_check_options
    ; Stop on settings this Sinumerik 828D post does not support (template features for other
    ; controls). Checked once at the start of the file, after the user options are set.
    local numeric dummy_var
    if iNumber_of_Fixtures > 1
        dummy_var = 0
        input '"POST ERROR: Multiple fixtures (more than one fixture in the job) are not supported by this post."'dummy_var
        {nb,"POST ERROR: Multiple fixtures (more than one fixture in the job) are not supported by this post."}
        abort
    endif
    if i4xIndexMode ne 0 and i4xIndexMode ne 1
        dummy_var = 0
        input '"POST ERROR: i4xIndexMode must be 0 or 1 (2 was a Fanuc trig macro)."'dummy_var
        {nb,"POST ERROR: i4xIndexMode must be 0 or 1 (2 was a Fanuc trig macro)."}
        abort
    endif
endp

@usr_unsupported_event
    ; Stop on a SolidCAM event this post does not support (subprograms, loops, G10 offset writes).
    local numeric dummy_var
    dummy_var = 0
    input '"POST ERROR: SolidCAM subprograms, loops and reference point changes are not supported by this post."'dummy_var
    {nb,"POST ERROR: SolidCAM subprograms, loops and reference point changes are not supported by this post."}
    abort
endp

@usr_sof_character
    ; Handle start of file character
    {,cPb}
endp

@usr_sof_progname
    ; Handle Program Number and/or Name
    Local Integer name1 name2
    Local string part_name1 part_name2
    name1 = strlen(part_name)
    name2 = instr(part_name,'-')
    while name2 gt 0
        name2 = instr(part_name,'-')
        if name2 gt 0
            part_name = left(part_name,(name2-1)) + '_' + right(part_name,(name1-name2))
        endif
    endw
    if bUseprognum
        {nl, 'O'(program_number)}
        if bUseprogname
            {nl,cCb, part_name,cCe}
        endif
    else
        if bUseprogname
            {part_name'_MPF' }
            if strlen(sWorkpcDir) eq 0
                {nl,cCb, '$PATH=/_N_WKS_DIR/_N_WPD'  ,cCe}
            else
                {nl,cCb, '$PATH=/_N_WKS_DIR/_N_'sWorkpcDir '_WPD' ,cCe}
            endif
        endif
    endif
endp

@usr_sof_commentsbeforecodes
    ; Handle HardCoded or PartControlled comments  (Before G/M codes)
    call @usr_US_date
    call @usr_US_time
    if bDateTimeOutput
        {nl,cCb,sUS_date'-'sUS_time,cCe}
    endif
endp

@usr_sof_gmcodes
    ; Handle HardCoded or PartControlled G/M codes
endp

@usr_sof_commentsaftercodes
    ; Handle HardCoded or UserDefined comments (After G/M codes)
    if bTlseperation
        {nl}
        {nl}
        {nl}
    endif
endp

@usr_US_date
    ; Converts Europe Date format to US format
    Local Integer iInt1
    iInt1 = instr(date,'-')
    sUS_date = substr(date,(iInt1+1),3) + '-' + substr(date,1,(iInt1-1)) + '-' + right(date,4)
endp

@usr_US_time
    ; Converts Military time to 12hr format
    Local Integer iInt1 iHr_Mil_int iHour
    Local String iHr_Mil iTm_of_day
    iInt1 = instr(time,':')
    iHr_Mil = left(time,(iInt1-1))
    iHr_Mil_int = tonum(iHr_Mil)
    if iHr_Mil_int < 12
        if iHr_Mil_int < 1
            iHour = 12
        else
            iHour = iHr_Mil_int
        endif
        iTm_of_day = 'AM'
    else
        if iHr_Mil_int < 13
            iHour = 12
        else
            iHour = iHr_Mil_int - 12
        endif
        iTm_of_day = 'PM'
    endif
    sUS_time = tostr(iHour:'5.0(p)') + substr(time,iInt1,8) + iTm_of_day
endp

@usr_init_gmstates
    ; Handle initializing G/M codes for correct modality from beginning of file
    iMotionmode     = 9999
    iMplane         = 17
    iAbsincmode     = 90
    ; 9999 is no code output yet: the first real value differs from it, so its change flag forces the output.
    iWorkoffset     = 9999
    iDiametercomp   = 9999
    iCompActive     = 9999
    iDrillmode      = 9999
    ; Tool change counter (N number of the tool change block with bNnumtc): 2001 for the first tool,
    ; +1 for every later tool.
    iTcnumber       = 2001
    iCoolantM1      = iCoolantM1OFF
    iCoolantM2      = iCoolantM2OFF
    iCoolantM3      = iCoolantM3OFF
    iCoolantM4      = iCoolantM4OFF
    iCoolantM5      = iCoolantM5OFF
    iCoolantM6      = iCoolantM6OFF
    iCoolantM7      = iCoolantM7OFF
    iCoolantM8      = iCoolantM8OFF
    iG187_P_gpp     = 2
    nG187_E_gpp     = 0
    nR1pos          = 9999
    bTmatrixIndexPending = false
    bIndexClearancePending = true
    bCamLinkRetract = false
    bJobPositioned = false
    bPostHomed = false
    bClimbZValid = false
    iFeedMode = 94
    change(iFeedMode) = false
    bFeedPrevValid = false
    nFeedPrevX = 0
    nFeedPrevY = 0
    nFeedPrevZ = 0
    nFeedPrevA = 0
    nFeedPrevR1 = 0
    nLastPathZ = 0
    nLastPathWorkoffset = -9999
    nPR1pos			 = 0
    nPR1postemp     = 0
    change(cWo)		 = false
    change(cR2)		 = false
    change(cR1)		 = false
    bFirstVert      = true
endp

;-------------------

@def_tool
    ; Handle Tool List Output at top of program
    ; Use bTlchg to use different message for tool_change
    if bTlist
        if tool_message == '' then
            {nl, cCb'TOOL 'tool_number, ' - DIA '(tool_offset*2),' | HOLDER: ',holder_name,' | STICKOUT: ',tool_length:'5.3',' mm',cCe }
        else
            {nl,cCb'T'tool_number,'-' tool_message,' | HOLDER: ',holder_name,' | STICKOUT: ',tool_length:'5.3',' mm',cCe}
            if msg_mill_tool1 ne ''
                {nl,cCb'---' msg_mill_tool1,cCe}
            endif
            if msg_mill_tool2 ne ''
                {nl,cCb'---' msg_mill_tool2,cCe}
            endif
            if msg_mill_tool3 ne ''
                {nl,cCb'---' msg_mill_tool3,cCe}
            endif
            if msg_mill_tool4 ne ''
                {nl,cCb'---' msg_mill_tool4,cCe}
            endif
            if msg_mill_tool5 ne ''
                {nl,cCb'---' msg_mill_tool5,cCe}
            endif
        endif
        if next_command ne '@def_tool' and bTlchg eq false
            if bTlseperation
                {nl}
                {nl}
                {nl}
            endif
            if bOptstpbegin
                call @usr_optionalstop
            endif
            {nl, 'MSG(" Loading Zeropoints ")'}
            call @usr_workpiece_begin
        endif
    endif
endp

;-------------------

@usr_workpiece_stock
    ; Siemens SINUMERIK Operate blank definition:
    ; https://support.industry.siemens.com/cs/mdm/109760802?c=87879191435&dl=nl&lc=en-US
    ;
    ; General syntax:
    ; WORKPIECE("<WP>","<RefP>","<ZeroOffset>","<Type>",Par5,Par6,...,Par12)
    ;
    ; <WP> is optional. Empty <WP> lets the control use its default WORKP<n> name.
    ; <RefP> is the clamping reference for milling machines:
    ;   empty   = current/default table reference
    ;   "Table" = fixed table clamping
    ;   "A"     = blank clamped on rotary axis A
    ;   "B"     = blank clamped on rotary axis B
    ;   "C"     = blank clamped on rotary axis C
    ; <ZeroOffset> is not programmable in the part program; an empty value means the
    ; blank is related to the currently active work offset.
    ;
    ; Par5 is a bit parameter. With Par5 = 0 the following size parameters are
    ; interpreted incrementally where Siemens allows inc/abs selection.
    ;
    ; "RECTANGLE" is Siemens' centered cuboid, not an arbitrary XY box:
    ;   Par6  = Z0 reference point
    ;   Par7  = Z1 length
    ;   Par8  = ZB machining dimension
    ;   Par9  = W width
    ;   Par10 = L length
    ;   Par11 = rotation about rotary axis
    ;
    ; "BOX" is Siemens' non-centered cuboid:
    ;   Par6  = Z0 reference point
    ;   Par7  = Z1 length
    ;   Par8  = ZB machining dimension
    ;   Par9  = X0
    ;   Par10 = Y0
    ;   Par11 = X1
    ;   Par12 = Y1
    ; With Par5 = 0, X1/Y1/Z1/ZB are incremental. Therefore for a SolidCAM stock
    ; box we output X0/Y0 from stock_*_minus and X1/Y1 as stock_x/stock_y sizes.
    ;
    ; BOX geometry is independent of the clamping reference. The header is emitted
    ; after scanning the body, but before that body is copied into the final file.
    if !bWorkpieceBuffered
        call @usr_workpiece_data
    endif
    if bWorkpieceUsesA
        {nl, 'WORKPIECE(,"A",' sWorkpieceArgs}
    else
        {nl, 'WORKPIECE(,,' sWorkpieceArgs}
    endif
endp

@usr_workpiece_data
    ; Snapshot the stock in the initial MAC before later jobs change CAM values.
    ; Preserve the header's numeric format even if motion output changes xpos_f.
    sWorkpieceArgs = ',"BOX",0,' + tostr(stock_z_plus:xpos_f)
    sWorkpieceArgs = sWorkpieceArgs + ',' + tostr((stock_z_minus - stock_z_plus):xpos_f)
    sWorkpieceArgs = sWorkpieceArgs + ',' + tostr((target_z_minus - stock_z_plus):xpos_f)
    sWorkpieceArgs = sWorkpieceArgs + ',' + tostr(stock_x_minus:xpos_f) + ',' + tostr(stock_y_minus:xpos_f)
    sWorkpieceArgs = sWorkpieceArgs + ',' + tostr(stock_x:xpos_f) + ',' + tostr(stock_y:xpos_f) + ')'
endp

@usr_workpiece_begin
    if !bWorkpieceBuffered
        sWorkpieceBodyPath = full_g_file_name + '.workpiece.tmp'
        call @usr_workpiece_data
        {nl, '!!open file=' sWorkpieceBodyPath '!!'}
        bWorkpieceBuffered = true
    endif
endp

@usr_workpiece_flush
    if bWorkpieceBuffered
        {nl, '!!close file=' sWorkpieceBodyPath '!!'}
        call @usr_workpiece_stock
        {nl, '!!copy file=' sWorkpieceBodyPath '!!'}
        {nl, '!!delete file=' sWorkpieceBodyPath '!!'}
        bWorkpieceBuffered = false
    endif
endp

;-------------------

@start_program
    ; Handle any safety G/M codes for top of program
    sHomestr = sHomestrbegin
    call @usr_prep_home_axis
endp

;-------------------

@end_program
    ; Handle output for end of program
    change(iWorkoffset) = false
    if bCooloffend and bCoolExist
        call @usr_coolant_prep_all_off
        call @usr_coolant_output
    endif
    if bSpinoffend
        call @usr_spindle_stop
    endif
    sHomestr = sHomestrend
    call @usr_prep_home_axis
    change(iAbsincmode) = false
    if change(iWorkoffset)
        {nb}
        call @usr_homenumber_output
    endif
    if bOptstpend
        call @usr_optionalstop
    endif
    if bToolChangeAtEnd
        {nb,cTCcodep'T'next_tool_number' 'cTCcodes}
    endif
    if iProgendmode eq 1
        {nb, 'M30'}
        {nl}
    endif
    if iProgendmode eq 2
        {nb, 'M2'}
        {nl}
    endif

endp

;-------------------

@end_of_file
    ; End of file character
    if cPe ne ''
        {nl,cPe}
    endif
    call @usr_workpiece_flush
endp

;-------------------

@relative_mode
    ; Handle setting of IncrementalMode Gcode
    iAbsincmode = 91
endp

@absolute_mode
    ; Handle setting of AbsoluteMode Gcode
    iAbsincmode = 90
endp

@usr_abs_inc_output
    ; Handle output of Absolute/Incremental Mode Gcode
    {['G'iAbsincmode, ' ']}
endp

;-------------------

@machine_plane
    ; SolidCAM event: the job's machining plane (iMplane); the motion blocks print it.
    if machine_plane eq XY
        iMplane = 17
    endif
    if machine_plane eq ZX
        iMplane = 18
    endif
    if machine_plane eq YZ
        iMplane = 19
    endif
endp

@usr_job_plane
    ; Select the job's machining plane (G17 when SolidCAM leaves machine_plane empty or unknown).
    ; Assign only on a change: an equal-value assignment could clear a pending change flag.
    local integer iJobPlane
    iJobPlane = 17
    if machine_plane eq ZX
        iJobPlane = 18
    endif
    if machine_plane eq YZ
        iJobPlane = 19
    endif
    if iMplane ne iJobPlane
        iMplane = iJobPlane
    endif
endp

;-------------------

@home_number
    ; Handle setting WorkOffset Gcode
    if iWorkOffset_Method eq 0
        if iWorkOffsetmode eq 1
            iWorkoffset = 54
        endif
        if iWorkOffsetmode eq 2 or iWorkOffsetmode eq 3
            iWorkoffset = tonum(substr(home_user_name,(instr(home_user_name,'P') + 1),2))
            if iWorkoffset eq 0
                iWorkoffset = tonum(substr(home_user_name,(instr(home_user_name,'p') + 1),2))
                if iWorkoffset eq 0
                    iWorkoffset = position
                endif
            endif
        endif
    else
        iWorkoffset = tonum(home_user_name)
    endif
endp

@usr_homenumber_output
    ; Handle output WorkOffset Gcode
    {[cWo,iWorkoffset' ']}
    change(cWo) = false
    change(iWorkoffset) = false
endp

;-------------------

@change_tool
    bIndexClearancePending = true
    bCamLinkRetract = false
    bJobPositioned = false
    ; Delayed Tool Change handling to @start_of_job to have access to Operation(Job) data
    nTcXnext = xnext
    nTcYnext = ynext
    nTcCnext = cnext
    bTlchg = true
endp

@usr_ct
    ; Tool change: stop and home the old tool (or the safety block before the first), T / M6 / D1,
    ; then spindle, coolant and the positioning rapid of the new tool.
    if !first_tool
        iTcnumber = iTcnumber + 1
    endif
    bStartFile = false
    call @usr_tc_init_gmstates
    if !first_tool
        call @usr_ct_before_notfirsttool
    else
        call @usr_ct_before_firsttool
    endif
    call @usr_ct_toolchange
    call @usr_ct_after
endp

@usr_ct_before_notfirsttool
    ; Handle output before the next tool change
    ; This is not called before the first tool change
    if !bStopM00difftool
        if bCooloffend and bCoolExist
            call @usr_coolant_prep_all_off
            call @usr_coolant_output
        endif
        if bSpinoffend
            call @usr_spindle_stop
        endif
        if bVertical or bFirstVert
            ; No rapid since the program start (bFirstVert) or the head was vertical: home with the
            ; head-orientation homing (sHomestrrotv) instead of the tool-change homing.
            call @usr_head_home_select
            bVertical = false
        else
            sHomestr = sHomestrtc
        endif
        call @usr_prep_home_axis
        if bOptstptc
            call @usr_optionalstop
        endif
    endif
    if bTcseperation
        {nl}
    endif
    call @usr_ct_safety_block
endp

@usr_ct_before_firsttool
    ; Handle output before the first tool change
    call @usr_ct_safety_block
endp

@usr_ct_safety_block
    ; Safety block before the T word of every tool change: G17 G40 G64 G90 (after N<iTcnumber>
    ; with bNnumtc). It also resets the modal states for the new tool.
    bSafetyprep = true
    call @usr_tc_init_gmstates
    if bNnumtc
        {nl,'N'iTcnumber' '}
        skipline = false
    else
        {nb,cCb}
    endif
    {nb, 'G17 G40 G64 G90'}
    ; The safety block cancels cutter compensation on the control: keep the post's state in step.
    iDiametercomp = 40
    change(iDiametercomp) = false
    iCompActive = 40
endp

@usr_ct_toolchange
    ; Handle G/M code output to make tool change
    {nb, 'T',tool_number,cTCcodes}
    {nb, cTCcodep}
    {nb, 'D1 '}

    if bToolPreselect
        if !last_tool
            {nb, 'T'next_tool_number' '}
        endif
    endif
    {nb, cOMb,job_name,cOMe}
endp

@usr_ct_after
    ; After the T / M6 / D1 blocks: the operation message, then the spindle start, the coolant and
    ; the first positioning rapid (usr_rapid_tc_block) in the order bCoolspinaftertc selects.
    call @usr_ct_msg_lines
    if bCoolspinaftertc
        ; Spindle and coolant first, each in its own block, then the positioning rapid.
        skipline = true
        call @start_tool
        if bCoolExist
            skipline = true
            call @usr_coolant
        endif
        call @usr_ct_target
        call @usr_rapid
    else
        ; The positioning rapid first; the coolant and the spindle start join its line.
        call @usr_ct_target
        skipline = true
        call @usr_rapid
        if bCoolExist
            skipline = false
            call @usr_coolant
        endif
        skipline = false
        call @start_tool
    endif
endp

@usr_ct_msg_lines
    ; The operation message (msg) as comment lines, one per line of the message. The lines end with
    ; CR LF: a line is the text before the CR (iLf - 2). Needs '\n' to be one LF character
    ; (unverified in SolidCAM). At most 49 lines (i = 51 ends the loop after the last one).
    local integer i iLf iRestLen iStart
    local string sLine sRest
    if msg ne ''
        i = 1
        while i < 50
            i = i + 1
            iLf=instr(msg,'\n')
            if iLf eq 0
                iLf=strlen(msg)
                sLine=msg
            else
                iLf = iLf-2
                sLine=left(msg,iLf)
            endif
            {nb, cCb,sLine,cCe}
            iLf=instr(msg,'\n')
            if iLf eq 0
                i = 51
            else
                iRestLen=strlen(msg)-strlen(sLine)
                iStart=iLf+1
                sRest=substr(msg,iStart,iRestLen)
                msg=sRest
            endif
        endw
    endif
endp

@usr_ct_target
    ; The rapid after a tool change targets the X/Y/C that @change_tool saved, without a Z move: it
    ; programs only the work offset and A (usr_rapid_tc_block); X/Y follow on the job's first move.
    xpos = nTcXnext
    ypos = nTcYnext
    cpos = nTcCnext
    change(zpos) = false
endp

@usr_tc_init_gmstates
    ; Modal states for the new tool. Runs twice per tool change: from usr_ct (full reset) and from
    ; usr_ct_safety_block with bSafetyprep set (plane, abs/inc and compensation flags only).
    ; Known defect PP-027: the first-tool branch never clears bSafetyprep, so the usr_ct call of the
    ; second tool takes the bSafetyprep branch and skips the full reset.
    if first_tool
        iMotionmode = 9999
        iDiametercomp = 40
        change(iAbsincmode) = false
        call @machine_plane
        change(iMplane) = true
        change(iWorkoffset) = true
        change(iDiameteroffset) = false
        change(iDiametercomp) = false
        iDrillmode = 9999
    else
        if bSafetyprep
            call @machine_plane
            change(iMplane) = true
            change(iAbsincmode) = false
            change(iDiametercomp) = false
            iDrillmode = 9999
            bSafetyprep = false
        else
            iMotionmode = 9999
            if bWorkoffsettc
                change(iWorkoffset) = true
            endif
            change(iAbsincmode) = false
            iDiametercomp = 40
            change(iDiameteroffset) = false
            iDrillmode = 9999
            change(nRapidfeed) = true
            nR1pos = 9999
            apos = 0
            bpos = 0
            cpos = 0
        endif
    endif
endp

@usr_coolant
    ; Coolant M codes from the operation's coolant fields (1 = on, 0 or 2 = off; other values keep the
    ; last code). bskipline (the last field read wins; on = false) makes usr_coolant_output put the
    ; codes of this call on one line; the block after them starts a new line.
    if flood_coolant eq 1
        iCoolantM1 = iCoolantM1ON
        bskipline = false
    endif
    if flood_coolant eq 0 or flood_coolant eq 2
        iCoolantM1 = iCoolantM1OFF
        bskipline = true
    endif
    if Mist_coolant eq 1
        iCoolantM2 = iCoolantM2ON
        bskipline = false
    endif
    if Mist_coolant eq 0 or Mist_coolant eq 2
        iCoolantM2 = iCoolantM2OFF
        bskipline = true
    endif
    if HP_Flood_coolant eq 1
        iCoolantM3 = iCoolantM3ON
        bskipline = false
    endif
    if HP_Flood_coolant eq 0 or HP_Flood_coolant eq 2
        iCoolantM3 = iCoolantM3OFF
        bskipline = true
    endif
    if LP_Flood_coolant eq 1
        iCoolantM4 = iCoolantM4ON
        bskipline = false
    endif
    if LP_Flood_coolant eq 0 or LP_Flood_coolant eq 2
        iCoolantM4 = iCoolantM4OFF
        bskipline = true
    endif
    ; Through-spindle coolant: the pressure value selects the M code. A value not in the list keeps the
    ; last selected code (iCoolantM5ON is not reset). 07 is a leading-zero literal of 7.
    if through_ival_coolant eq 1
        if through_coolant_val eq 5
            iCoolantM5ON = 77
        endif
        if through_coolant_val eq 10
            iCoolantM5ON = 76
        endif
        if through_coolant_val eq 15
            iCoolantM5ON = 75
        endif
        if through_coolant_val eq 30
            iCoolantM5ON = 07
        endif
        if through_coolant_val eq 40
            iCoolantM5ON = 71
        endif
        if through_coolant_val eq 50
            iCoolantM5ON = 72
        endif
        if through_coolant_val eq 60
            iCoolantM5ON = 73
        endif
        if through_coolant_val eq 70
            iCoolantM5ON = 74
        endif
        iCoolantM5 = iCoolantM5ON
        bskipline = false
    endif
    if through_ival_coolant eq 0 or through_ival_coolant eq 2
        iCoolantM5 = iCoolantM5OFF
        bskipline = true
    endif
    if LP_Through_coolant eq 1
        iCoolantM6 = iCoolantM6ON
        bskipline = false
    endif
    if LP_Through_coolant eq 0 or LP_Through_coolant eq 2
        iCoolantM6 = iCoolantM6OFF
        bskipline = true
    endif
    if Air_Blast_coolant eq 1
        iCoolantM7 = iCoolantM7ON
        bskipline = false
    endif
    if Air_Blast_coolant eq 0 or Air_Blast_coolant eq 2
        iCoolantM7 = iCoolantM7OFF
        bskipline = true
    endif
    if air_through_coolant eq 1
        iCoolantM8 = iCoolantM8ON
        bskipline = false
    endif
    if air_through_coolant eq 0 or air_through_coolant eq 2
        iCoolantM8 = iCoolantM8OFF
        bskipline = true
    endif
    call @usr_coolant_output
endp

@usr_coolant_output
    ; Handle output of coolant variable
    if change(iCoolantM1)
        {nb,['M'iCoolantM1:mcode_f' ']}
        skipline = bskipline
    endif
    if change(iCoolantM2)
        {nb,['M'iCoolantM2:mcode_f' ']}
        skipline = bskipline
    endif
    if change(iCoolantM3)
        {nb,['M'iCoolantM3:mcode_f' ']}
        skipline = bskipline
    endif
    if change(iCoolantM4)
        {nb,['M'iCoolantM4:mcode_f' ']}
        skipline = bskipline
    endif
    if change(iCoolantM5)
        {nb,['M'iCoolantM5:mcode_f' ']}
        skipline = bskipline
    endif
    if change(iCoolantM6)
        {nb,['M'iCoolantM6:mcode_f' ']}
        skipline = bskipline
    endif
    if change(iCoolantM7)
        {nb,['M'iCoolantM7:mcode_f' ']}
        skipline = bskipline
    endif
    if change(iCoolantM8)
        {nb,['M'iCoolantM8:mcode_f' ']}
        skipline = bskipline
    endif
    ; The next block starts a new line unless the caller sets skipline = false again (usr_ct_after).
    ; (The template tested 'any coolant flag not set' here, always true: the output above cleared them.)
    skipline = TRUE
endp

@usr_coolant_prep_all_off
    ; Prepare coolant off for usr_coolant_output: every code takes its OFF value and only iCoolantM1
    ; is flagged, so one OFF code is output.
    iCoolantM1 = iCoolantM1OFF
    iCoolantM2 = iCoolantM2OFF
    iCoolantM3 = iCoolantM3OFF
    iCoolantM4 = iCoolantM4OFF
    iCoolantM5 = iCoolantM5OFF
    iCoolantM6 = iCoolantM6OFF
    iCoolantM7 = iCoolantM7OFF
    iCoolantM8 = iCoolantM8OFF
    change(iCoolantM1) = true
    change(iCoolantM2) = false
    change(iCoolantM3) = false
    change(iCoolantM4) = false
    change(iCoolantM5) = false
    change(iCoolantM6) = false
    change(iCoolantM7) = false
    change(iCoolantM8) = false
    bskipline = true
endp

@usr_HSM_mode
    ; Fanuc/Haas G187 smoothing (P level, E tolerance) from the job's iG187_P / nG187_E: not a
    ; Sinumerik code. Printed only when a value changes; a default program prints none.
    if iG187_P eq 0
        iG187_P = 2 ;Default = 2
    endif
    iG187_P_gpp = iG187_P
    nG187_E_gpp = nG187_E
    if change(iG187_P_gpp) or change (nG187_E_gpp)
        if change(nG187_E_gpp) and nG187_E_gpp eq 0
            {nb,'G187 '}
            change(nG187_E_gpp) = false
            change(iG187_P_gpp) = false
            if (iG187_P_gpp) ne 2
                change(iG187_P_gpp) = true
            endif
        endif
        if change(iG187_P_gpp) or change (nG187_E_gpp)
            {nb,'G187 '['P'iG187_P_gpp' ']['E'nG187_E_gpp' ']}
        endif
        change(iG187_P_gpp) = false
        change(nG187_E_gpp) = false
    endif
endp

;--------------------

@start_of_job
    bIndexClearancePending = true
    bCamLinkRetract = false
    bJobPositioned = false
    ; Start of an operation: work offset and job plane, a pending index, then the tool change
    ; (usr_ct) or, for the same tool, the job comment and a work-offset change.
    call @home_number
    ; Arcs in YZ/ZX leave iMplane at 19/18; restore the job's machining plane for its first motion block.
    call @usr_job_plane
    if bTmatrixIndexPending
        change(cWo) = true
        change(iWorkoffset) = true
        call @usr_4x_index
        bTmatrixIndexPending = false
    endif
    if rot_axis_coord eq 2
        Xpos = 0
        Xnext = 0
        nTcXnext = 0
    endif
    if bTlchg
        call @usr_ct
        bTlchg = false
    else
        ; Same tool: the job comment and, when the work offset changes (not with the VMID 3-axis
        ; limit bLimit_3axis), one G0 block with the new offset and A.
        bFirstRapid = true
        {nb, cOMb,job_name,cOMe}
        if iPworkoffset ne iWorkoffset and !bLimit_3axis
            call @usr_tc_init_gmstates
            if iDiametercomp ne iCompActive
                ; Compensation left on by the last job is still active on the control: cancel it.
                change(iDiametercomp) = true
            endif
            ; bTlchg makes this rapid the positioning block (usr_rapid_tc_block, which clears it).
            bTlchg = true
            call @rapid_move
        endif
    endif
    call @usr_HSM_mode
    ; The job's Z approach is still to come: the first rapid that moves Z splits it from X/Y
    ; (usr_rapid_xy_then_z / usr_rapid_climb_then_xy) and clears bFirstMove; feed moves keep it.
    bFirstMove = true
endp

@end_of_job
    call @usr_feedmode_94
    bIndexClearancePending = true
    bCamLinkRetract = false
    bJobPositioned = false
    ; End of a job: back to G94, the M00 stop (bStopM00), the job's work offset and Z levels for the next.
    if bStopM00
        if tool_number eq next_job_tool_number
            call @usr_StopM00_sametool
        else
            call @usr_StopM00_difftool
        endif
    endif
    bStopM00difftool = false
    iPworkoffset = iWorkoffset
    nPtool_z_level = tool_z_level
    nPtool_start_plane = tool_start_plane
endp

;-------------------

@rapid_move
    ; SolidCAM event: rapid move. All rapids go through usr_rapid.
    call @usr_rapid
endp

@usr_rapid
    ; Rapid positioning: G0, or G1 F<nRapidfeed> on '3-d model' jobs when bSyncdrapid is false.
    ; Machine order: homing where needed, A in a block of its own, then X/Y/Z. The rapid after a tool
    ; change or a work-offset change at job start (bTlchg) is one positioning block instead
    ; (usr_rapid_tc_block: work offset and A, plus Y with a vertical head; no X or Z).
    ; The homings run here and not in the helpers: that keeps the procedure nesting of the original
    ; post (start_of_job -> usr_ct -> usr_ct_after -> usr_rapid -> usr_prep_home_axis -> usr_home_axis
    ; -> usr_abs_inc_output = 7 levels); the GPPL nesting limit is not known.
    call @usr_rapid_cam_link
    call @usr_rapid_motion_mode
    call @usr_r1pos_calc
    if bFirstRapid or bTlchg
        ; First rapid of a job or of a tool change: home if the head orientation changes.
        call @usr_rapid_head_check
        call @usr_prep_home_axis
        bFirstRapid = false
    endif
    ; The A output clears the change flag: remember whether this rapid turns A.
    bRapidRotaryChanged = change(nR1pos)
    if change(nR1pos) and !bCamLinkRapid
        ; Outside a CAM link CAM planned no clearance for the swing: home first.
        sHomestrrot = sHomestrroth
        sHomestr = sHomestrrot
        call @usr_prep_home_axis
    endif
    if bTlchg
        call @usr_rapid_tc_block
    else
        if change(nR1pos)
            ; A turns in its own block before X/Y/Z move, also when Z rises in the same event (known
            ; issue DESIGN-004). Known defect PP-023: as a feed-emulated rapid (G1) it has no F.
            {nb,'G'iMotionmode:mcode_f ' ',['G'iMplane' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' ']}
            call @usr_r1_output
        endif
        call @usr_rapid_xyz
    endif
    call @usr_rapid_done
endp

@usr_rapid_cam_link
    ; A rotation inside a CAM link needs no homing: a straight feed_link retract (usr_line sets
    ; bCamLinkRetract) authorizes the 4x/5x rapids of the same link that follow it. An index, a tool
    ; change, a job start or another work offset ends the link. Decided before any output.
    bCamLinkRapid = false
    if X5_job and bR1useDir5a and bJobPositioned and bCamLinkRetract
        if !bIndexClearancePending and !bTlchg and !bFirstRapid and nLastPathWorkoffset eq iWorkoffset
            if prev_command eq '@line_5x' or prev_command eq '@line_4x' or prev_command eq '@move_5x' or prev_command eq '@move_4x'
                bCamLinkRapid = true
            endif
        endif
    endif
    ; Used up here; usr_rapid_done renews it while the link goes on.
    bCamLinkRetract = false
endp

@usr_rapid_motion_mode
    ; G0, or G1 at the rapid feed (feed-emulated rapid); a G1 rapid leaves G93 first.
    ; One assignment per path: a 0-then-1 pair would flag G1 -> G1 as a change and repeat G1.
    if !bSyncdrapid and job_type eq '3-d model'
        iMotionmode = 1
        call @usr_feedmode_94
    else
        iMotionmode = 0
    endif
endp

@usr_rapid_head_check
    ; First rapid of a job or of a tool change: sets sHomestr to the head homing that usr_rapid runs
    ; next ('' = none). The head counts as vertical when the secondary rotation nR2pos is not 0
    ; (swivel-head template; on this A-axis machine only a CoordSys turned about Z or a CAM bpos gives
    ; one). Home on the first such rapid of the program and whenever the orientation changes.
    sHomestr = ''
    if abs(nR2pos) gt 0
        if !bVertical or bFirstVert
            call @usr_head_home_select
            bVertical = true
        endif
    else
        if bVertical or bFirstVert
            call @usr_head_home_select
            bVertical = false
        endif
    endif
endp

@usr_head_home_select
    ; Select the homing for a head orientation change: sHomestr = sHomestrrotv (also the rotation
    ; homing sHomestrrot from now on); the caller runs usr_prep_home_axis. Z switches to its
    ; 4-decimal format. The template's head macros ('HVV'/'HVH' blocks) and its inverted Z format
    ; '5.4(*-1)' stay off (77c03c6).
    sHomestrrot = sHomestrrotv
    sHomestr = sHomestrrot
    zpos_f = '5.4'
    bFirstVert = false
endp

@usr_rapid_tc_block
    ; The rapid of a tool change (usr_ct_after) or of a work offset change at job start (start_of_job):
    ; G0 with the work offset and the A position. The first A word of a program is DC
    ; (bR1forceOutput). X/Y stay pending for the first move of the job; Z counts as the tool start plane.
    ; Known defect PP-023: as a feed-emulated rapid (G1) this block has no F.
    zpos = tool_start_plane
    if bVertical
        {nb,'G'iMotionmode:mcode_f ' ',['G'iMplane' '],'G'iAbsincmode ' ',cWo,iWorkoffset' ','Y'ypos ' '}
    else
        {nb,'G'iMotionmode:mcode_f ' ',['G'iMplane' '],'G'iAbsincmode ' ',cWo,iWorkoffset' '}
    endif
    if change(nR1pos) or bR1forceOutput
        call @usr_r1_output
    endif
    bTlchg = false
    bClimbZValid = false
    bFeedPrevValid = false
endp

@usr_rapid_xyz
    ; The X/Y/Z part of a rapid (not the tool-change block), with a pending cutter compensation
    ; change: one block, or a split into Z then X/Y (climb) or X/Y then Z.
    local logical bClimbFirst
    if bPostHomed
        ; The post homed the axes after the last positioning move, so the CAM change flags no longer
        ; describe the machine position: program X, Y and Z explicitly. bPostHomed stays set until the
        ; end of this procedure: the climb test and the XY/Z split below read it.
        change(xpos) = true
        change(ypos) = true
        change(zpos) = true
    endif
    if change(iDiametercomp)
        call @usr_rapid_trc_axes
    endif
    if !change(nR1pos) and !change(xpos) and !change(ypos) and !change(zpos)
        ; No axis moves: open no NC line for this rapid (its modal words, if any, join the current line).
        skipline = false
    endif
    ; Climb first, then traverse X/Y, when the rapid rises from a Z the post knows (same work offset,
    ; no homing since the last move): at the first move of a job (the job starts above the current Z),
    ; and when it deselects cutter compensation in G17 (deselecting while still low moves the tool
    ; toward the wall; climb with compensation on, then deselect at the new height).
    bClimbFirst = false
    if change(zpos) and bClimbZValid and !bPostHomed and nLastPathWorkoffset eq iWorkoffset and zpos gt nLastPathZ
        if bFirstMove
            bClimbFirst = true
        endif
        if change(iDiametercomp) and iDiametercomp eq 40 and iMplane eq 17
            bClimbFirst = true
        endif
    endif
    if bClimbFirst
        call @usr_rapid_climb_then_xy
    else
        call @usr_rapid_xy_then_z
    endif
    ; Feed-emulated rapids: F is modal and printed once after a feed move. A split rapid printed it on
    ; its first block; otherwise it goes on the last block here.
    call @usr_emulated_rapid_feed
    ; The homed return is done.
    if bPostHomed
        bPostHomed = false
    endif
    bClimbZValid = true
    call @usr_feed_start_here
endp

@usr_rapid_trc_axes
    ; Sinumerik switches cutter compensation only in a G0/G1 block that programs an axis of the
    ; working plane: give the TRC block one at the current position when CAM sent none. In G18/G19 the
    ; Z word is one, unless it goes to its own block (first move of a job).
    if iDiametercomp ne 40
        ; TRC works in the job plane: a YZ/ZX arc earlier in the job must not leave another one.
        call @usr_job_plane
    endif
    if iMplane eq 17 and !change(xpos) and !change(ypos)
        change(xpos) = true
        change(ypos) = true
    endif
    if iMplane eq 18 and !change(xpos) and (!change(zpos) or bFirstMove)
        change(xpos) = true
    endif
    if iMplane eq 19 and !change(ypos) and (!change(zpos) or bFirstMove)
        change(ypos) = true
    endif
    iCompActive = iDiametercomp
endp

@usr_rapid_climb_then_xy
    ; Z in its own block first, then X/Y with the compensation change at the new height.
    {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],['G'iAbsincmode ' '],[cWo,iWorkoffset' '],'Z'zpos ' '}
    call @usr_emulated_rapid_feed
    if change(xpos) or change(ypos)
        skipline = true
        {nb,['G'iDiametercomp' '],['X'xpos ' '],['Y'ypos ' ']}
    endif
    bFirstMove = false
    skipline = true
endp

@usr_rapid_xy_then_z
    ; X/Y with the compensation change; Z joins the block, except at the first move of a job and on
    ; the return from a post homing: there Z goes in its own block after the XY traverse (DESIGN-002).
    {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],['G'iDiametercomp' '],['G'iAbsincmode ' '],[cWo,iWorkoffset' '],['X'xpos ' '],['Y'ypos ' ']}
    if change(zpos)
        if bFirstMove or bPostHomed
            if !bFirstMove
                ; The XY block of the homed return carries the rapid feed. Known defect PP-023: the
                ; XY block of a job's first move gets none.
                call @usr_emulated_rapid_feed
            endif
            skipline = true
            {nb,'Z'zpos ' ' }
            skipline = true
        else
            {'Z'zpos ' ' }
        endif
        bFirstMove = false
    endif
endp

@usr_rapid_done
    ; State for the next event.
    if !bSyncdrapid
        ; The next feed move reprograms F.
        bFeedoutput = true
    endif
    ; After an index boundary the first A turn goes without a CAM link; later turns may ride one.
    if bRapidRotaryChanged
        bIndexClearancePending = false
    endif
    ; CAM may split one link into several XYZ and rotary rapid blocks.
    ; Keep its confirmation until a feed move or an indexing boundary resets it.
    if bCamLinkRapid
        bCamLinkRetract = true
    endif
    bJobPositioned = true
    nLastPathZ = zpos
    nLastPathWorkoffset = iWorkoffset
    ; The work offset is programmed (or unchanged): no repeat on the next block.
    change(cWo) = false
    change(iWorkoffset) = false
endp

@usr_emulated_rapid_feed
    ; F<nRapidfeed> for feed-emulated rapids (G1 on '3-d model' jobs when bSyncdrapid is false). F is
    ; optional: printed once after a feed move set change(nRapidfeed). A rapid that the post splits
    ; calls this after its first block, so the other block does not run at cutting feed.
    if !bSyncdrapid
        if job_type eq '3-d model'
            {['F'nRapidfeed' ']}
        endif
    endif
endp

@usr_feed_start_here
    ; The end point of this move is where the next G93 block starts (usr_inverse_feed).
    nFeedPrevX = xpos
    nFeedPrevY = ypos
    nFeedPrevZ = zpos
    nFeedPrevA = -nR1postemp * iR1dir
    nFeedPrevR1 = nR1pos
    bFeedPrevValid = true
endp

;-------------------

@line
    ; SolidCAM event: feed move. All feed moves go through usr_line.
    call @usr_line
endp

@usr_line
    ; Feed move (G1). A block that turns A is posted in G93 (inverse time, usr_inverse_feed).
    local logical bInverseBlock
    local numeric dummy_var
    ; Evaluate CAM input changes before output consumes their change flags.
    call @usr_line_cam_link
    nLastPathZ = zpos
    nLastPathWorkoffset = iWorkoffset
    bClimbZValid = true
    call @usr_r1pos_calc
    if !bLimit_3axis and feed_type ne 'feed_link' and abs(nR1posstep) >= 359.9995
        ; The CAM A axis is unlimited; on the modulo axis ACP/ACN turn less than one revolution per block,
        ; so a cutting block that turns A by 360 degrees or more would lose whole turns.
        ; 359.9995 is 360 at the A output resolution (nR1pos_f '7.3').
        dummy_var = 0
        input '"POST ERROR: One cutting block turns A by 360 degrees or more. Split the move in CAM."'dummy_var
        {nb,"POST ERROR: One cutting block turns A by 360 degrees or more. Split the move in CAM."}
        abort
    endif
    ; Do not pre-apply upcoming compensation here (next_command): CAM emits @compensation before the
    ; move where it must become active; a look-ahead corrupts lead-out/zigzag side changes (2aa6df0).
    iMotionmode = 1
    ; A rotating G1 block is posted in G93 (inverse time): under G94 the control applies F to the
    ; linear axes only (deg/min for A alone), so the feed along the part would be wrong.
    bInverseBlock = false
    if i4xFeedMode eq 1 and change(nR1pos) and bFeedPrevValid
        call @usr_inverse_feed
        bInverseBlock = true
        iFeedMode = 93
    else
        if iFeedMode eq 93
            iFeedMode = 94
            change(feed) = true
        endif
    endif
    if bFeedoutput
        change(feed) = true
        bFeedoutput  = false
    endif
    if change(iDiametercomp)
        if iDiametercomp ne 40
            ; TRC works in the job plane: a YZ/ZX arc earlier in the job must not leave another one.
            call @usr_job_plane
        endif
        iCompActive = iDiametercomp
    endif
    if bPostHomed
        call @usr_line_homed_return
    endif
    {nb,['G'iMotionmode:mcode_f ' '],['G'iFeedMode' '],['G'iMplane' '],['G'iDiametercomp' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' ']}
    {['X'xpos ' '],['Y'ypos ' '],['Z'zpos ' ']}
    if change(nR1pos)
        call @usr_r1_output
    endif
    if bInverseBlock
        {'F'nInvFeed:nInvFeed_f ' '}
    else
        {['F'feed ' ']}
    endif
    change(nRapidfeed) = true
    call @usr_feed_start_here
endp

@usr_line_cam_link
    ; A straight Z retract tagged feed_link by CAM (no X/Y/A/B motion, rising, same work offset)
    ; authorizes the rapids of the same link that follow it (usr_rapid_cam_link: no homing for their
    ; rotation). Any other feed move ends the authorization.
    bCamLinkRetract = false
    if X5_job and bR1useDir5a and bJobPositioned and !bIndexClearancePending and nLastPathWorkoffset eq iWorkoffset
        if feed_type eq 'feed_link' and zpos gt nLastPathZ
            if !change(xpos) and !change(ypos) and !change(apos) and !change(bpos)
                bCamLinkRetract = true
            endif
        endif
    endif
endp

@usr_line_homed_return
    ; A feed move directly after a post-inserted homing: return over the target at the homed Z in
    ; rapid (carrying a TRC change, it has X and Y), then feed down in Z, instead of one diagonal
    ; feed move from the homing position.
    iMotionmode = 0
    {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],['G'iDiametercomp' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' '],'X'xpos ' ','Y'ypos ' '}
    iMotionmode = 1
    change(xpos) = false
    change(ypos) = false
    change(zpos) = true
    bPostHomed = false
endp

@usr_inverse_feed
    ; G93 feed for a G1 block that rotates A: nInvFeed = feed / path length on the part (1/min).
    ; The A axis lies along X with its centre at Y0 Z0. Machine points are rotated back by the CAM
    ; rotary angle into the part frame (part = Rx(-A) * machine: in this frame a recorded SolidCAM
    ; rotary link is a straight line), and the block is split into steps of at most 1 degree so the
    ; arc travelled by the cutting point is followed.
    local numeric stepno steps a0 da dm u xa ya za aa yp zp xq yq zq length nSegmentLengthSquared
    a0 = nFeedPrevA
    ; The rotation is the travel of the modulo axis as the control moves it (ACP positive, ACN negative,
    ; DC shortest), in the CAM angle sense. The CAM angle difference can be off by turns of 360 degrees.
    dm = nR1pos - nFeedPrevR1
    if abs(dm) < 0.0005
        ; Below the A output resolution (nR1pos_f '7.3') the control sees no rotation.
        dm = 0
    endif
    if iR1dirMode eq 2
        while dm < 0
            dm = dm + 360
        endw
        while dm >= 360
            dm = dm - 360
        endw
    endif
    if iR1dirMode eq 1
        while dm > 0
            dm = dm - 360
        endw
        while dm <= -360
            dm = dm + 360
        endw
    endif
    if iR1dirMode eq 3
        while dm > 180
            dm = dm - 360
        endw
        while dm <= -180
            dm = dm + 360
        endw
    endif
    da = -dm * iR1dir
    steps = 1
    while steps < abs(da) and steps < 360
        steps = steps + 1
    endw
    length = 0
    xq = nFeedPrevX
    yq = nFeedPrevY * cos(a0) + nFeedPrevZ * sin(a0)
    zq = -nFeedPrevY * sin(a0) + nFeedPrevZ * cos(a0)
    stepno = 1
    while stepno <= steps
        u = stepno / steps
        xa = nFeedPrevX + (xpos - nFeedPrevX) * u
        ya = nFeedPrevY + (ypos - nFeedPrevY) * u
        za = nFeedPrevZ + (zpos - nFeedPrevZ) * u
        aa = a0 + da * u
        yp = ya * cos(aa) + za * sin(aa)
        zp = -ya * sin(aa) + za * cos(aa)
        nSegmentLengthSquared = (xa - xq) * (xa - xq) + (yp - yq) * (yp - yq) + (zp - zq) * (zp - zq)
        call @usr_sqrt(nSegmentLengthSquared)
        length = length + nSqrt
        xq = xa
        yq = yp
        zq = zp
        stepno = stepno + 1
    endw
    if length * nMaxInverseFeed > feed
        nInvFeed = feed / length
    else
        nInvFeed = nMaxInverseFeed
    endif
endp

@usr_sqrt(numeric v)
    ; Square root by Newton iteration, result in nSqrt.
    local numeric i
    if v <= 0
        nSqrt = 0
    else
        nSqrt = v
        if nSqrt < 1
            nSqrt = 1
        endif
        i = 0
        while i < 40
            nSqrt = (nSqrt + v / nSqrt) / 2
            i = i + 1
        endw
    endif
endp

@usr_feedmode_94
    ; Leave G93 before a move that is not a rotating G1 (feed-emulated rapid, arc, drill cycle) and at
    ; the end of a job, so F is read as mm/min again. Sinumerik needs F reprogrammed after G93 -> G94:
    ; without it the next move runs at the last inverse-time value read as mm/min.
    if iFeedMode eq 93
        iFeedMode = 94
        change(iFeedMode) = false
        skipline = true
        {nb,'G94 F'feed}
        change(feed) = true
        bFeedoutput = true
    endif
endp

; -----------
@arc
    ; SolidCAM event: XY arc. All arcs go through usr_arc.
    call @usr_arc
endp

@arc_yz
    ; SolidCAM event: YZ arc (usr_arc).
    call @usr_arc
endp

@arc_zx
    ; SolidCAM event: ZX arc (usr_arc).
    call @usr_arc
endp

@usr_arc_check(numeric dx, numeric dy, numeric dz)
    ; POST ERROR when the computed arc end point misses the CAM end point by more than 0.001 in an axis.
    local numeric dummy_var tolerance
    tolerance = 0.001

    if dx gt tolerance or dy gt tolerance or dz gt tolerance then
        dummy_var = 0
        input '"POST ERROR: ARC end mismatch.'dummy_var
        {"POST ERROR: ARC end mismatch. tolerance=", tolerance, " dX=", dx, " dY=", dy, " dZ=", dz}
        abort
    endif
endp


@usr_arc_math
    ; takes:
    ;   xstart / ystart / zstart
    ;   xcenter_rel / ycenter_rel / zcenter_rel
    ;   arc_size                 ; degrees
    ;   arc_direction            ; CCW / CW
    ;   arc_plane                ; XY / ZX / YZ
    ;
    ; uses (reference only):
    ;   xpos / ypos / zpos        ; CAD-provided end point (also used as orthogonal axis for 3D arcs)
    ;
    ; produces:
    ;   xpos / ypos / zpos        ; mathematically consistent end point in arc plane
    ;                             ; orthogonal axis kept "as-is" from CAD end point
    ;   iMotionmode              ; 3 = G3 (CCW), 2 = G2 (CW)
    ;   iMplane                  ; 17 / 18 / 19
    local numeric cx, cy, cz
    local numeric vx, vy, vz
    local numeric rx, ry, rz
    local numeric angle_deg
    local numeric c, s

    local numeric calculated_xpos, calculated_ypos, calculated_zpos
    local numeric dx, dy, dz
    local numeric dummy_var

    ; --- motion mode ---
    if arc_direction eq CCW then
        iMotionmode = 3
    else
        iMotionmode = 2
    endif

    ; --- plane ---
    if arc_plane eq XY
        iMplane = 17
    endif
    if arc_plane eq ZX
        iMplane = 18
    endif
    if arc_plane eq YZ
        iMplane = 19
    endif

    ; --- ZX plane: direction convention not verified ---
    ; Sinumerik G18 G3 turns Z->X (viewed from +Y), while the end-point math below turns X->Z for CCW.
    ; Depending on SolidCAM's arc_direction convention for ZX this either aborts on the end-point check
    ; or posts the complementary arc. Stop until the convention is verified (e.g. one ZX arc in Vericut).
    if iMplane eq 18 then
        dummy_var = 0
        input '"POST ERROR: ZX arc direction is unverified in this post. Check usr_arc_math."'dummy_var
        {nb,"POST ERROR: ZX arc direction is unverified in this post. Check usr_arc_math."}
        abort
    endif

    ; --- absolute center ---
    cx = xstart + xcenter_rel
    cy = ystart + ycenter_rel
    cz = zstart + zcenter_rel

    ; --- vector from center to start ---
    vx = xstart - cx
    vy = ystart - cy
    vz = zstart - cz

    ; --- signed angle (degrees) ---
    angle_deg = arc_size
    if arc_direction eq CW then
        angle_deg = -angle_deg
    endif

    c = cos(angle_deg)
    s = sin(angle_deg)


    ; --- XY plane: keep Z from CAD end ---
    if iMplane eq 17 then
        rx = vx * c - vy * s
        ry = vx * s + vy * c

        calculated_xpos = cx + rx
        calculated_ypos = cy + ry
        calculated_zpos = zpos
    endif

    ; --- ZX plane: keep Y from CAD end ---
    if iMplane eq 18 then
        rx = vx * c - vz * s
        rz = vx * s + vz * c

        calculated_xpos = cx + rx
        calculated_ypos = ypos
        calculated_zpos = cz + rz
    endif

    ; --- YZ plane: keep X from CAD end ---
    if iMplane eq 19 then
        ry = vy * c - vz * s
        rz = vy * s + vz * c

        calculated_xpos = xpos
        calculated_ypos = cy + ry
        calculated_zpos = cz + rz
    endif
    dx = abs(calculated_xpos - xpos)
    dy = abs(calculated_ypos - ypos)
    dz = abs(calculated_zpos - zpos)
    call @usr_arc_check(dx, dy, dz)
    ; --- commit end point ---
    xpos = calculated_xpos
    ypos = calculated_ypos
    zpos = calculated_zpos

endp



@usr_arc
    ; Handle output for arc movement (G02/G03)
    local numeric dummy_var
    if change(iDiametercomp)
        if iDiametercomp eq iCompActive
            ; Switched back before any move: the control state does not change.
            change(iDiametercomp) = false
        else
            ; Sinumerik selects/deselects cutter compensation only in G0/G1 blocks; G41/G42/G40 on G2/G3 alarms.
            dummy_var = 0
            input '"POST ERROR: Cutter compensation change on an arc. Use a linear lead-in/lead-out."'dummy_var
            {nb,"POST ERROR: Cutter compensation change on an arc. Use a linear lead-in/lead-out."}
            abort
        endif
    endif
    call @usr_feedmode_94
    call @usr_arc_math
    ; A completed arc starts a new link context at its actual endpoint.
    bCamLinkRetract = false
    nLastPathZ = zpos
    nLastPathWorkoffset = iWorkoffset
    bClimbZValid = true
    if bFeedoutput
        change(feed) = true
        bFeedoutput  = false
    endif
    {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],['G'iDiametercomp' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' ']}
    {['X'xpos ' '],['Y'ypos ' '],['Z'zpos ' ']}
    ; Centre words of the arc plane: absolute (iArcmode 1, and 3 for a full circle) or incremental
    ; (iArcmode 2, and 4 for a full circle).
    if arc_plane eq XY then
        if iArcmode eq 1 or (arc_size eq 360 and iArcmode eq 3)
            {'I'xcenter ' ', 'J'ycenter ' '}
        endif
        if iArcmode eq 2 or (arc_size eq 360 and iArcmode eq 4)
            {'I'xcenter_rel ' ', 'J'ycenter_rel ' '}
        endif
    endif
    if arc_plane eq ZX then
        if iArcmode eq 1 or (arc_size eq 360 and iArcmode eq 3)
            {'I'xcenter ' ', 'K'zcenter ' '}
        endif
        if iArcmode eq 2 or (arc_size eq 360 and iArcmode eq 4)
            {'I'xcenter_rel ' ', 'K'(zcenter_rel) ' '}
        endif
    endif
    if arc_plane eq YZ then
        if iArcmode eq 1 or (arc_size eq 360 and iArcmode eq 3)
            {'J'ycenter ' ', 'K'zcenter ' '}
        endif
        if iArcmode eq 2 or (arc_size eq 360 and iArcmode eq 4)
            {'J'ycenter_rel ' ', 'K'zcenter_rel ' '}
        endif
    endif
    ; iArcmode 3/4, not a full circle: the radius word, negative from 180 degrees. Known defect PP-022:
    ; R is the Fanuc word (Sinumerik: CR=), and plain I/J/K above is not an absolute centre (I=AC()).
    if arc_plane eq XY or arc_plane eq ZX or arc_plane eq YZ
        if (iArcmode eq 3 or iArcmode eq 4) and arc_size ne 360
            if arc_size >= 180 then
                radius = -radius
            endif
            {'R'radius' '}
        endif
    endif
    {['F'feed ' ']}
    change(nRapidfeed) = true
    nFeedPrevX = xpos
    nFeedPrevY = ypos
    nFeedPrevZ = zpos
endp

;-------------------

@compensation
    ; SolidCAM event: cutter compensation side (iDiametercomp); the next G0/G1 block prints G40/G41/G42.
    if side eq COMP_LEFT then
        iDiametercomp = 41
        change(iDiameteroffset) = true
    endif
    if side eq COMP_RIGHT then
        iDiametercomp = 42
        change(iDiameteroffset) = true
    endif
    if side eq COMP_OFF then
        iDiametercomp = 40
        change(iDiameteroffset) = false
    endif
endp

;-------------------

@usr_optionalstop
    ; Handle line for Optional Stop G/M code
    iStopmode = 1
    {nb, 'M'iStopmode:mcode_f' '}
endp

@usr_forcedstop
    ; Handle line for forced Stop gmcode
    iStopmode = 0
    {nb, 'M'iStopmode:mcode_f' '}
endp

@usr_StopM00_sametool
    ; Handle output for forced stopM00 between operations using the same tool
    local logical bHomedBeforeReturn
    local numeric nZBeforeReturn
    if bCoolExist
        call @usr_coolant_prep_all_off
        call @usr_coolant_output
    endif
    call @usr_spindle_stop
    sHomestr = sHomestrstpsame
    call @usr_prep_home_axis
    call @usr_forcedstop
    sUsrmsg = sStopMessage
    call @usr_message
    {nb}
    call @usr_abs_inc_output
    call @m_feed_spin
    call @usr_spindle_mcode_output
    change(xpos) = true
    change(ypos) = true
    change(zpos) = false
    ; This return is XY only, at the homed Z: a pending post homing stays pending, so the next move
    ; still programs Z.
    bHomedBeforeReturn = bPostHomed
    nZBeforeReturn = nLastPathZ
    bPostHomed = false
    call @rapid_move
    bPostHomed = bHomedBeforeReturn
    ; The return programs no Z: the tool stays at its Z (RTP after a drill cycle, or the homed top).
    nLastPathZ = nZBeforeReturn
    nFeedPrevZ = nZBeforeReturn
    if bPostHomed
        bClimbZValid = false
        bFeedPrevValid = false
    endif
endp

@usr_StopM00_difftool
    ; Handle output for forced stopM00 between operations using different tools
    if bCoolExist
        call @usr_coolant_prep_all_off
        call @usr_coolant_output
    endif
    call @usr_spindle_stop
    sHomestr = sHomestrstpdiff
    call @usr_prep_home_axis
    call @usr_forcedstop
    sUsrmsg = sStopMessage
    call @usr_message
    bStopM00difftool = true
endp

;-------------------

@change_ref_point
    ; SolidCAM reference point change (the template wrote a Fanuc G10 L2 offset): not supported.
    call @usr_unsupported_event
endp

;-------------------

@rotate
    ; @rotate Not Supported in this template
endp

;-------------------

@mirror
    ; @mirror Not Supported in this template
endp

;-------------------

@fourth_axis
    bIndexClearancePending = true
    bCamLinkRetract = false
    ; SolidCAM 4x index (angle; it reaches A through nR1postransform, so apos = 0). position counts
    ; the index steps (index mode 1 steps the work offset by position-1).
    if angle eq 0
        position = 1
    else
        position = position + 1
    endif
    gcode = 0
    apos = 0
    call @usr_4x_index
endp
;-------------------

@message
    ; We don't use messages directly from SolidCAM
endp

@usr_message
    ; Handle output for messages
    ; We don't use messages directly from SolidCAM
    if sUsrmsg ne ''
        {nb, cCb,sUsrmsg,cCe}
    endif
endp

;-------------------

@drill
    ; Sinumerik drilling cycle MCALL CYCLE8x(RTP, RFP, SDIS, DP, DPR, ...), modal on the following
    ; drill_point blocks until @end_drill. RTP = clearance Z, DP = hole bottom. Hole top above Z0:
    ; RFP = top - safety and SDIS = safety; otherwise RFP = top, SDIS empty and DPR 0.
    local numeric rtp rfp sdis dp
    rtp = drill_clearance_z
    rfp = (drill_upper_z - safety)
    sdis = safety
    dp = drill_lower_z

    call @rapid_move
    if drill_type eq G81 then
        gcode = 81
    endif
    if drill_type eq G82 then
        gcode = 82
    endif
    if drill_type eq G83 then
        gcode = 83
    endif
    if drill_type eq G84 then
        gcode = 84
    endif
    if drill_type eq G86 then
        gcode = 86
    endif
    call @usr_feedmode_94
    {nb,' F'feed }
    {nb,'MCALL CYCLE',gcode}

    if drill_type eq G81 or drill_type eq G82 then
        ; CYCLE81(RTP,RFP,SDIS,DP,DPR) and CYCLE82(RTP,RFP,SDIS,DP,DPR,DTB): DTB = dwell at the bottom.
        if drill_upper_z > 0
            {' (',rtp,','rfp,','sdis,',',dp,','}
        else
            {' (',rtp,','drill_upper_z,',,',dp,',','0.'}
        endif
        if drill_type eq G81 then
            {')'}
        endif
        if drill_type eq G82 then
            {','delay,')'}
        endif
    endif

    if drill_type eq G83 then
        ; CYCLE83(RTP,RFP,SDIS,DP,DPR,FDEP,FDPR,DAM,DTB,DTS,FRF,VARI)
        ; DTB = dwell at final drilling depth, DTS = dwell at start point during swarf removal.
        ; Current G83 output uses DTB empty/0, DTS 0.5 sec, FRF 1, VARI 1 (swarf removal).
        if drill_upper_z > 0
            {' (',rtp,','rfp,','sdis,',',dp,','}
            {',,',down_step,','down_step,',,0.5,1,1)'}
        else
            {' (',rtp,',',drill_upper_z',,',dp}
            {',0.,,',down_step,','down_step,',,0.5,1,1)'}
        endif
    endif

    if drill_type eq G84 then
        ; CYCLE84(RTP,RFP,SDIS,DP,DPR,DTB,SDAC,MPIT,PIT,POSS,SST,SST1,...)
        ; The sign of PIT selects the thread hand: positive = right-hand (M3), negative = left-hand (M4).
        ; SDAC = spindle direction after the cycle: 3 for a CW (right-hand) tap, 4 for a CCW (left-hand) tap.
        if tool_direction eq CW then
            if drill_upper_z > 0
                {' (',rtp,','rfp,','sdis,',',dp,',,0.,3,,',''(FEED/SPIN),',0,''',SPIN:INTEGER_DEF_F,','(SPIN*2):INTEGER_DEF_F}
            else
                {' (',rtp,','drill_upper_z,',,',dp,',','0.'}
                {',0.,3,,',''(FEED/SPIN),',0,''',SPIN:INTEGER_DEF_F,','(SPIN*2):INTEGER_DEF_F}
            endif
        else
            if drill_upper_z > 0
                {' (',rtp,','rfp,','sdis,',',dp,',,0.,4,,',''((0-FEED)/SPIN),',0,''',SPIN:INTEGER_DEF_F,','(SPIN*2):INTEGER_DEF_F}
            else
                {' (',rtp,','drill_upper_z,',,',dp,',','0.'}
                {',0.,4,,',''((0-FEED)/SPIN),',0,''',SPIN:INTEGER_DEF_F,','(SPIN*2):INTEGER_DEF_F}
            endif
        endif
        ; AXN and PTAB empty, TECHNO = 1221; with Step_Down: VARI = 1 (chip breaking), DAM, VRT.
        {',,,1221'}
        if Step_Down ne 0
            if VarRetract ne 0
                {',1,'Step_Down:feed_f ',' VarRetract:feed_f}
            else
                {',1,'Step_Down:feed_f ',' Step_Down:feed_f}
            endif
        endif

        {')'}
    endif

    if drill_type eq G86 then
        if drill_upper_z > 0
            {' (',rtp,','rfp,','sdis,',',dp,',,,3'}
        else
            {' (',rtp,','drill_upper_z,',,',dp,',','0.,,3'}
        endif
        {')'}
    endif
    ; The cycle retracts to RTP after every hole: that is the Z the next move starts from.
    nLastPathZ = rtp

endp

;-------------------

@drill_point
    ; Handle output for drill positions
    {nb,['X'xpos ' '], ['Y'ypos ' '], ['Z'zpos ' ']}
endp

;-------------------

@end_drill
    ; Handle output to cancel drill cycles
    iDrillmode = 80
    if change(iDrillmode)
        {nb, 'MCALL '}
        iDrillmode = 9999
    endif
    if drill_type eq G84
        {nb, 'G94'}
    endif
endp

;-------------------

@m_feed_spin
    ; Handle output for spindle change
    if tool_direction eq CW then
        iSpindleDir = 3
    else
        iSpindleDir = 4
    endif
    if change(spin)
        call @usr_spindle_output
    endif
endp

@start_tool
    ; Spindle start (M3/M4 and S). Tapping prints only an empty block: CYCLE84 runs the spindle (SST).
    if tool_direction eq CW then
        iSpindleDir = 3
    else
        iSpindleDir = 4
    endif
    if d_drill_type ne D_Tapping
        call @usr_spindle_mcode_output
        call @usr_spindle_output
    else
        {nb ' '}
    endif
endp

@usr_spindle_output
    ; S word, then a G04 dwell while the spindle reaches the new speed when the speed changes by more
    ; than spindle_accel (rpm/s): 0.3 s plus 1 s per 500 rpm of change.
    {nb,'S'spin:integer_def_f ' '}
    ; Keep the integer sdiff and the literal 500: spindle_accel or a numeric would change the dwell if
    ; GPPL divides integers as integers (unverified).
    local integer sdiff
    sdiff = abs(last_spin-spin)
    if sdiff > spindle_accel
        {nb, 'G04 F', (0.3+(sdiff/500))}
        {nb}
    endif
    last_spin = spin
endp

@usr_spindle_stop
    ; M5 in its own block.
    iSpindleDir = 5
    {nb}
    call @usr_spindle_mcode_output
endp

@usr_spindle_mcode_output
    ; M3/M4/M5. After a stop the next S counts as a start from 0 rpm (dwell in usr_spindle_output).
    if iSpindleDir ne 3 and iSpindleDir ne 4
        last_spin = 0
    endif
    {'M'iSpindleDir:mcode_f ' '}
endp

;-------------------

@offset_change
    ; Handle setting of Diameter offset
    iDiameteroffset = tool_number
endp

;-------------------

@job_plane
    ; @job_plane Not Supported in this template
endp

;-------------------

@call_proc
    ; SolidCAM subprogram call (VMID GenProc=0): not supported.
    call @usr_unsupported_event
endp

;-------------------

@proc
    ; Start of a SolidCAM subprogram: not supported (see @call_proc).
    call @usr_unsupported_event
endp

;-------------------

@end_proc
    ; End of a SolidCAM subprogram: not supported (see @call_proc).
    call @usr_unsupported_event
endp

;----------------

@loop_matrix_info
endp

@loop
    ; SolidCAM loop (VMID LoopExist=0; the template wrote a Fanuc WHILE macro): not supported.
    call @usr_unsupported_event
endp

@end_loop
    ; End of a SolidCAM loop: not supported (see @loop).
    call @usr_unsupported_event
endp

;-------------------

@usr_prep_home_axis
    ; Home with the homing string sHomestr ('' = no homing). Format (usr_ip_useroptions):
    ;   mode:prep:line[;mode:prep:line...]   e.g. '8::G75 Z1=0. ;8::G75 Y1=0 X1=0' (prep empty)
    ; Each line goes to usr_home_axis as iHomingmode / cHomep / sHomeline, in string order.
    ; At most 49 lines (i = 50 ends the loop after the last one).
    local integer i l mode p1
    local string s s1 l1 pstr
    if sHomestr ne ''
        s = sHomestr
        s1 = s
        l = strlen(s1)
        i = 1
        while i < 50
            i = i + 1
            ; s1 = 'mode:prep:line;...': cut off the mode, then the prep string.
            p1 = instr(s1,':')
            l1 = left(s1,p1-1)
            mode = tonum(l1)
            s1 = substr(s1,p1+1,l)
            l = strlen(s1)
            p1 = instr(s1,':')
            if p1 ne 0
                pstr = left(s1,p1-1)
                s1 = substr(s1,p1+1,l)
                l = strlen(s1)
            endif
            ; The homing line runs to the next ';', or to the end for the last line.
            p1 = instr(s1,';')
            if p1 ne 0
                l1 = left(s1,p1-1)
                iHomingmode = mode
                cHomep = pstr
                sHomeline = l1
                call @usr_home_axis
            else
                iHomingmode = mode
                cHomep = pstr
                sHomeline = s1
                call @usr_home_axis
                i = 50
            endif
            if i ne 50
                ; Drop the line just output; s1 starts with the next line's mode.
                s1 = substr(s1,p1+1,l)
                l = strlen(s1)
            endif
        endw
    endif
endp

@usr_home_axis
    ; Output one homing line (sHomeline with prefix cHomep) in mode iHomingmode: 1/2 = Fanuc G28
    ; (2 incremental), 3/4 = G53 (WorkOffsetmode 2: offset 0), 5/6 = G30, 7 = G90 G54, 8 = the line as
    ; given (Sinumerik G75). Then mark the axes as homed (bPostHomed).
    local integer sav_iWorkOffset
    sav_iWorkOffset = iWorkOffset
    if iHomingmode eq 1
        {nb,cHomep'G28 'sHomeline}
    endif
    if iHomingmode eq 2
        {nb,cHomep'G28 '}
        iAbsincmode = 91
        change(iAbsincmode) = true
        call @usr_abs_inc_output
        { sHomeline}
        iAbsincmode = 90
        change(iAbsincmode) = true
    endif
    if iHomingmode eq 3 or iHomingmode eq 4
        if iWorkOffsetmode eq 1 or iWorkOffsetmode eq 3
            iWorkOffset = 53
            {nb,cHomep,['G'iWorkoffset' ']}
        endif
        if iWorkOffsetmode eq 2
            iWorkOffset = 0
            {nb,cHomep,[cWo,iWorkoffset' ']}
        endif
        call @usr_abs_inc_output
        { sHomeline}
        iWorkOffset = sav_iWorkOffset
        if iHomingmode eq 3
            change(iWorkOffset) = false
        endif
    endif
    if iHomingmode eq 5
        {nb,cHomep'G30 'sHomeline}
    endif
    if iHomingmode eq 6
        {nb,cHomep'G30 '}
        iAbsincmode = 91
        change(iAbsincmode) = true
        call @usr_abs_inc_output
        { sHomeline}
        iAbsincmode = 90
        change(iAbsincmode) = true
    endif
    if iHomingmode eq 7
        {nb,cHomep'G90 G54 'sHomeline}
    endif
    if iHomingmode eq 8
        {nb,cHomep,sHomeline}
    endif
    ; The axes now stand at the homing position: the next positioning move must reprogram X, Y and Z
    ; even when the CAM values did not change.
    bPostHomed = true
    bClimbZValid = false
    bFeedPrevValid = false
endp

;-------------------

@usr_r1pos_calc
    ; A position (nR1pos) of the current CAM state: the CAM angle nR1postemp (tmatrix + 4x transform +
    ; C-axis cutting + 4/5x apos, in the machine direction iR1dir) wrapped into 0 <= A < 360. Also sets
    ; change(nR1pos) (A moves), iR1dirMode (the A word's ACN/ACP/DC) and the CAM step nR1posstep.
    call @usr_r1_cam_angle
    call @usr_r1_range
    iR1dirMode = 0
    ; Second rotary axis of the swivel-head template; this machine has none, only a CoordSys turned
    ; about Z or a CAM bpos makes nR2pos non-zero (usr_rapid_head_check).
    nR2postmatrix = (-x_angle_const_z) * iR2dir                        ;Rotary from CoordSys (tmatrix)
    nR2pos5x = (-bpos) * iR2dir                                       ;Rotary from 4/5x Simulatenous
    nR2pos = nR2postmatrix + nR2pos5x
    ; A moves when its position changes; a 3-axis job (bLimit_3axis) never turns A.
    if nPR1pos ne nR1pos
        change(nR1pos) = TRUE
    else
        change(nR1pos) = false
    endif
    if nPR2pos ne nR2pos
        change(nR2pos) = TRUE
    else
        change(nR2pos) = false
    endif
    if bLimit_3axis
        change(nR1pos) = false
        change(nR2pos) = false
    endif
    ; Direction word: DC for a forced A word (program start: the A position is unknown), else the
    ; CAM direction.
    if bR1forceOutput
        iR1dirMode = 3
    else
        if change(nR1pos)
            call @usr_r1_select_dir
        endif
    endif
    ; The CAM step of this move (usr_line full-turn check), then the references for the next one.
    nR1posstep = nR1postemp - nPR1postemp
    nPR1postemp = nR1postemp
    nPR1pos = nR1pos
    nPR2pos = nR2pos
endp

@usr_r1_cam_angle
    ; The unwrapped CAM angle of A in the machine direction (nR1postemp). The difference of two
    ; successive values is the CAM step of a move (nR1posstep in usr_r1pos_calc).
    nR1postmatrix = (-angle_4x_around_x) * iR1dir                       ;Rotary from CoordSys (tmatrix)
    nR1postransform = (-angle) * iR1dir                                 ;Rotary from 4x-Transform
    nR1poscpos = (-cpos) * iR1dir                                       ;Rotary from C-axis cutting
    nR1pos5x = (-apos) * iR1dir                                         ;Rotary from 4/5x Simulatenous
    nR1postemp = nR1postmatrix + nR1postransform + nR1poscpos + nR1pos5x
endp

@usr_r1_range
    ; nR1pos: the CAM angle nR1postemp in the position range 0 <= A < 360 of the modulo A axis
    ; (whole turns added or removed).
    local numeric nShift
    nShift = 0
    nR1pos = nR1postemp
    while nR1pos < 0
        nShift = nShift + 360
        nR1pos = nR1postemp + nShift
    endw
    while nR1pos >= 360
        nShift = nShift - 360
        nR1pos = nR1postemp + nShift
    endw
    ; 360.000 and -0.000 with nR1pos_f '7.3' (sums of angles carry float noise) are the position 0.
    if nR1pos >= 359.9995 or nR1pos < 0.0005
        nR1pos = 0
    endif
endp

@usr_r1_select_dir
    ; ACN (1) or ACP (2) from the CAM rotation direction: dir5a for 4x/5x moves (bR1useDir5a), else the
    ; 4x transform direction. Any other value leaves iR1dirMode as it is.
    if bR1useDir5a
        if dir5a eq cw
            iR1dirMode = 1
        else
            if dir5a eq ccw
                iR1dirMode = 2
            endif
        endif
    else
        if angle_4x_around_x_dir eq cw
            iR1dirMode = 1
        else
            if angle_4x_around_x_dir eq ccw
                iR1dirMode = 2
            endif
        endif
    endif
endp

@usr_r1_output
    ; The A word of a block, as usr_r1pos_calc chose it: A=ACN(..) / A=ACP(..) turn the modulo axis in a
    ; given direction (iR1dirMode 1 / 2), A=DC(..) the shortest way (3). The only place an A word is
    ; printed. Callers and their condition:
    ;   usr_rapid A block: change(nR1pos); usr_rapid_tc_block: change(nR1pos) or bR1forceOutput;
    ;   usr_line: change(nR1pos); usr_4x_index_rotate: change(nR1pos) tested in usr_4x_index.
    ; No 'last printed A' is kept: usr_r1pos_calc updates nPR1pos on every call, printed or not.
    local numeric dummy_var
    if iR1dirMode ne 1 and iR1dirMode ne 2 and iR1dirMode ne 3
        dummy_var = 0
        input '"POST ERROR: A-axis output direction mode is not ACP/ACN/DC."'dummy_var
        {"POST ERROR: A-axis output direction mode is not ACP/ACN/DC. A=", nR1pos}
        abort
    endif
    ; Track only emitted A words, at their 0.001 degree output resolution.
    if abs(nR1pos) >= 0.0005
        bWorkpieceUsesA = true
    endif
    if iR1dirMode eq 1
        {cR1,'=ACN(' nR1pos ') '}
    endif
    if iR1dirMode eq 2
        {cR1,'=ACP(' nR1pos ') '}
    endif
    if iR1dirMode eq 3
        {cR1,'=DC(' nR1pos ') '}
    endif
    iR1dirMode = 0
    bR1forceOutput = false
endp

@usr_4x_index
    ; Index A between operations (tmatrix in start_of_job, fourth_axis).
    ;   i4xIndexMode: 0 = turn A in the current work offset, 1 = also step the work offset by
    ;   position-1 (G54, G55, ...).
    ;   i4xIndexClearanceMode: 0 = home first (sHomestrrot, the homing string of the last rapid or tool
    ;   change; '' before the first one), 1 = tool Z level, 2 = tool start plane. Modes 1/2: the
    ;   previous job's level before the turn, this job's after it.
    call @usr_r1pos_calc
    if change(nR1pos)
        ; Turning A does not move Z. A homing clears bClimbZValid itself; a clearance move sets nLastPathZ.
        ; The index is not a tracked feed start (A and possibly Z moved).
        bFeedPrevValid = false
        call @usr_optionalstop
        ; Another clearance mode value turns nothing.
        if i4xIndexClearanceMode eq 0 or i4xIndexClearanceMode eq 1 or i4xIndexClearanceMode eq 2
            call @usr_4x_index_rotate
        endif
    endif
endp

@usr_4x_index_rotate
    ; Index modes 0 and 1: clearance, the G0 A block (in mode 1 with the next work offset), clearance.
    iMotionmode = 0
    if i4xIndexClearanceMode eq 0
        sHomestr = sHomestrrot
        call @usr_prep_home_axis
    endif
    if i4xIndexClearanceMode eq 1
        if tool_z_level < tool_start_plane
            Print 'WARNING!! Tool Z Level is below Tool Start Plane in CoordSys'
            {nl,'WARNING!! Tool Z Level is below Tool Start Plane in CoordSys'}
        endif
        {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' '],'Z'nPtool_z_level ' '}
    endif
    if i4xIndexClearanceMode eq 2
        {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' '],'Z'nPtool_start_plane ' '}
    endif
    if i4xIndexMode eq 1
        iWorkoffset = iWorkoffset + (position-1)
    endif
    {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' ']}
    call @usr_r1_output
    if i4xIndexClearanceMode eq 1
        {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' '],'Z'tool_z_level ' '}
        nLastPathZ = tool_z_level
    endif
    if i4xIndexClearanceMode eq 2
        {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' '],'Z'tool_start_plane ' '}
        nLastPathZ = tool_start_plane
    endif
    if i4xIndexMode eq 1 and i4xIndexClearanceMode ne 0
        nLastPathWorkoffset = iWorkoffset
    endif
endp

@move_4x
    ; SolidCAM event: 4x rapid (usr_rapid; the A direction comes from dir5a, bR1useDir5a).
    ; A rotates around X on this machine: X is the axial coordinate and is posted as given.
    bR1useDir5a = true
    call @usr_rapid
    bR1useDir5a = false
endp

@line_4x
    ; SolidCAM event: 4x feed move (usr_line; the A direction comes from dir5a, bR1useDir5a).
    bR1useDir5a = true
    call @usr_line
    bR1useDir5a = false
endp

@chng_tool_cnext
endp

@rotary_info
endp

@tmatrix
    ; Conservatively require clearance even when only the translation changed.
    bIndexClearancePending = true
    bCamLinkRetract = false
    bTmatrixIndexPending = true
endp

@move_5x
    ; SolidCAM event: 5x rapid (usr_rapid; the A direction comes from dir5a, bR1useDir5a).
    bR1useDir5a = true
    call @usr_rapid
    bR1useDir5a = false
endp

@line_5x
    ; SolidCAM event: 5x feed move (usr_line; the A direction comes from dir5a, bR1useDir5a).
    bR1useDir5a = true
    call @usr_line
    bR1useDir5a = false
endp

@tool_path_info
endp

@transform_info
endp

@home_data
    ; SolidCAM CoordSys data event (VMID HomeDataAtStart). The template computed CTRANS frame values
    ; here and never printed them (77c03c6). One effect is left: for position ne 1 a negative shift_y
    ; turns positive, so the Y word of the trig-macro call (G65 P777, index mode 2) is positive. Kept
    ; so the NC stays the same (known defect PP-043: it overwrites a CAM input).
    if position ne 1
        if shift_y < 0
            shift_y = -1 * shift_y
        endif
    endif
endp
