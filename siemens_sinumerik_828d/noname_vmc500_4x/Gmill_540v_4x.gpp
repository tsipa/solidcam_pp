; SolidCAM GPPL post Gmill_540v_4x: Sinumerik 828D, 4-axis vertical machining centre (machine
; vmc500_4x). The A axis turns about X and is a modulo axis (positions 0 <= A < 360, ACP/ACN/DC).
; Settings and events this post does not support stop it with a POST ERROR.
;
@init_post
    ; Globals by purpose. Keep each type: integer and numeric print and divide differently.
    ; User options (usr_ip_useroptions, usr_ip_postwriteroptions, the rotary block at its end)
    global logical bToolPreselect bSyncdrapid bUseprogname bTlist bTlseperation bTcseperation bDateTimeOutput
    global logical bToolChangeAtEnd bOptstpbegin bOptstptc bOptstpend bOptstpjob bOptstpindex bWorkoffsettc bNnumtc bCoolspinaftertc
    global logical bHomebegin bHometc bHomeend bHomerotv bHomeroth
    global logical bCoolExist bCoolofftc bSpinofftc bCooloffend bSpinoffend
    global string cTCcodep cTCcodes cWo cPb cPe cCb cCe cOMb cOMe cR1
    global string sHomestrbegin sHomestrtc sHomestrend sHomestrstpsame sHomestrstpdiff sHomestrrotv sHomestrroth
    global integer iProgendmode i4xIndexMode i4xIndexClearanceMode i4xFeedMode trace_level
    global integer iCoolantM1ON iCoolantM2ON iCoolantM3ON iCoolantM4ON iCoolantM5ON iCoolantM6ON iCoolantM7ON iCoolantM8ON
    global integer iCoolantM1OFF iCoolantM2OFF iCoolantM3OFF iCoolantM4OFF iCoolantM5OFF iCoolantM6OFF iCoolantM7OFF iCoolantM8OFF
    global numeric nRapidfeed nMaxInverseFeed iR1dir iR2dir
    global string nR1pos_f nInvFeed_f
    global logical bCycle832 bSpinWait
    global numeric nCycle832RoughAllow nCycle832TolRough nCycle832TolSemi nCycle832TolFinish
    global string nCycle832Tol_f nCamDbg_f nArcAR_f
    ; Modal state of the NC program (what the control has active). iDiametercomp is the G40/G41/G42
    ; CAM asks for, printed on the next G0/G1 block; iCompActive is what the control has active.
    global integer iMotionmode iMplane iAbsincmode iWorkoffset iPworkoffset iDiametercomp iCompActive
    global integer iFeedMode iSpindleDir
    global integer iCoolantM1 iCoolantM2 iCoolantM3 iCoolantM4 iCoolantM5 iCoolantM6 iCoolantM7 iCoolantM8
    global numeric last_spin
    ; CYCLE832 the control has selected (usr_smoothing): the machining type (0 = deselected, the
    ; reset settings of the control) and the tolerance of that call.
    global integer iCycle832Mode
    global numeric nCycle832Tol
    ; CYCLE832 the cut asks for (usr_smoothing_set), selected when cutter compensation is off
    ; (usr_smoothing_apply); the type of the job's allowance, and bCycle832Auto when the finishing
    ; passes of the job switch the type (usr_smoothing_feed).
    global integer iCycle832Want iCycle832Job
    global numeric nCycle832WantTol
    global logical bCycle832Auto
    ; Tool change and job start
    global logical bTlchg bSafetyprep bStopM00difftool bskipline bFirstMove bFirstRapid
    ; bBoundaryStop: an M0/M1 was printed since the last end_of_job (usr_optionalstop, usr_forcedstop);
    ; the M1 between two operations of the same tool (bOptstpjob) is then not repeated.
    ; bStopSinceMotion: an M0/M1 was printed and no axis has moved since; the index M1 is then not
    ; repeated (a @fourth_axis right after the job M1).
    global logical bBoundaryStop bStopSinceMotion
    global integer iTcnumber
    global numeric nTcXnext nTcYnext nTcCnext nPtool_start_plane nPtool_z_level
    global string sUS_date sUS_time
    ; Homing (usr_prep_home_axis / usr_home_axis)
    global string sHomestr sHomestrrot sHomeline cHomep
    global integer iHomingmode
    ; A axis (usr_r1pos_calc, usr_r1_output) and the template's second rotary axis
    global numeric nR1pos nR1pos5x nR1postmatrix nR1postransform nR1poscpos nPR1pos nR1postemp nPR1postemp nR1posstep
    global numeric nR1from nR1travel nR1camstep nPR1camcpos nPR1camapos
    global numeric nR2pos nR2pos5x nR2postmatrix
    global integer iR1dirMode
    ; bVertical: nR2pos was not 0 at the last head check (swivel-head template term; here only a
    ; CoordSys turned about Z or a CAM bpos). bFirstVert: no head homing yet in this program.
    global logical bR1useDir5a bR1forceOutput bVertical bFirstVert bR1wrongWay bR1turnDropped bR1StepReset
    ; Position tracking for indexing, CAM links and the first-rapid climb
    global logical bTmatrixIndexPending bIndexClearancePending bCamLinkRetract bJobPositioned bClimbZValid
    global numeric nLastPathZ nLastPathWorkoffset
    ; Feed: G93 inverse time (usr_inverse_feed) and the feed reprogramming flag
    global logical bFeedPrevValid bFeedoutput
    global numeric nInvFeed nSqrt nFeedPrevX nFeedPrevY nFeedPrevZ nFeedPrevA nFeedPrevR1
    ; Arcs above 180 deg: the point halfway (usr_arc_math), where usr_arc ends the first half
    global numeric nArcMidX nArcMidY nArcMidZ
    ; bPostHomed: the post homed the axes after the last positioning move (usr_home_axis); the next
    ; move reprograms X/Y/Z. usr_rapid_xyz keeps it set to its end as the homed-return marker.
    ; bCamLinkRapid / bRapidRotaryChanged: per-rapid decisions of usr_rapid, shared by its stages.
    ; bPostHomedZ: Z is among the axes homed since the last positioning move (with bPostHomed).
    ; bTcReprogram: M06/D1 ran, or a same-tool job changed the work offset, since the last positioning
    ; move; the next move programs X, Y and Z also when no post homing ran (bHometc, or bHomebegin and
    ; bHomerotv, switched off).
    global logical bPostHomed bPostHomedZ bCamLinkRapid bRapidRotaryChanged bTcReprogram
    ; WORKPIECE header: the program body is buffered in a file until the end of the file
    ; (usr_workpiece_begin / usr_workpiece_flush), so the blank is clamped on A only when a non-zero
    ; A word was printed (usr_r1_output sets bWorkpieceUsesA; A=DC(0) of the first tool does not).
    global logical bWorkpieceBuffered bWorkpieceUsesA
    global string sWorkpieceBodyPath sWorkpieceArgs

    ; Program state
    last_spin = 0
    bR1forceOutput = true

    ; GPPL settings and formats
    num_user_procs =    1
    remove_blanks = FALSE
    line_labels    = FALSE     ; Jump to N...
    clear_change_after_gen = 1
    numeric_def_f   = '8.5'
    integer_def_f   = '5.0(p)'
    gcode_f         = '2.0(p)'
    mcode_f         = '2.0(p)'
    xpos_f          = '8.5'
    ypos_f          = '8.5'
    ; zpos_f becomes '5.4' at the first head homing (usr_head_home_select), which runs at the first
    ; rapid, before any Z word: '8.5' is never printed (PP-006).
    zpos_f          = '8.5'
    nR1pos_f        = '7.3'
    apos_f          = '5.3'
    feed_f          = '4.4(P)'
    nInvFeed_f      = '5.3'
    nCycle832Tol_f  = '5.4'
    ; AR= of the arcs (usr_arc): degrees with the control's angle resolution (INT_INCR_PER_DEG 100000
    ; in backups/NOLOG.ard). With the end point written the angle sets only the bulge: 0.000005 deg
    ; moves the middle of an arc of up to 180 deg by at most chord * 0.000000022, 0.0000007 mm on the
    ; longest chord of the reference trace (65 mm at 3.9 deg).
    nArcAR_f        = '3.5'
    blknum_f        = '5.0(p)'
    blknum_gen      = true
    call @usr_ip_useroptions
    call @usr_ip_postwriteroptions
endp

@usr_ip_useroptions
    ; User options: machine, coolant and spindle codes, NC layout, homing strings, rotary axis.
    ;Machine and NC syntax
    bToolPreselect        = TRUE               ; True = preselect the next tool (T) after the tool change
    bSyncdrapid           = TRUE               ; True = G0 rapids; False = G1 F<nRapidfeed> on 3-d model jobs
    nRapidfeed            = 650.               ; Feed of those G1 rapids
    bUseprogname          = TRUE               ; True = ';%_N_<part>_MPF' and ';$PATH=...' header lines
    cTCcodep              = 'M06 '             ; Tool change code (the block after T)
    cTCcodes              = ''                 ; Text after T<n> in the T block
    cWo                   = 'G'                ; Work offset address (G54, G55, ...)
    iProgendmode          = 1                  ; Program end: 1 = M30, 2 = M2
    cPb                   = ';%_N_'            ; Start of the header line
    cPe                   = ''                 ; Last line of the file ('' = none)
    cCb                   = ';'                ; Comment start
    cCe                   = ''                 ; Comment end
    cOMb                  = 'MSG("'            ; Operator message start
    cOMe                  = '")'               ; Operator message end

    ;Coolant & Spindle Control
    flood_coolant         = 1
    bCoolExist            = true               ; True = coolant codes are output
    bCoolofftc            = true               ; Not read (PP-010)
    bSpinofftc            = true               ; Not read (PP-010)
    bCooloffend           = true               ; True = coolant off at each tool change and at the program end
    bSpinoffend           = true               ; True = spindle off at each tool change and at the program end
    bCoolspinaftertc      = false              ; True = spindle and coolant blocks right after the tool change
    bSpinWait             = true               ; True = WAITS after each spindle start, speed change and M5: the program
                                               ; waits until the spindle is at speed / stands still, also for G0 and the
                                               ; cycles (feed blocks wait anyway: MD35500 SPIND_ON_SPEED_AT_IPO_START 2)
    iCoolantM1ON          = 8                  ; Code: Flood Coolant ON
    iCoolantM1OFF         = 9                  ; Code: Flood Coolant OFF
    iCoolantM2ON          = 7                  ; Code: Mist Coolant ON
    iCoolantM2OFF         = 9                  ; Code: Mist Coolant OFF
    iCoolantM3ON          = 130                ; Code: HP-Flood Coolant ON
    iCoolantM3OFF         = 9                  ; Code: HP-Flood Coolant OFF
    iCoolantM4ON          = 8                  ; Code: LP-Flood Coolant ON
    iCoolantM4OFF         = 9                  ; Code: LP-Flood Coolant OFF
    iCoolantM5ON          = 77                 ; Code: High Pressure Coolant Through Tool ON
    iCoolantM5OFF         = 9                  ; Code: High Pressure Coolant Through Tool OFF
    iCoolantM6ON          = 51                 ; Code: Low Pressure Coolant Through Tool ON
    iCoolantM6OFF         = 9                  ; Code: Low Pressure Coolant Through Tool OFF
    iCoolantM7ON          = 50                 ; Code: Air Blast ON
    iCoolantM7OFF         = 9                  ; Code: Air Blast OFF
    iCoolantM8ON          = 92                 ; Code: Air Through Tool ON
    iCoolantM8OFF         = 9                  ; Code: Air Through Tool OFF

    ;NC layout
    bTlist                = true               ; True = tool list, 'Loading Zeropoints' and WORKPIECE blank in the header
    bTlseperation         = false              ; True = blank lines after the date and after the tool list
    bTcseperation         = false              ; True = blank line before each tool change after the first
    bDateTimeOutput       = true               ; True = date and time in the header
    bToolChangeAtEnd      = false              ; True = change back to the first tool at the end (writes M06 before T)
    bOptstpbegin          = false              ; True = M1 after the header (with bTlist)
    bOptstptc             = true               ; True = M1 before each tool change after the first
    bOptstpend            = false              ; True = M1 before the program end
    bOptstpjob            = true               ; True = M1 between two operations of the same tool (not after an M0 or index M1 there)
    bOptstpindex          = true               ; True = M1 before each A index turn (CoordSys change, @fourth_axis)
    bWorkoffsettc         = true               ; True = work offset repeated at each tool change
    bNnumtc               = False              ; True = N<2001, 2002, ...> on the safety block of each tool change
    blknum_exist          = False              ; True = block numbers (SolidCAM blknum settings below)
    blknum                = 200                ; First block number
    blknum_delta          = 10                 ; Block number step
    blknum_max            = 99999              ; Largest block number

    ;High Speed Settings: CYCLE832 per operation (usr_smoothing; 828D option Top Surface). The job
    ;parameter iG187_P chooses the machining type: 0 = by the wall allowance, 1 = roughing,
    ;2 = semi-finishing, 3 = finishing, -1 = no CYCLE832; nG187_E > 0 replaces the tolerance (mm).
    bCycle832             = TRUE               ; True = CYCLE832 per operation; False = none (iG187_P and nG187_E must be 0)
    nCycle832RoughAllow   = 0.1                ; Wall allowance (mm) from which iG187_P 0 is roughing (0 = finishing, between = semi)
    nCycle832TolRough     = 0.1                ; Contour tolerance (mm) of roughing
    nCycle832TolSemi      = 0.05               ; Contour tolerance (mm) of semi-finishing
    nCycle832TolFinish    = 0.01               ; Contour tolerance (mm) of finishing

    ;Homing: one NC line per '8:prefix:line' entry, entries separated by ';', output in order
    ;(usr_prep_home_axis). 8 is the only mode (the line as given); prefix is usually empty. The
    ;'8:' form is kept so existing homing strings still parse. '' = no homing at that point.
    sHomestrbegin         = '8::G75 Z1=0. ;8::G75 Y1=0 X1=0' ; Program start
    sHomestrtc            = '8::G75 Z1=0. ;8::G75 Y1=0 X1=0' ; Tool change
    sHomestrend           = '8::G75 Z1=0. ;8::G75 Y1=0 X1=0' ; Program end
    sHomestrstpsame       = ''                 ; M0 between operations of the same tool
    sHomestrstpdiff       = ''                 ; M0 before a tool change
    sHomestrrotv          = '8::G75 Z1=0. ;8::G75 Y1=0 X1=0' ; First rapid of the program, head orientation change
    sHomestrroth          = '8::G75 Z1=0. ;8::G75 Y1=0 X1=0' ; Before an A turn outside a CAM link
    ;Homing on/off per point (the strings above stay as they are). The homings are the clearance
    ;for these moves: switched off, the next move starts wherever the tool stands (CAM's last
    ;position, or where M06 left it) and the post programs only the axes CAM changes. The A index
    ;clearance is i4xIndexClearanceMode (0 = home with the last head or A-turn homing string).
    bHomebegin            = true               ; True = sHomestrbegin at the program start. False: an A
                                               ; index before the first rapid still homes (i4xIndexClearanceMode 0)
    bHometc               = true               ; True = sHomestrtc (sHomestrrotv for a vertical head) before each tool change
                                               ; after the first. False: the new tool's first X/Y move runs at the height M06
                                               ; leaves it; compensation still on is deselected only by the safety block G40
    bHomeend              = true               ; True = sHomestrend at the program end
    bHomerotv             = true               ; True = sHomestrrotv at the first rapid of the program and at a head orientation change
    bHomeroth             = true               ; True = sHomestrroth before an A turn outside a CAM link. False: A turns at the current
                                               ; height, in its own block before X/Y/Z of the same rapid (DESIGN-004), and
                                               ; a turn ACP/ACN would run another way than CAM stops the post (PP-060)

    iR1dir                = -1                 ; A direction: 1 = +CCW, -1 = +CW
    iR2dir                = 1                  ; Second rotary axis of the template (none on this machine)
    cR1                   = 'A'                ; Rotary axis letter
    i4xIndexMode          = 0                  ; Index: 0 = turn A, 1 = turn A and step the work offset (G54, G55, ...)
    i4xIndexClearanceMode = 0                  ; Index clearance: 0 = home, 1 = tool Z level, 2 = tool start plane
    i4xFeedMode           = 1                  ; Rotating G1: 1 = G93 inverse time, 0 = programmed feed (G94)
    nMaxInverseFeed       = 59999.99           ; G93 F limit, 1/min (VMID MaxInverseFeed)

endp

@usr_ip_postwriteroptions
    ; Options for post writers: tracing.
    trace_level           = 0                  ; 5 = trace "all":5 and the CAMDBG readouts (usr_camdbg_*); NC for analysis only
    nCamDbg_f             = '5.9'              ; CAMDBG number format
    if trace_level > 0
        trace 'all':trace_level
    endif
    ; trace "@tmatrix":5
    ; trace "@def_tool":5
    ; trace "@drill_point":5
endp

; CAMDBG readouts (trace_level 5): event inputs the SolidCAM trace omits, prints as a name, or prints
; with fewer decimals than the post computes with, as '; CAMDBG <event> name:value' comment lines that
; pp_tests/tools/input_trace.py promotes into the recorded input fixture. The values are printed from
; local copies: printing clears a variable's change flag (clear_change_after_gen), which the post may
; still test. A readout opens its own lines at the start of the event (start_of_file: at its end), where
; no block waits to be joined to the last line (skipline is true between events), so the NC keeps the
; lines of trace_level 0 around the readouts.

@usr_camdbg_start_of_file
    ; date and time (absent from the trace) and the number of the drill type constant D_Tapping.
    local string sDbg1 sDbg2
    local numeric nDbg1
    if trace_level >= 5
        sDbg1 = date
        sDbg2 = time
        nDbg1 = D_Tapping
        {nl,'; CAMDBG start_of_file date:',sDbg1,' time:',sDbg2,' d_tapping_value:',nDbg1:nCamDbg_f}
    endif
endp

@usr_camdbg_def_tool
    ; next_command (absent from the trace), read by def_tool.
    local string sDbg1
    if trace_level >= 5
        sDbg1 = next_command
        {nl,'; CAMDBG def_tool next_command:',sDbg1}
    endif
endp

@usr_camdbg_start_of_job
    ; The rotary positions and d_drill_type (absent from the first job of the trace), and the numbers
    ; of the fields the post compares with numbers but the trace prints as names (coolant 'no_action',
    ; rot_axis_coord 'axis4_no').
    local numeric nDbg1 nDbg2 nDbg3 nDbg4 nDbg5 nDbg6 nDbg7 nDbg8 nDbg9
    if trace_level >= 5
        nDbg1 = angle
        nDbg2 = cpos
        nDbg3 = apos
        nDbg4 = bpos
        nDbg5 = d_drill_type
        nDbg6 = rot_axis_coord
        {nl,'; CAMDBG start_of_job angle:',nDbg1:nCamDbg_f,' cpos:',nDbg2:nCamDbg_f,' apos:',nDbg3:nCamDbg_f,' bpos:',nDbg4:nCamDbg_f,' d_drill_type:',nDbg5:nCamDbg_f,' rot_axis_coord_value:',nDbg6:nCamDbg_f}
        nDbg1 = flood_coolant
        nDbg2 = Mist_coolant
        nDbg3 = HP_Flood_coolant
        nDbg4 = LP_Flood_coolant
        nDbg5 = through_ival_coolant
        nDbg6 = LP_Through_coolant
        nDbg7 = Air_Blast_coolant
        nDbg8 = air_through_coolant
        nDbg9 = through_coolant_val
        {nl,'; CAMDBG start_of_job flood_coolant_value:',nDbg1:nCamDbg_f,' mist_coolant_value:',nDbg2:nCamDbg_f,' hp_flood_coolant_value:',nDbg3:nCamDbg_f,' lp_flood_coolant_value:',nDbg4:nCamDbg_f}
        {nl,'; CAMDBG start_of_job through_ival_coolant_value:',nDbg5:nCamDbg_f,' lp_through_coolant_value:',nDbg6:nCamDbg_f,' air_blast_coolant_value:',nDbg7:nCamDbg_f,' air_through_coolant_value:',nDbg8:nCamDbg_f,' through_coolant_val:',nDbg9:nCamDbg_f}
    endif
endp

@usr_camdbg_move(integer iAxes)
    ; prev_command (absent from the trace) of the 4x/5x rapid events (iAxes 4/5), the only rapids
    ; whose CAM link test reads it (usr_rapid_cam_link).
    local string sDbg1 sDbg2
    if trace_level >= 5
        sDbg1 = 'move_5x'
        if iAxes eq 4
            sDbg1 = 'move_4x'
        endif
        sDbg2 = prev_command
        {nl,'; CAMDBG ',sDbg1,' prev_command:',sDbg2}
    endif
endp

@usr_camdbg_arc
    ; The start point (absent from the trace) and the centre, zcenter_rel and arc_size, which the
    ; trace prints with 3 to 5 decimals: usr_arc_math rotates the start about the centre by arc_size
    ; and checks the result against the CAM end point to 0.001.
    local string sDbg1
    local numeric nDbg1 nDbg2 nDbg3 nDbg4 nDbg5 nDbg6 nDbg7
    if trace_level >= 5
        sDbg1 = 'arc'
        if arc_plane eq YZ
            sDbg1 = 'arc_yz'
        endif
        if arc_plane eq ZX
            sDbg1 = 'arc_zx'
        endif
        nDbg1 = xstart
        nDbg2 = ystart
        nDbg3 = zstart
        nDbg4 = xcenter_rel
        nDbg5 = ycenter_rel
        nDbg6 = zcenter_rel
        nDbg7 = arc_size
        {nl,'; CAMDBG ',sDbg1,' xstart:',nDbg1:nCamDbg_f,' ystart:',nDbg2:nCamDbg_f,' zstart:',nDbg3:nCamDbg_f}
        {nl,'; CAMDBG ',sDbg1,' xcenter_rel:',nDbg4:nCamDbg_f,' ycenter_rel:',nDbg5:nCamDbg_f,' zcenter_rel:',nDbg6:nCamDbg_f,' arc_size:',nDbg7:nCamDbg_f}
    endif
endp

;-------------------

@start_of_file
    ; Start of the NC file (first event after @init_post): ';%_N_<part>_MPF', the workpiece directory,
    ; date and time, the VMID messages.
    bWorkpieceBuffered = false
    bWorkpieceUsesA = false
    call @usr_check_options
    call @usr_init_gmstates
    {,cPb}
    call @usr_sof_progname
    call @usr_US_date
    call @usr_US_time
    if bDateTimeOutput
        {nl,cCb,sUS_date'-'sUS_time,cCe}
    endif
    if bTlseperation
        {nl}
        {nl}
        {nl}
    endif
    if message1 ne ''
        {NL, cCb message1 cCe }
    endif
    if message2 ne ''
        {NL, cCb message2 cCe }
    endif
    if message3 ne ''
        {NL, cCb message3 cCe }
    endif
    if message4 ne ''
        {NL, cCb message4 cCe }
    endif
    if message5 ne ''
        {NL, cCb message5 cCe }
    endif
    if message6 ne ''
        {NL, cCb message6 cCe }
    endif
    if message7 ne ''
        {NL, cCb message7 cCe }
    endif
    if message8 ne ''
        {NL, cCb message8 cCe }
    endif
    if message9 ne ''
        {NL, cCb message9 cCe }
    endif
    if message10 ne ''
        {NL, cCb message10 cCe }
    endif
    call @usr_camdbg_start_of_file
endp

@usr_check_options
    ; Stop on settings this Sinumerik 828D post does not support (template features for other
    ; controls). Checked once at the start of the file, after the user options are set.
    local numeric dummy_var
    if iNumber_of_Fixtures > 1
        dummy_var = 0
        input '"POST ERROR: Multiple fixtures (more than one fixture in the job) are not supported by this post."'dummy_var
        {nb,"POST ERROR: Multiple fixtures (more than one fixture in the job) are not supported by this post."}
        abort
    endif
    if i4xIndexClearanceMode ne 0 and i4xIndexClearanceMode ne 1 and i4xIndexClearanceMode ne 2
        dummy_var = 0
        input '"POST ERROR: i4xIndexClearanceMode must be 0, 1 or 2."'dummy_var
        {nb,"POST ERROR: i4xIndexClearanceMode must be 0, 1 or 2."}
        abort
    endif
    if i4xIndexMode ne 0 and i4xIndexMode ne 1
        dummy_var = 0
        input '"POST ERROR: i4xIndexMode must be 0 or 1."'dummy_var
        {nb,"POST ERROR: i4xIndexMode must be 0 or 1."}
        abort
    endif
    if i4xFeedMode ne 0 and i4xFeedMode ne 1
        dummy_var = 0
        input '"POST ERROR: i4xFeedMode must be 0 or 1."'dummy_var
        {nb,"POST ERROR: i4xFeedMode must be 0 or 1."}
        abort
    endif
    if iR1dir ne -1
        ; ACP/ACN follow dir5a as recorded with iR1dir -1; +1 would flip every turn (PP-004).
        dummy_var = 0
        input '"POST ERROR: iR1dir must be -1 (the A direction checked against SolidCAM)."'dummy_var
        {nb,"POST ERROR: iR1dir must be -1 (the A direction checked against SolidCAM)."}
        abort
    endif
endp

@usr_unsupported_event
    ; Stop on a SolidCAM event this post does not support (subprograms, loops, G10 offset writes).
    local numeric dummy_var
    dummy_var = 0
    input '"POST ERROR: SolidCAM subprograms, loops and reference point changes are not supported by this post."'dummy_var
    {nb,"POST ERROR: SolidCAM subprograms, loops and reference point changes are not supported by this post."}
    abort
endp

@usr_unsupported_transform
    ; Stop on a SolidCAM transformation (@rotate / @mirror) instead of posting the copy untransformed.
    local numeric dummy_var
    dummy_var = 0
    input '"POST ERROR: SolidCAM rotate/mirror transformations are not supported by this post."'dummy_var
    {nb,"POST ERROR: SolidCAM rotate/mirror transformations are not supported by this post."}
    abort
endp

@usr_sof_progname
    ; The program name after cPb (';%_N_<part>_MPF') and the workpiece directory line. Sinumerik
    ; names allow letters, digits and '_': every '-' of the part name becomes '_'.
    local integer iDash
    iDash = instr(part_name,'-')
    while iDash gt 0
        part_name = left(part_name,(iDash-1)) + '_' + right(part_name,(strlen(part_name)-iDash))
        iDash = instr(part_name,'-')
    endw
    if bUseprogname
        {part_name'_MPF' }
        if strlen(sWorkpcDir) eq 0
            {nl,cCb, '$PATH=/_N_WKS_DIR/_N_WPD'  ,cCe}
        else
            {nl,cCb, '$PATH=/_N_WKS_DIR/_N_'sWorkpcDir '_WPD' ,cCe}
        endif
    endif
endp

@usr_US_date
    ; Converts Europe Date format to US format
    Local Integer iInt1
    iInt1 = instr(date,'-')
    sUS_date = substr(date,(iInt1+1),3) + '-' + substr(date,1,(iInt1-1)) + '-' + right(date,4)
endp

@usr_US_time
    ; Converts Military time to 12hr format: 'HH:MM:SS' -> sUS_time 'H:MM:SSAM' / 'H:MM:SSPM'.
    local integer iColon iHour24 iHour
    local string sMeridiem
    iColon = instr(time,':')
    iHour24 = tonum(left(time,(iColon-1)))
    if iHour24 < 12
        sMeridiem = 'AM'
    else
        sMeridiem = 'PM'
    endif
    iHour = iHour24
    if iHour24 > 12
        iHour = iHour24 - 12
    endif
    if iHour24 < 1
        iHour = 12
    endif
    sUS_time = tostr(iHour:'5.0(p)') + substr(time,iColon,8) + sMeridiem
endp

@usr_init_gmstates
    ; Modal state at the start of the file: what the control has active before the first block.
    iMotionmode     = 9999
    iMplane         = 17
    iAbsincmode     = 90
    ; 9999 is no code output yet: the first real value differs from it, so its change flag forces the output.
    iWorkoffset     = 9999
    iDiametercomp   = 9999
    iCompActive     = 9999
    ; Tool change counter (N number of the tool change block with bNnumtc): 2001 for the first tool,
    ; +1 for every later tool.
    iTcnumber       = 2001
    iCoolantM1      = iCoolantM1OFF
    iCoolantM2      = iCoolantM2OFF
    iCoolantM3      = iCoolantM3OFF
    iCoolantM4      = iCoolantM4OFF
    iCoolantM5      = iCoolantM5OFF
    iCoolantM6      = iCoolantM6OFF
    iCoolantM7      = iCoolantM7OFF
    iCoolantM8      = iCoolantM8OFF
    ; The control starts with every coolant off. The eight assignments above flag every channel:
    ; kept, the first operation printed an OFF code for each (M9 eight times; after its M8 too,
    ; which switched the flood off again) unless SolidCAM clears a flag on an equal assignment.
    change(iCoolantM1) = false
    change(iCoolantM2) = false
    change(iCoolantM3) = false
    change(iCoolantM4) = false
    change(iCoolantM5) = false
    change(iCoolantM6) = false
    change(iCoolantM7) = false
    change(iCoolantM8) = false
    bTmatrixIndexPending = false
    bIndexClearancePending = true
    bCamLinkRetract = false
    bJobPositioned = false
    bPostHomed = false
    bPostHomedZ = false
    bTcReprogram = false
    bClimbZValid = false
    iFeedMode = 94
    change(iFeedMode) = false
    bFeedPrevValid = false
    nFeedPrevX = 0
    nFeedPrevY = 0
    nFeedPrevZ = 0
    nFeedPrevA = 0
    nFeedPrevR1 = 0
    nLastPathZ = 0
    nLastPathWorkoffset = -9999
    nPR1pos         = 0
    nPR1postemp     = 0
    nPR1camcpos     = 0
    nPR1camapos     = 0
    nR1from         = 0
    nR1travel       = 0
    nR1camstep      = 0
    bR1wrongWay     = false
    bR1turnDropped  = false
    bR1StepReset    = false
    change(cWo)     = false
    bFirstVert      = true
    bBoundaryStop   = false
    bStopSinceMotion = false
    ; No CYCLE832 yet: the control has its reset settings, as in a program without one.
    iCycle832Mode   = 0
    nCycle832Tol    = 0
    iCycle832Want   = 0
    nCycle832WantTol = 0
    iCycle832Job    = 0
    bCycle832Auto   = false
endp

;-------------------

@def_tool
    ; Tool list line of the header (bTlist); after the last tool: the WORKPIECE blank.
    call @usr_camdbg_def_tool
    if bTlist
        if tool_message == '' then
            {nl, cCb'TOOL 'tool_number, ' - DIA '(tool_offset*2),' | HOLDER: ',holder_name,' | STICKOUT: ',tool_length:'5.3',' mm',cCe }
        else
            {nl,cCb'T'tool_number,'-' tool_message,' | HOLDER: ',holder_name,' | STICKOUT: ',tool_length:'5.3',' mm',cCe}
            if msg_mill_tool1 ne ''
                {nl,cCb'---' msg_mill_tool1,cCe}
            endif
            if msg_mill_tool2 ne ''
                {nl,cCb'---' msg_mill_tool2,cCe}
            endif
            if msg_mill_tool3 ne ''
                {nl,cCb'---' msg_mill_tool3,cCe}
            endif
            if msg_mill_tool4 ne ''
                {nl,cCb'---' msg_mill_tool4,cCe}
            endif
            if msg_mill_tool5 ne ''
                {nl,cCb'---' msg_mill_tool5,cCe}
            endif
        endif
        ; After the last tool of the header list (a @def_tool after @change_tool is not the header).
        if next_command ne '@def_tool' and bTlchg eq false
            if bTlseperation
                {nl}
                {nl}
                {nl}
            endif
            if bOptstpbegin
                call @usr_optionalstop
            endif
            {nl, 'MSG(" Loading Zeropoints ")'}
            call @usr_workpiece_begin
        endif
    endif
endp

;-------------------

@usr_workpiece_stock
    ; Siemens SINUMERIK Operate blank definition:
    ; https://support.industry.siemens.com/cs/mdm/109760802?c=87879191435&dl=nl&lc=en-US
    ;
    ; General syntax:
    ; WORKPIECE("<WP>","<RefP>","<ZeroOffset>","<Type>",Par5,Par6,...,Par12)
    ;
    ; <WP> is optional. Empty <WP> lets the control use its default WORKP<n> name.
    ; <RefP> is the clamping reference for milling machines:
    ;   empty   = current/default table reference
    ;   "Table" = fixed table clamping
    ;   "A"     = blank clamped on rotary axis A
    ;   "B"     = blank clamped on rotary axis B
    ;   "C"     = blank clamped on rotary axis C
    ; <ZeroOffset> is not programmable in the part program; an empty value means the
    ; blank is related to the currently active work offset.
    ;
    ; Par5 is a bit parameter. With Par5 = 0 the following size parameters are
    ; interpreted incrementally where Siemens allows inc/abs selection.
    ;
    ; "RECTANGLE" is Siemens' centered cuboid, not an arbitrary XY box:
    ;   Par6  = Z0 reference point
    ;   Par7  = Z1 length
    ;   Par8  = ZB machining dimension
    ;   Par9  = W width
    ;   Par10 = L length
    ;   Par11 = rotation about rotary axis
    ;
    ; "BOX" is Siemens' non-centered cuboid:
    ;   Par6  = Z0 reference point
    ;   Par7  = Z1 length
    ;   Par8  = ZB machining dimension
    ;   Par9  = X0
    ;   Par10 = Y0
    ;   Par11 = X1
    ;   Par12 = Y1
    ; With Par5 = 0, X1/Y1/Z1/ZB are incremental. Therefore for a SolidCAM stock
    ; box we output X0/Y0 from stock_*_minus and X1/Y1 as stock_x/stock_y sizes.
    ;
    ; BOX geometry is independent of the clamping reference. The header is emitted
    ; after scanning the body, but before that body is copied into the final file.
    if !bWorkpieceBuffered
        call @usr_workpiece_data
    endif
    if bWorkpieceUsesA
        {nl, 'WORKPIECE(,"A",' sWorkpieceArgs}
    else
        {nl, 'WORKPIECE(,,' sWorkpieceArgs}
    endif
endp

@usr_workpiece_data
    ; Snapshot the stock in the initial MAC before later jobs change CAM values.
    ; Preserve the header's numeric format even if motion output changes xpos_f.
    sWorkpieceArgs = ',"BOX",0,' + tostr(stock_z_plus:xpos_f)
    sWorkpieceArgs = sWorkpieceArgs + ',' + tostr((stock_z_minus - stock_z_plus):xpos_f)
    sWorkpieceArgs = sWorkpieceArgs + ',' + tostr((target_z_minus - stock_z_plus):xpos_f)
    sWorkpieceArgs = sWorkpieceArgs + ',' + tostr(stock_x_minus:xpos_f) + ',' + tostr(stock_y_minus:xpos_f)
    sWorkpieceArgs = sWorkpieceArgs + ',' + tostr(stock_x:xpos_f) + ',' + tostr(stock_y:xpos_f) + ')'
endp

@usr_workpiece_begin
    if !bWorkpieceBuffered
        sWorkpieceBodyPath = full_g_file_name + '.workpiece.tmp'
        call @usr_workpiece_data
        {nl, '!!open file=' sWorkpieceBodyPath '!!'}
        bWorkpieceBuffered = true
    endif
endp

@usr_workpiece_flush
    if bWorkpieceBuffered
        {nl, '!!close file=' sWorkpieceBodyPath '!!'}
        call @usr_workpiece_stock
        {nl, '!!copy file=' sWorkpieceBodyPath '!!'}
        {nl, '!!delete file=' sWorkpieceBodyPath '!!'}
        bWorkpieceBuffered = false
    endif
endp

;-------------------

@start_program
    ; Program start: home (sHomestrbegin, bHomebegin).
    if bHomebegin
        sHomestr = sHomestrbegin
        call @usr_prep_home_axis
    endif
endp

;-------------------

@end_program
    ; End of program: coolant and spindle off, homing (bHomeend), optional stop, CYCLE832 off, M30 (or M2).
    if bCooloffend and bCoolExist
        call @usr_coolant_prep_all_off
        call @usr_coolant_output
    endif
    if bSpinoffend
        call @usr_spindle_stop
    endif
    if bHomeend
        sHomestr = sHomestrend
        call @usr_prep_home_axis
    endif
    if bOptstpend
        call @usr_optionalstop
    endif
    if iCycle832Mode ne 0
        ; M30 resets the G groups too (machine data); M2 or a reset that keeps them would not.
        call @usr_smoothing_off
    endif
    if bToolChangeAtEnd
        {nb,cTCcodep'T'next_tool_number' 'cTCcodes}
    endif
    if iProgendmode eq 1
        {nb, 'M30'}
        {nl}
    endif
    if iProgendmode eq 2
        {nb, 'M2'}
        {nl}
    endif
endp

;-------------------

@end_of_file
    ; The end-of-file line cPe ('' here: none).
    if cPe ne ''
        {nl,cPe}
    endif
    call @usr_workpiece_flush
endp

;-------------------

@relative_mode
    ; G91 for the following moves.
    iAbsincmode = 91
endp

@absolute_mode
    ; G90 for the following moves.
    iAbsincmode = 90
endp

@usr_abs_inc_output
    ; G90/G91 when it changed (optional word).
    {['G'iAbsincmode, ' ']}
endp

;-------------------

@machine_plane
    ; SolidCAM event: the job's machining plane (iMplane); the motion blocks print it.
    if machine_plane eq XY
        iMplane = 17
    endif
    if machine_plane eq ZX
        iMplane = 18
    endif
    if machine_plane eq YZ
        iMplane = 19
    endif
endp

@usr_job_plane
    ; Select the job's machining plane (G17 when SolidCAM leaves machine_plane empty or unknown).
    ; Assign only on a change: an equal-value assignment could clear a pending change flag.
    local integer iJobPlane
    iJobPlane = 17
    if machine_plane eq ZX
        iJobPlane = 18
    endif
    if machine_plane eq YZ
        iJobPlane = 19
    endif
    if iMplane ne iJobPlane
        iMplane = iJobPlane
    endif
endp

;-------------------

@home_number
    ; Work offset of the job: G54 (VMID iWorkOffset_Method 0) or the number of the CoordSys name
    ; (iWorkOffset_Method 1, e.g. '55').
    if iWorkOffset_Method eq 0
        iWorkoffset = 54
    else
        iWorkoffset = tonum(home_user_name)
    endif
endp

;-------------------

@usr_link_boundary
    ; A tool change or job boundary ends the CAM link context: the next rotation needs its clearance
    ; or homing again (usr_rapid_cam_link), no Z retract authorizes the following rapids, and the
    ; next job is not positioned yet.
    bIndexClearancePending = true
    bCamLinkRetract = false
    bJobPositioned = false
endp

@change_tool
    ; SolidCAM tool change event. The change itself is made at the next @start_of_job (usr_ct), which
    ; knows the operation; here the target X/Y/C of the new tool is kept.
    call @usr_link_boundary
    nTcXnext = xnext
    nTcYnext = ynext
    nTcCnext = cnext
    bTlchg = true
endp

@usr_ct
    ; Tool change: stop and home the old tool (or the safety block before the first), T / M6 / D1,
    ; then spindle, coolant and the positioning rapid of the new tool.
    if !first_tool
        iTcnumber = iTcnumber + 1
    endif
    call @usr_tc_init_gmstates
    if !first_tool
        call @usr_ct_before_notfirsttool
    else
        call @usr_ct_before_firsttool
    endif
    call @usr_ct_toolchange
    ; M06 moves the axes and D1 changes the tool length: the CAM change flags no longer describe the
    ; machine position, homed or not.
    bTcReprogram = true
    call @usr_ct_after
endp

@usr_ct_before_notfirsttool
    ; Before a tool change after the first: coolant and spindle off, home (bHometc), optional stop,
    ; CYCLE832 off, safety block.
    ; bStopM00difftool is always false here (PP-056: end_of_job clears it in the same event), so the
    ; G75 retract before M06 runs whenever bHometc is set.
    local numeric dummy_var
    if !bStopM00difftool
        if bCooloffend and bCoolExist
            call @usr_coolant_prep_all_off
            call @usr_coolant_output
        endif
        if bSpinoffend
            call @usr_spindle_stop
        endif
        if bVertical
            ; The head was vertical: home with the head-orientation homing (sHomestrrotv) instead of
            ; the tool-change homing.
            call @usr_head_home_select
            bVertical = false
        else
            sHomestr = sHomestrtc
        endif
        if (iCompActive eq 41 or iCompActive eq 42) and (!bHometc or instr(sHomestr,'Z') eq 0)
            ; Only a Z homing deselects compensation still on here (usr_prep_home_axis); the safety
            ; block's G40 has no axis, so M06 would run with it on.
            dummy_var = 0
            input '"POST ERROR: Cutter compensation is still on at a tool change without a Z homing. Switch it off in CAM before the job ends."'dummy_var
            {nb,"POST ERROR: Cutter compensation is still on at a tool change without a Z homing. Switch it off in CAM before the job ends."}
            abort
        endif
        if bHometc
            call @usr_prep_home_axis
        endif
        if bOptstptc
            call @usr_optionalstop
        endif
    endif
    if bTcseperation
        {nl}
    endif
    if iCycle832Mode ne 0
        ; M06 and the safety block run in the reset settings of the control; the next operation
        ; selects its own after M06 (usr_smoothing).
        call @usr_smoothing_off
    endif
    call @usr_ct_safety_block
endp

@usr_ct_before_firsttool
    ; Before the first tool change: coolant off as before every tool change (bCooloffend; the control
    ; may still have it on from an earlier program), then the safety block.
    if bCooloffend and bCoolExist
        call @usr_coolant_prep_all_off
        call @usr_coolant_output
    endif
    call @usr_ct_safety_block
endp

@usr_ct_safety_block
    ; Safety block before the T word of every tool change: G17 G40 G64 G90 (after N<iTcnumber>
    ; with bNnumtc). It also resets the modal states for the new tool.
    bSafetyprep = true
    call @usr_tc_init_gmstates
    if bNnumtc
        {nl,'N'iTcnumber' '}
        skipline = false
    else
        ; A line with only ';' separates the tool change.
        {nb,cCb}
    endif
    {nb, 'G17 G40 G64 G90'}
    ; The safety block cancels cutter compensation on the control: keep the post's state in step.
    iDiametercomp = 40
    change(iDiametercomp) = false
    iCompActive = 40
endp

@usr_ct_toolchange
    ; T, M06 and D1 of the new tool, the preselected next tool and MSG(job_name).
    {nb, 'T',tool_number,cTCcodes}
    {nb, cTCcodep}
    {nb, 'D1 '}

    if bToolPreselect
        if !last_tool
            {nb, 'T'next_tool_number' '}
        endif
    endif
    {nb, cOMb,job_name,cOMe}
endp

@usr_ct_after
    ; After the T / M6 / D1 blocks: the operation comment lines (msg), then the spindle start, the coolant and
    ; the first positioning rapid (usr_rapid_tc_block) in the order bCoolspinaftertc selects.
    call @usr_ct_msg_lines
    if bCoolspinaftertc
        ; Spindle and coolant first, each in its own block, then the positioning rapid.
        skipline = true
        call @start_tool
        if bCoolExist
            skipline = true
            call @usr_coolant
        endif
        call @usr_ct_target
        call @usr_rapid
    else
        ; The positioning rapid first; the coolant and the spindle start join its line.
        call @usr_ct_target
        skipline = true
        call @usr_rapid
        if bCoolExist
            skipline = false
            call @usr_coolant
        endif
        skipline = false
        call @start_tool
    endif
endp

@usr_ct_msg_lines
    ; The operation message (msg) as comment lines, one per line of the message, at most 49. The lines
    ; end with CR LF: a line is the text up to two characters before the LF. Needs '\n' to be one LF
    ; character (unverified in SolidCAM). A message ending in a line break gives an empty last comment.
    local integer iLines iLf
    local logical bMore
    local string sLine
    bMore = false
    if msg ne ''
        bMore = true
    endif
    iLines = 0
    while bMore and iLines < 49
        iLines = iLines + 1
        iLf = instr(msg,'\n')
        if iLf eq 0
            sLine = msg
            bMore = false
        else
            sLine = left(msg,(iLf-2))
        endif
        {nb, cCb,sLine,cCe}
        if bMore
            msg = substr(msg,(iLf+1),(strlen(msg)-strlen(sLine)))
        endif
    endw
endp

@usr_ct_target
    ; The rapid after a tool change targets the X/Y/C that @change_tool saved, without a Z move: it
    ; programs only the work offset and A (usr_rapid_tc_block); X/Y follow on the job's first move.
    xpos = nTcXnext
    ypos = nTcYnext
    cpos = nTcCnext
    ; cnext is CAM's C for the new tool: the CAM-side cpos reference (usr_r1pos_calc), also while a
    ; post reset holds the apos one.
    nPR1camcpos = (-cpos) * iR1dir
    change(zpos) = false
endp

@usr_tc_init_gmstates
    ; Modal states for the new tool. Runs twice per tool change: from usr_ct (full reset) and from
    ; usr_ct_safety_block with bSafetyprep set (plane, abs/inc and compensation flags only); and from
    ; start_of_job for a same-tool work offset change (full reset).
    ; Known defect PP-027: the first-tool branch never clears bSafetyprep, so the usr_ct call of the
    ; second tool takes the bSafetyprep branch and skips the full reset.
    if first_tool
        iMotionmode = 9999
        iDiametercomp = 40
        change(iAbsincmode) = false
        call @machine_plane
        change(iMplane) = true
        change(iWorkoffset) = true
        change(iDiametercomp) = false
    else
        if bSafetyprep
            call @machine_plane
            change(iMplane) = true
            change(iAbsincmode) = false
            change(iDiametercomp) = false
            bSafetyprep = false
        else
            iMotionmode = 9999
            if bWorkoffsettc
                change(iWorkoffset) = true
            endif
            change(iAbsincmode) = false
            iDiametercomp = 40
            change(nRapidfeed) = true
            apos = 0
            bpos = 0
            cpos = 0
            ; The post zeroed the CAM A, CAM did not: keep the CAM-side references (usr_r1pos_calc).
            bR1StepReset = true
        endif
    endif
endp

@usr_coolant
    ; Coolant M codes from the operation's coolant fields (1 = on, 0 or 2 = off; other values keep the
    ; last code). bskipline (the last field read wins; on = false) makes usr_coolant_output put the
    ; codes of this call on one line; the block after them starts a new line.
    if flood_coolant eq 1
        iCoolantM1 = iCoolantM1ON
        bskipline = false
    endif
    if flood_coolant eq 0 or flood_coolant eq 2
        iCoolantM1 = iCoolantM1OFF
        bskipline = true
    endif
    if Mist_coolant eq 1
        iCoolantM2 = iCoolantM2ON
        bskipline = false
    endif
    if Mist_coolant eq 0 or Mist_coolant eq 2
        iCoolantM2 = iCoolantM2OFF
        bskipline = true
    endif
    if HP_Flood_coolant eq 1
        iCoolantM3 = iCoolantM3ON
        bskipline = false
    endif
    if HP_Flood_coolant eq 0 or HP_Flood_coolant eq 2
        iCoolantM3 = iCoolantM3OFF
        bskipline = true
    endif
    if LP_Flood_coolant eq 1
        iCoolantM4 = iCoolantM4ON
        bskipline = false
    endif
    if LP_Flood_coolant eq 0 or LP_Flood_coolant eq 2
        iCoolantM4 = iCoolantM4OFF
        bskipline = true
    endif
    ; Through-spindle coolant: the pressure value selects the M code. A value not in the list keeps the
    ; last selected code (iCoolantM5ON is not reset). 07 is a leading-zero literal of 7.
    if through_ival_coolant eq 1
        if through_coolant_val eq 5
            iCoolantM5ON = 77
        endif
        if through_coolant_val eq 10
            iCoolantM5ON = 76
        endif
        if through_coolant_val eq 15
            iCoolantM5ON = 75
        endif
        if through_coolant_val eq 30
            iCoolantM5ON = 07
        endif
        if through_coolant_val eq 40
            iCoolantM5ON = 71
        endif
        if through_coolant_val eq 50
            iCoolantM5ON = 72
        endif
        if through_coolant_val eq 60
            iCoolantM5ON = 73
        endif
        if through_coolant_val eq 70
            iCoolantM5ON = 74
        endif
        iCoolantM5 = iCoolantM5ON
        bskipline = false
    endif
    if through_ival_coolant eq 0 or through_ival_coolant eq 2
        iCoolantM5 = iCoolantM5OFF
        bskipline = true
    endif
    if LP_Through_coolant eq 1
        iCoolantM6 = iCoolantM6ON
        bskipline = false
    endif
    if LP_Through_coolant eq 0 or LP_Through_coolant eq 2
        iCoolantM6 = iCoolantM6OFF
        bskipline = true
    endif
    if Air_Blast_coolant eq 1
        iCoolantM7 = iCoolantM7ON
        bskipline = false
    endif
    if Air_Blast_coolant eq 0 or Air_Blast_coolant eq 2
        iCoolantM7 = iCoolantM7OFF
        bskipline = true
    endif
    if air_through_coolant eq 1
        iCoolantM8 = iCoolantM8ON
        bskipline = false
    endif
    if air_through_coolant eq 0 or air_through_coolant eq 2
        iCoolantM8 = iCoolantM8OFF
        bskipline = true
    endif
    call @usr_coolant_output
endp

@usr_coolant_output
    ; One M code per coolant channel whose state changed (bskipline joins them to the current line),
    ; each code once (usr_coolant_code: every OFF code is M9). The change flags mark the channels of
    ; this call until its end: usr_coolant_code prints a copy of the code, which leaves them set.
    if change(iCoolantM1)
        call @usr_coolant_code(iCoolantM1, 1)
    endif
    if change(iCoolantM2)
        call @usr_coolant_code(iCoolantM2, 2)
    endif
    if change(iCoolantM3)
        call @usr_coolant_code(iCoolantM3, 3)
    endif
    if change(iCoolantM4)
        call @usr_coolant_code(iCoolantM4, 4)
    endif
    if change(iCoolantM5)
        call @usr_coolant_code(iCoolantM5, 5)
    endif
    if change(iCoolantM6)
        call @usr_coolant_code(iCoolantM6, 6)
    endif
    if change(iCoolantM7)
        call @usr_coolant_code(iCoolantM7, 7)
    endif
    if change(iCoolantM8)
        call @usr_coolant_code(iCoolantM8, 8)
    endif
    change(iCoolantM1) = false
    change(iCoolantM2) = false
    change(iCoolantM3) = false
    change(iCoolantM4) = false
    change(iCoolantM5) = false
    change(iCoolantM6) = false
    change(iCoolantM7) = false
    change(iCoolantM8) = false
    ; The next block starts a new line unless the caller sets skipline = false again (usr_ct_after).
    ; (The template tested 'any coolant flag not set' here, always true: the output above cleared them.)
    skipline = TRUE
endp

@usr_coolant_code(integer iCode, integer iChannel)
    ; M<iCode> for coolant channel iChannel of usr_coolant_output, unless an earlier channel of the
    ; same call has the same code (every OFF code is M9: channels switched off together print one).
    local logical bRepeat
    bRepeat = false
    if iChannel > 1 and change(iCoolantM1) and iCoolantM1 eq iCode
        bRepeat = true
    endif
    if iChannel > 2 and change(iCoolantM2) and iCoolantM2 eq iCode
        bRepeat = true
    endif
    if iChannel > 3 and change(iCoolantM3) and iCoolantM3 eq iCode
        bRepeat = true
    endif
    if iChannel > 4 and change(iCoolantM4) and iCoolantM4 eq iCode
        bRepeat = true
    endif
    if iChannel > 5 and change(iCoolantM5) and iCoolantM5 eq iCode
        bRepeat = true
    endif
    if iChannel > 6 and change(iCoolantM6) and iCoolantM6 eq iCode
        bRepeat = true
    endif
    if iChannel > 7 and change(iCoolantM7) and iCoolantM7 eq iCode
        bRepeat = true
    endif
    if !bRepeat
        {nb,'M'iCode:mcode_f' '}
        skipline = bskipline
    endif
endp

@usr_coolant_prep_all_off
    ; Prepare coolant off for usr_coolant_output: every code takes its OFF value and only iCoolantM1
    ; is flagged, so one OFF code is output.
    iCoolantM1 = iCoolantM1OFF
    iCoolantM2 = iCoolantM2OFF
    iCoolantM3 = iCoolantM3OFF
    iCoolantM4 = iCoolantM4OFF
    iCoolantM5 = iCoolantM5OFF
    iCoolantM6 = iCoolantM6OFF
    iCoolantM7 = iCoolantM7OFF
    iCoolantM8 = iCoolantM8OFF
    change(iCoolantM1) = true
    change(iCoolantM2) = false
    change(iCoolantM3) = false
    change(iCoolantM4) = false
    change(iCoolantM5) = false
    change(iCoolantM6) = false
    change(iCoolantM7) = false
    change(iCoolantM8) = false
    bskipline = true
endp

@usr_check_smoothing
    ; Stop on job parameters iG187_P / nG187_E (VMID) that usr_smoothing cannot follow: any non-zero
    ; value with bCycle832 false; P outside -1 to 3; E below 0, above 0.2 mm, between 0 and 0.001 mm,
    ; or set with P -1. The control rounds G0 corners by $SCS_MILL_TOL_FACTOR_* (10 here) times the
    ; tolerance: 2 mm at 0.2 mm.
    local numeric dummy_var
    if !bCycle832 and (iG187_P ne 0 or nG187_E ne 0)
        dummy_var = 0
        input '"POST ERROR: CYCLE832 is switched off (bCycle832): set the job parameters iG187_P and nG187_E to 0."'dummy_var
        {nb,"POST ERROR: CYCLE832 is switched off (bCycle832): set the job parameters iG187_P and nG187_E to 0."}
        abort
    endif
    if iG187_P < -1 or iG187_P > 3 or nG187_E < 0 or nG187_E > 0.2 or (nG187_E > 0 and nG187_E < 0.001) or (iG187_P eq -1 and nG187_E ne 0)
        dummy_var = 0
        input '"POST ERROR: Job parameters: iG187_P -1 (no CYCLE832), 0 (by allowance), 1 (rough), 2 (semi), 3 (finish); nG187_E 0 or 0.001-0.2 mm."'dummy_var
        {nb,"POST ERROR: Job parameters: iG187_P -1 (no CYCLE832), 0 (by allowance), 1 (rough), 2 (semi), 3 (finish); nG187_E 0 or 0.001-0.2 mm."}
        abort
    endif
endp

@usr_smoothing
    ; CYCLE832 High Speed Settings of the operation, at the job start after the tool change (or the
    ; job comment of the same tool) and before the first move: CYCLE832(tolerance, type, 1) with
    ; type 3 roughing / 2 semi-finishing / 1 finishing and the tolerance nCycle832TolRough / Semi /
    ; Finish. The job parameter iG187_P (the Haas G187 P of the template) chooses the type: 1 / 2 / 3.
    ; With iG187_P 0 the wall allowance does (wall_offset; on a 3D profile the smaller of wall_offset
    ; and floor_offset, as its path also moves in Z): roughing from nCycle832RoughAllow, semi-
    ; finishing from nCycle832TolSemi, finishing below, so the tolerance stays within the allowance;
    ; the finishing passes of the job switch to finishing (usr_smoothing_feed). nG187_E > 0 replaces
    ; the tolerance. No CYCLE832 (deselected when active) with iG187_P -1, with iG187_P 0 on a
    ; simultaneous 4x/5x job (X5_job) or a drilling job, and with bCycle832 false. Printed when the
    ; type or the tolerance changes, not with cutter compensation on (usr_smoothing_apply); a tool
    ; change, a drilling cycle and the program end deselect it.
    ; Machine 2026-10-27: CYCLE832 selects G645, SOFT, COMPSURF and DYNROUGH / DYNSEMIFIN /
    ; DYNFINISH; CYCLE832(0,0,1) returns to G64, SOFT, COMPOF, DYNNORM.
    local integer iMode
    local numeric nAllow
    call @usr_check_smoothing
    iMode = 0
    bCycle832Auto = false
    if bCycle832 and iG187_P eq 0 and !X5_job and instr(job_type,'drill') eq 0
        bCycle832Auto = true
        nAllow = wall_offset
        if job_type eq 'profile_3D' and floor_offset < nAllow
            nAllow = floor_offset
        endif
        iMode = 1
        if nAllow >= nCycle832TolSemi
            iMode = 2
        endif
        if nAllow >= nCycle832RoughAllow and nAllow >= nCycle832TolRough
            iMode = 3
        endif
    endif
    if bCycle832 and iG187_P eq 1
        iMode = 3
    endif
    if bCycle832 and iG187_P eq 2
        iMode = 2
    endif
    if bCycle832 and iG187_P eq 3
        iMode = 1
    endif
    iCycle832Job = iMode
    call @usr_smoothing_set(iMode)
    call @usr_smoothing_apply
endp

@usr_smoothing_feed
    ; Feed move of a job with the type by allowance (bCycle832Auto): its finishing passes (feed_type
    ; finish_feed or finish_feed_floor) take finishing, its cutting feed (feed_rate) the type of the
    ; allowance again; plunges and links keep the type. Reference trace 2026-10-27: SolidCAM pockets
    ; give the roughing allowance as wall_offset and finish walls and floor at its end (8 of 31
    ; operations), which would cut the final walls in the roughing tolerance.
    if bCycle832Auto
        if feed_type eq 'finish_feed' or feed_type eq 'finish_feed_floor'
            call @usr_smoothing_set(1)
        endif
        if feed_type eq 'feed_rate'
            call @usr_smoothing_set(iCycle832Job)
        endif
    endif
    call @usr_smoothing_apply
endp

@usr_smoothing_set(integer iMode)
    ; The CYCLE832 type the cut asks for (0 = none) and its tolerance (nG187_E > 0 replaces it).
    iCycle832Want = iMode
    nCycle832WantTol = 0
    if iMode eq 1
        nCycle832WantTol = nCycle832TolFinish
    endif
    if iMode eq 2
        nCycle832WantTol = nCycle832TolSemi
    endif
    if iMode eq 3
        nCycle832WantTol = nCycle832TolRough
    endif
    if iMode ne 0 and nG187_E > 0
        nCycle832WantTol = nG187_E
    endif
endp

@usr_smoothing_apply
    ; Select the CYCLE832 the cut asks for when it differs from the active one, on a line of its own
    ; before the move. Not while cutter compensation is on at the control: the cycle's blocks without
    ; motion count as empty blocks of TRC (MD20250 CUTCOM_MAXNUM_DUMMY_BLOCKS 5 here, alarm 10762
    ; above), so it waits for the move after G40. A G41/G42 still to come is selected after it.
    if iCycle832Want ne iCycle832Mode or nCycle832WantTol ne nCycle832Tol
        if iCompActive ne 41 and iCompActive ne 42
            skipline = true
            if iCycle832Want eq 0
                {nb,'CYCLE832(0,0,1)'}
            else
                {nb,'CYCLE832(',nCycle832WantTol:nCycle832Tol_f,',',iCycle832Want,',1)'}
            endif
            iCycle832Mode = iCycle832Want
            nCycle832Tol = nCycle832WantTol
            ; The next move programs G0/G1 again after the cycle call.
            iMotionmode = 9999
        endif
    endif
endp

@usr_smoothing_off
    ; Deselect CYCLE832 now (machining type 0): the control returns to the G groups of its reset
    ; state. The cut asks for none until the next usr_smoothing_set.
    iCycle832Want = 0
    nCycle832WantTol = 0
    skipline = true
    {nb,'CYCLE832(0,0,1)'}
    iCycle832Mode = 0
    nCycle832Tol = 0
    iMotionmode = 9999
endp

;--------------------

@start_of_job
    ; Start of an operation: work offset and job plane, a pending index, then the tool change
    ; (usr_ct) or, for the same tool, the job comment, the M1 (bOptstpjob) and a work-offset change.
    local numeric dummy_var
    call @usr_camdbg_start_of_job
    call @usr_link_boundary
    call @home_number
    ; Arcs in YZ/ZX leave iMplane at 19/18; restore the job's machining plane for its first motion block.
    call @usr_job_plane
    if bTmatrixIndexPending
        change(cWo) = true
        change(iWorkoffset) = true
        call @usr_4x_index
        bTmatrixIndexPending = false
    endif
    if rot_axis_coord eq 2
        ; The template zeroed X here (first move to X0) with no known reason; the owner chose a stop.
        dummy_var = 0
        input '"POST ERROR: rot_axis_coord 2 is not supported by this post."'dummy_var
        {nb,"POST ERROR: rot_axis_coord 2 is not supported by this post."}
        abort
    endif
    if bTlchg
        call @usr_ct
        bTlchg = false
    else
        ; Same tool: the job comment, the M1 (bOptstpjob) and, when the work offset changes (not with
        ; the VMID 3-axis limit bLimit_3axis), one G0 block with the new offset and A.
        bFirstRapid = true
        {nb, cOMb,job_name,cOMe}
        if bOptstpjob and !bBoundaryStop
            ; M1 between the two operations, after the message of the next one (shown during the
            ; stop), unless this boundary stopped already (M0 of bStopM00, M1 of an A index).
            call @usr_optionalstop
        endif
        if iPworkoffset ne iWorkoffset and !bLimit_3axis
            call @usr_tc_init_gmstates
            if iDiametercomp ne iCompActive
                ; Compensation left on by the last job is still active on the control: cancel it.
                change(iDiametercomp) = true
            endif
            ; bTlchg makes this rapid the positioning block (usr_rapid_tc_block, which clears it).
            bTlchg = true
            call @rapid_move
            ; X, Y and Z now count in the new offset: the next move programs them also when CAM's
            ; values equal the last job's (two fixtures, one program), else the tool would go down at
            ; the old fixture's X/Y.
            bTcReprogram = true
        endif
    endif
    call @usr_smoothing
    ; The job's Z approach is still to come: the first rapid that moves Z splits it from X/Y
    ; (usr_rapid_xy_then_z / usr_rapid_climb_then_xy) and clears bFirstMove; feed moves keep it.
    bFirstMove = true
endp

@end_of_job
    ; End of a job: back to G94, the M00 stop (bStopM00), the job's work offset and Z levels for the next.
    bBoundaryStop = false
    call @usr_feedmode_94
    call @usr_link_boundary
    if (iCompActive eq 41 or iCompActive eq 42) and iMplane eq 17 and bClimbZValid and nLastPathZ >= tool_start_plane
        ; Compensation is still on at the control (CAM switched it off after the retract, or not at
        ; all) and the tool stands at or above the clearance plane: deselect it here, before a stop,
        ; homing, index or tool change, so no G75 or M block runs with it on.
        call @usr_trc_cancel
    endif
    if bStopM00
        if tool_number eq next_job_tool_number
            call @usr_StopM00_sametool
        else
            call @usr_StopM00_difftool
        endif
    endif
    bStopM00difftool = false
    iPworkoffset = iWorkoffset
    nPtool_z_level = tool_z_level
    nPtool_start_plane = tool_start_plane
endp

;-------------------

@rapid_move
    ; SolidCAM event: rapid move. All rapids go through usr_rapid; a CYCLE832 that waited for G40
    ; comes first (usr_smoothing_apply).
    call @usr_smoothing_apply
    call @usr_rapid
endp

@usr_rapid
    ; Rapid positioning: G0, or G1 F<nRapidfeed> on '3-d model' jobs when bSyncdrapid is false.
    ; Machine order: homing where needed, A in a block of its own, then X/Y/Z. The rapid after a tool
    ; change or a work-offset change at job start (bTlchg) is one positioning block instead
    ; (usr_rapid_tc_block: work offset and A, plus Y with a vertical head; no X or Z).
    ; The homings run here and not in the helpers to keep the procedure nesting low. The deepest
    ; chains are 7 levels (start_of_job or end_of_job -> ... -> usr_rapid -> usr_rapid_xyz ->
    ; usr_rapid_trc_axes -> usr_job_plane), as deep as the original post went; the GPPL limit is not
    ; known, so usr_rapid_trc_axes, usr_rapid_climb_then_xy, usr_rapid_xy_then_z, usr_job_plane and
    ; usr_emulated_rapid_feed call nothing deeper.
    call @usr_rapid_cam_link
    call @usr_rapid_motion_mode
    if bR1useDir5a
        ; A 4x/5x event brings CAM's A: the CAM-side references follow it again (usr_r1pos_calc).
        bR1StepReset = false
    endif
    call @usr_r1pos_calc
    if bFirstRapid or bTlchg
        ; First rapid of a job or of a tool change: home if the head orientation changes (bHomerotv;
        ; usr_rapid_head_check still selects, so the head state and the Z format follow).
        call @usr_rapid_head_check
        if bHomerotv
            call @usr_prep_home_axis
        endif
        bFirstRapid = false
    endif
    ; The A output clears the change flag: remember whether this rapid turns A.
    bRapidRotaryChanged = change(nR1pos)
    if change(nR1pos) and !bCamLinkRapid
        ; Outside a CAM link CAM planned no clearance for the swing: home first (bHomeroth). The
        ; string becomes the index homing (sHomestrrot) also when this homing is switched off.
        sHomestrrot = sHomestrroth
        if bHomeroth
            sHomestr = sHomestrrot
            call @usr_prep_home_axis
        endif
    endif
    if bR1wrongWay and !(bPostHomed and bPostHomedZ)
        ; A turns another way than CAM and the tool does not stand at a Z homing (a CAM link, a rotation
        ; homing without Z or switched off): stop. After a Z homing the turn follows the word like an
        ; index.
        call @usr_r1_wrong_way_stop
    endif
    if bTlchg
        call @usr_rapid_tc_block
    else
        if change(nR1pos)
            ; A turns in its own block before X/Y/Z move, also when Z rises in the same event (known
            ; issue DESIGN-004). Known defect PP-023: as a feed-emulated rapid (G1) it has no F.
            {nb,'G'iMotionmode:mcode_f ' ',['G'iMplane' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' ']}
            call @usr_r1_output
        endif
        call @usr_rapid_xyz
    endif
    call @usr_rapid_done
endp

@usr_rapid_cam_link
    ; A rotation inside a CAM link needs no homing: a straight feed_link retract (usr_line sets
    ; bCamLinkRetract) authorizes the 4x/5x rapids of the same link that follow it. An index, a tool
    ; change, a job start or another work offset ends the link. Decided before any output.
    bCamLinkRapid = false
    if X5_job and bR1useDir5a and bJobPositioned and bCamLinkRetract
        if !bIndexClearancePending and !bTlchg and !bFirstRapid and nLastPathWorkoffset eq iWorkoffset
            if prev_command eq '@line_5x' or prev_command eq '@line_4x' or prev_command eq '@move_5x' or prev_command eq '@move_4x'
                bCamLinkRapid = true
            endif
        endif
    endif
    ; Used up here; usr_rapid_done renews it while the link goes on.
    bCamLinkRetract = false
endp

@usr_rapid_motion_mode
    ; G0, or G1 at the rapid feed (feed-emulated rapid); a G1 rapid leaves G93 first.
    ; One assignment per path: a 0-then-1 pair would flag G1 -> G1 as a change and repeat G1.
    if !bSyncdrapid and job_type eq '3-d model'
        iMotionmode = 1
        call @usr_feedmode_94
    else
        iMotionmode = 0
    endif
endp

@usr_rapid_head_check
    ; First rapid of a job or of a tool change: sets sHomestr to the head homing that usr_rapid runs
    ; next ('' = none). The head counts as vertical when the secondary rotation nR2pos is not 0
    ; (swivel-head template; on this A-axis machine only a CoordSys turned about Z or a CAM bpos gives
    ; one). Home on the first such rapid of the program and whenever the orientation changes.
    sHomestr = ''
    if abs(nR2pos) gt 0
        if !bVertical or bFirstVert
            call @usr_head_home_select
            bVertical = true
        endif
    else
        if bVertical or bFirstVert
            call @usr_head_home_select
            bVertical = false
        endif
    endif
endp

@usr_head_home_select
    ; Select the homing for a head orientation change: sHomestr = sHomestrrotv (also the rotation
    ; homing sHomestrrot from now on); the caller runs usr_prep_home_axis. Z switches to its
    ; 4-decimal format (PP-006).
    sHomestrrot = sHomestrrotv
    sHomestr = sHomestrrot
    zpos_f = '5.4'
    bFirstVert = false
endp

@usr_rapid_tc_block
    ; The rapid of a tool change (usr_ct_after) or of a work offset change at job start (start_of_job):
    ; G0 with the work offset and the A position. The first A word of a program is DC
    ; (bR1forceOutput). X/Y stay pending for the first move of the job; Z counts as the tool start plane.
    ; Known defect PP-023: as a feed-emulated rapid (G1) this block has no F.
    zpos = tool_start_plane
    {nb,'G'iMotionmode:mcode_f ' ',['G'iMplane' '],'G'iAbsincmode ' ',cWo,iWorkoffset' '}
    if bVertical
        {'Y'ypos ' '}
    endif
    if change(nR1pos) or bR1forceOutput
        call @usr_r1_output
    endif
    bTlchg = false
    bClimbZValid = false
    bFeedPrevValid = false
endp

@usr_rapid_xyz
    ; The X/Y/Z part of a rapid (not the tool-change block), with a pending cutter compensation
    ; change: one block, or a split into Z then X/Y (climb) or X/Y then Z.
    local logical bClimbFirst
    if bPostHomed or bTcReprogram
        ; The post homed the axes, or a tool change ran, after the last positioning move, so the CAM
        ; change flags no longer describe the machine position: program X, Y and Z explicitly.
        ; bPostHomed stays set until the end of this procedure: the climb test and the XY/Z split
        ; below read it.
        change(xpos) = true
        change(ypos) = true
        change(zpos) = true
    endif
    bTcReprogram = false
    if change(iDiametercomp)
        call @usr_rapid_trc_axes
    endif
    ; A rapid without axis motion prints only its pending modal words, in a block of their own: joined
    ; to the current line they would turn a G1 block into G0 ('G1 Z-1 F200 G0').
    ; Climb first, then traverse X/Y, when the rapid rises from a Z the post knows (same work offset,
    ; no homing since the last move): at the first move of a job (the job starts above the current Z),
    ; and when it deselects cutter compensation in G17 (deselecting while still low moves the tool
    ; toward the wall; climb with compensation on, then deselect at the new height).
    bClimbFirst = false
    if change(zpos) and bClimbZValid and !bPostHomed and nLastPathWorkoffset eq iWorkoffset and zpos gt nLastPathZ
        if bFirstMove
            bClimbFirst = true
        endif
        if change(iDiametercomp) and iDiametercomp eq 40 and iMplane eq 17
            bClimbFirst = true
        endif
    endif
    ; A first move without X/Y travel is a Z move: Z joins the modal words (G0/G1 restated after a
    ; CYCLE832 call), which would otherwise stand alone in the X/Y block.
    if bFirstMove and change(zpos) and !change(xpos) and !change(ypos)
        bClimbFirst = true
    endif
    if bClimbFirst
        call @usr_rapid_climb_then_xy
    else
        call @usr_rapid_xy_then_z
    endif
    ; Feed-emulated rapids: F is modal and printed once after a feed move. A split rapid printed it on
    ; its first block; otherwise it goes on the last block here.
    call @usr_emulated_rapid_feed
    ; The homed return is done.
    if bPostHomed
        bPostHomed = false
    endif
    bClimbZValid = true
    call @usr_feed_start_here
endp

@usr_rapid_trc_axes
    ; Sinumerik switches cutter compensation only in a G0/G1 block that programs an axis of the
    ; working plane: give the TRC block one at the current position when CAM sent none. In G18/G19 the
    ; Z word is one, unless it goes to its own block (first move of a job).
    if iDiametercomp ne 40
        ; TRC works in the job plane: a YZ/ZX arc earlier in the job must not leave another one.
        call @usr_job_plane
    endif
    if iMplane eq 17 and !change(xpos) and !change(ypos)
        change(xpos) = true
        change(ypos) = true
    endif
    if iMplane eq 18 and !change(xpos) and (!change(zpos) or bFirstMove)
        change(xpos) = true
    endif
    if iMplane eq 19 and !change(ypos) and (!change(zpos) or bFirstMove)
        change(ypos) = true
    endif
    iCompActive = iDiametercomp
endp

@usr_rapid_climb_then_xy
    ; Z in its own block first, then X/Y with the compensation change at the new height.
    {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],['G'iAbsincmode ' '],[cWo,iWorkoffset' '],'Z'zpos ' '}
    call @usr_emulated_rapid_feed
    if change(xpos) or change(ypos)
        skipline = true
        {nb,['G'iDiametercomp' '],['X'xpos ' '],['Y'ypos ' ']}
    endif
    bFirstMove = false
    skipline = true
endp

@usr_rapid_xy_then_z
    ; X/Y with the compensation change; Z joins the block, except at the first move of a job and on
    ; the return from a post homing: there Z goes in its own block after the XY traverse (DESIGN-002).
    {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],['G'iDiametercomp' '],['G'iAbsincmode ' '],[cWo,iWorkoffset' '],['X'xpos ' '],['Y'ypos ' ']}
    if change(zpos)
        if bFirstMove or bPostHomed
            if !bFirstMove
                ; The XY block of the homed return carries the rapid feed. Known defect PP-023: the
                ; XY block of a job's first move gets none.
                call @usr_emulated_rapid_feed
            endif
            skipline = true
            {nb,'Z'zpos ' ' }
            skipline = true
        else
            {'Z'zpos ' ' }
        endif
        bFirstMove = false
    endif
endp

@usr_rapid_done
    ; State for the next event.
    if !bSyncdrapid
        ; The next feed move reprograms F.
        bFeedoutput = true
    endif
    ; After an index boundary the first A turn goes without a CAM link; later turns may ride one.
    if bRapidRotaryChanged
        bIndexClearancePending = false
    endif
    ; CAM may split one link into several XYZ and rotary rapid blocks.
    ; Keep its confirmation until a feed move or an indexing boundary resets it.
    if bCamLinkRapid
        bCamLinkRetract = true
    endif
    bJobPositioned = true
    nLastPathZ = zpos
    nLastPathWorkoffset = iWorkoffset
    ; The work offset is programmed (or unchanged): no repeat on the next block.
    change(cWo) = false
    change(iWorkoffset) = false
    bStopSinceMotion = false
endp

@usr_emulated_rapid_feed
    ; F<nRapidfeed> for feed-emulated rapids (G1 on '3-d model' jobs when bSyncdrapid is false). F is
    ; optional: printed once after a feed move set change(nRapidfeed). A rapid that the post splits
    ; calls this after its first block, so the other block does not run at cutting feed.
    if !bSyncdrapid
        if job_type eq '3-d model'
            {['F'nRapidfeed' ']}
        endif
    endif
endp

@usr_feed_start_here
    ; The end point of this move is where the next G93 block starts (usr_inverse_feed).
    nFeedPrevX = xpos
    nFeedPrevY = ypos
    nFeedPrevZ = zpos
    nFeedPrevA = -nR1postemp * iR1dir
    nFeedPrevR1 = nR1pos
    bFeedPrevValid = true
endp

;-------------------

@line
    ; SolidCAM event: feed move. All feed moves go through usr_line, after the CYCLE832 of the cut
    ; (usr_smoothing_feed).
    call @usr_smoothing_feed
    call @usr_line
endp

@usr_line
    ; Feed move (G1). A block that turns A is posted in G93 (inverse time, usr_inverse_feed) when its
    ; start point is known (bFeedPrevValid; not right after a homing, a tool change or an index).
    local logical bInverseBlock
    local numeric dummy_var
    if bR1useDir5a
        ; A 4x/5x event brings CAM's A: the CAM-side references follow it again (usr_r1pos_calc).
        bR1StepReset = false
    endif
    ; Evaluate CAM input changes before output consumes their change flags.
    call @usr_line_cam_link
    nLastPathZ = zpos
    nLastPathWorkoffset = iWorkoffset
    bClimbZValid = true
    call @usr_r1pos_calc
    ; The CAM A axis is unlimited; on the modulo axis ACP/ACN turn less than one revolution per block,
    ; so a cutting block whose CAM step (nR1camstep) is 360 degrees or more loses whole turns.
    ; 359.9995 is 360 at the output step; down to 359.9985 when the printed positions hide the turn
    ; (bR1turnDropped).
    if feed_type ne 'feed_link' and (abs(nR1camstep) >= 359.9995 or (bR1turnDropped and abs(nR1camstep) >= 359.9985))
        dummy_var = 0
        input '"POST ERROR: One cutting block turns A by 360 degrees or more. Split the move in CAM."'dummy_var
        {nb,"POST ERROR: One cutting block turns A by 360 degrees or more. Split the move in CAM."}
        abort
    endif
    if bR1wrongWay
        call @usr_r1_wrong_way_stop
    endif
    ; Do not pre-apply upcoming compensation here (next_command): CAM emits @compensation before the
    ; move where it must become active; a look-ahead corrupts lead-out/zigzag side changes (2aa6df0).
    iMotionmode = 1
    ; A rotating G1 block is posted in G93 (inverse time): under G94 the control applies F to the
    ; linear axes only (deg/min for A alone), so the feed along the part would be wrong.
    bInverseBlock = false
    if i4xFeedMode eq 1 and change(nR1pos) and bFeedPrevValid
        call @usr_inverse_feed
        bInverseBlock = true
        iFeedMode = 93
    else
        if iFeedMode eq 93
            ; G94 joins this G1 block; usr_feedmode_94 handles the other moves.
            iFeedMode = 94
            change(feed) = true
        endif
    endif
    if bFeedoutput
        change(feed) = true
        bFeedoutput  = false
    endif
    if change(iDiametercomp)
        if iDiametercomp ne 40
            ; TRC works in the job plane: a YZ/ZX arc earlier in the job must not leave another one.
            call @usr_job_plane
        endif
        iCompActive = iDiametercomp
    endif
    if bPostHomed or bTcReprogram
        ; Also a feed move straight after a tool change without a homing: X/Y in rapid at the height
        ; M06 left the tool, then the feed in Z.
        call @usr_line_homed_return
        bTcReprogram = false
    endif
    {nb,['G'iMotionmode:mcode_f ' '],['G'iFeedMode' '],['G'iMplane' '],['G'iDiametercomp' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' ']}
    {['X'xpos ' '],['Y'ypos ' '],['Z'zpos ' ']}
    if change(nR1pos)
        call @usr_r1_output
    endif
    if bInverseBlock
        {'F'nInvFeed:nInvFeed_f ' '}
    else
        {['F'feed ' ']}
    endif
    change(nRapidfeed) = true
    bStopSinceMotion = false
    call @usr_feed_start_here
endp

@usr_line_cam_link
    ; A straight Z retract tagged feed_link by CAM (no X/Y/A/B motion, rising, same work offset)
    ; authorizes the rapids of the same link that follow it (usr_rapid_cam_link: no homing for their
    ; rotation). Any other feed move ends the authorization.
    bCamLinkRetract = false
    if X5_job and bR1useDir5a and bJobPositioned and !bIndexClearancePending and nLastPathWorkoffset eq iWorkoffset
        if feed_type eq 'feed_link' and zpos gt nLastPathZ
            if !change(xpos) and !change(ypos) and !change(apos) and !change(bpos)
                bCamLinkRetract = true
            endif
        endif
    endif
endp

@usr_line_homed_return
    ; A feed move directly after a post-inserted homing (or a tool change, bTcReprogram): return over
    ; the target at the current Z in rapid (carrying a TRC change, it has X and Y), then feed down in
    ; Z, instead of one diagonal feed move from the homing position.
    iMotionmode = 0
    {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],['G'iDiametercomp' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' '],'X'xpos ' ','Y'ypos ' '}
    iMotionmode = 1
    change(xpos) = false
    change(ypos) = false
    change(zpos) = true
    bPostHomed = false
endp

@usr_inverse_feed
    ; G93 feed for a G1 block that rotates A: nInvFeed = feed / path length on the part (1/min).
    ; The A axis lies along X with its centre at Y0 Z0. Machine points are rotated back by the CAM
    ; rotary angle into the part frame (part = Rx(-A) * machine: in this frame a recorded SolidCAM
    ; rotary link is a straight line), and the block is split into steps of at most 1 degree so the
    ; arc travelled by the cutting point is followed.
    local numeric stepno steps a0 da dm u xa ya za aa yp zp xq yq zq length nSegmentLengthSquared
    a0 = nFeedPrevA
    ; The rotation is the travel of the modulo axis as the control moves it (ACP positive, ACN negative,
    ; DC shortest), in the CAM angle sense. The CAM angle difference can be off by turns of 360 degrees.
    dm = nR1pos - nFeedPrevR1
    if abs(dm) < 0.0005
        ; Both are printed positions (steps of 0.001): only float noise is left here.
        dm = 0
    endif
    if iR1dirMode eq 2
        while dm < 0
            dm = dm + 360
        endw
        while dm >= 360
            dm = dm - 360
        endw
    endif
    if iR1dirMode eq 1
        while dm > 0
            dm = dm - 360
        endw
        while dm <= -360
            dm = dm + 360
        endw
    endif
    if iR1dirMode eq 3
        while dm > 180
            dm = dm - 360
        endw
        while dm <= -180
            dm = dm + 360
        endw
    endif
    da = -dm * iR1dir
    steps = 1
    while steps < abs(da) and steps < 360
        steps = steps + 1
    endw
    length = 0
    xq = nFeedPrevX
    yq = nFeedPrevY * cos(a0) + nFeedPrevZ * sin(a0)
    zq = -nFeedPrevY * sin(a0) + nFeedPrevZ * cos(a0)
    stepno = 1
    while stepno <= steps
        u = stepno / steps
        xa = nFeedPrevX + (xpos - nFeedPrevX) * u
        ya = nFeedPrevY + (ypos - nFeedPrevY) * u
        za = nFeedPrevZ + (zpos - nFeedPrevZ) * u
        aa = a0 + da * u
        yp = ya * cos(aa) + za * sin(aa)
        zp = -ya * sin(aa) + za * cos(aa)
        nSegmentLengthSquared = (xa - xq) * (xa - xq) + (yp - yq) * (yp - yq) + (zp - zq) * (zp - zq)
        call @usr_sqrt(nSegmentLengthSquared)
        length = length + nSqrt
        xq = xa
        yq = yp
        zq = zp
        stepno = stepno + 1
    endw
    if length * nMaxInverseFeed > feed
        nInvFeed = feed / length
    else
        nInvFeed = nMaxInverseFeed
    endif
endp

@usr_sqrt(numeric v)
    ; Square root by Newton iteration, result in nSqrt.
    local numeric i
    if v <= 0
        nSqrt = 0
    else
        nSqrt = v
        if nSqrt < 1
            nSqrt = 1
        endif
        i = 0
        while i < 40
            nSqrt = (nSqrt + v / nSqrt) / 2
            i = i + 1
        endw
    endif
endp

@usr_feedmode_94
    ; Leave G93 before a move that is not a rotating G1 (feed-emulated rapid, arc, drill cycle) and at
    ; the end of a job, so F is read as mm/min again. Sinumerik needs F reprogrammed after G93 -> G94:
    ; without it the next move runs at the last inverse-time value read as mm/min.
    if iFeedMode eq 93
        iFeedMode = 94
        change(iFeedMode) = false
        skipline = true
        {nb,'G94 F'feed}
        change(feed) = true
        bFeedoutput = true
    endif
endp

; -----------
@arc
    ; SolidCAM event: XY arc. All arcs go through usr_arc, after the CYCLE832 of the cut
    ; (usr_smoothing_feed).
    call @usr_camdbg_arc
    call @usr_smoothing_feed
    call @usr_arc
endp

@arc_yz
    ; SolidCAM event: YZ arc (usr_smoothing_feed, usr_arc).
    call @usr_camdbg_arc
    call @usr_smoothing_feed
    call @usr_arc
endp

@arc_zx
    ; SolidCAM event: ZX arc (usr_smoothing_feed, usr_arc).
    call @usr_camdbg_arc
    call @usr_smoothing_feed
    call @usr_arc
endp

@usr_arc_check(numeric dx, numeric dy, numeric dz)
    ; POST ERROR when the computed arc end point misses the CAM end point by more than 0.001 in an axis.
    local numeric dummy_var tolerance
    tolerance = 0.001

    if dx gt tolerance or dy gt tolerance or dz gt tolerance then
        dummy_var = 0
        input '"POST ERROR: ARC end mismatch."'dummy_var
        {nb,"POST ERROR: ARC end mismatch. tolerance=", tolerance, " dX=", dx, " dY=", dy, " dZ=", dz}
        abort
    endif
endp

@usr_arc_angle_check
    ; POST ERROR when the opening angle prints as AR=0 or exceeds a full circle: every arc is written
    ; with AR= (usr_arc), which takes 0 to 360 deg (PGsl 03/2013 9.6.4). 0.000005 is half the last
    ; digit of nArcAR_f '3.5' (tests/test_arc_compensation_plane.py pins the format). VMID
    ; MinArcAngle 0.002 keeps SolidCAM arcs above 0.
    local numeric dummy_var
    if arc_size < 0.000005 or arc_size > 360.000005
        dummy_var = 0
        input '"POST ERROR: ARC opening angle outside AR= (above 0, up to 360 deg)."'dummy_var
        {nb,"POST ERROR: ARC opening angle outside AR= (above 0, up to 360 deg). arc_size=", arc_size}
        abort
    endif
endp

@usr_arc_chord_check(numeric du, numeric dv)
    ; POST ERROR when an arc of up to 180 degrees ends too close to its start in the arc plane (du,
    ; dv): with the end point and AR= the control derives the centre from the chord (PGsl 03/2013
    ; 9.6.4), and an end point that rounds onto the start leaves it undefined. The control resolution
    ; is 0.00001 mm (INT_INCR_PER_MM 100000 in backups/NOLOG.ard); X and Y print with 5 decimals and
    ; round by up to 0.000005 mm, so a chord of 0.0001 mm (10 increments) cannot round onto the start.
    ; Z prints with 4 decimals (zpos_f '5.4' from the first homing, PP-006): in a YZ arc the end must
    ; also leave the start by 0.0001 mm in Y or 0.0002 mm in Z. VMID MinArcLength 0.0003 keeps
    ; SolidCAM arcs above both; usr_arc writes a longer arc in halves, whose chords are at least 1.4
    ; radii.
    local numeric dummy_var
    if arc_size <= 180.000005 and (du * du + dv * dv < 0.00000001 or (iMplane eq 19 and abs(du) < 0.0001 and abs(dv) < 0.0002))
        dummy_var = 0
        input '"POST ERROR: ARC chord too short: the control cannot place the centre (AR=)."'dummy_var
        {nb,"POST ERROR: ARC chord too short: the control cannot place the centre (AR=). dU=", du, " dV=", dv}
        abort
    endif
endp

@usr_arc_point
    ; End point of an arc block: both axes of the arc plane in every block, whatever their change
    ; flags (an AR= block without them ends on its start and leaves the centre undefined), and the
    ; axis normal to the plane when it is flagged or leaves its start (helix): usr_arc_math commits
    ; the end with an assignment that may clear the flag of an equal value. ZX arcs stop the post
    ; before (usr_arc_math).
    if arc_plane eq XY then
        if zpos ne zstart then
            change(zpos) = true
        endif
        {'X'xpos ' ','Y'ypos ' ',['Z'zpos ' ']}
    endif
    if arc_plane eq YZ then
        if xpos ne xstart then
            change(xpos) = true
        endif
        {['X'xpos ' '],'Y'ypos ' ','Z'zpos ' '}
    endif
endp

@usr_arc_math
    ; Arc geometry: G2/G3 (iMotionmode) and G17/G18/G19 (iMplane) from arc_direction and arc_plane,
    ; and the end point recomputed from the start point, the incremental centre (x/y/zcenter_rel) and
    ; arc_size in the arc plane; the axis normal to the plane keeps the CAD end value (helical arcs).
    ; usr_arc_check stops the post when the result misses the CAD end point by more than 0.001,
    ; usr_arc_angle_check when AR= cannot take the angle, usr_arc_chord_check when the end lies within
    ; 0.0001 mm of the start point. An arc above 180 degrees also gets the point halfway (nArcMidX/Y/Z),
    ; where usr_arc ends its first half.
    local numeric cx, cy, cz
    local numeric vx, vy, vz
    local numeric rx, ry, rz
    local numeric angle_deg
    local numeric c, s
    local numeric calculated_xpos, calculated_ypos, calculated_zpos
    local numeric dx, dy, dz
    local numeric du, dv
    local numeric dummy_var

    ; --- motion mode ---
    if arc_direction eq CCW then
        iMotionmode = 3
    else
        iMotionmode = 2
    endif

    ; --- plane ---
    if arc_plane eq XY
        iMplane = 17
    endif
    if arc_plane eq ZX
        iMplane = 18
    endif
    if arc_plane eq YZ
        iMplane = 19
    endif

    ; --- ZX plane: direction convention not verified ---
    ; Sinumerik G18 G3 turns Z->X (viewed from +Y), while the end-point math below turns X->Z for CCW.
    ; Depending on SolidCAM's arc_direction convention for ZX this either aborts on the end-point check
    ; or posts the complementary arc. Stop until the convention is verified (e.g. one ZX arc in Vericut).
    if iMplane eq 18 then
        dummy_var = 0
        input '"POST ERROR: ZX arc direction is unverified in this post. Check usr_arc_math."'dummy_var
        {nb,"POST ERROR: ZX arc direction is unverified in this post. Check usr_arc_math."}
        abort
    endif

    ; --- absolute center ---
    cx = xstart + xcenter_rel
    cy = ystart + ycenter_rel
    cz = zstart + zcenter_rel

    ; --- vector from center to start ---
    vx = xstart - cx
    vy = ystart - cy
    vz = zstart - cz

    ; --- signed angle (degrees) ---
    angle_deg = arc_size
    if arc_direction eq CW then
        angle_deg = -angle_deg
    endif

    c = cos(angle_deg)
    s = sin(angle_deg)

    ; --- XY plane: keep Z from CAD end ---
    if iMplane eq 17 then
        rx = vx * c - vy * s
        ry = vx * s + vy * c

        calculated_xpos = cx + rx
        calculated_ypos = cy + ry
        calculated_zpos = zpos
    endif

    ; --- ZX plane: keep Y from CAD end (not reached while the stop above is in place) ---
    if iMplane eq 18 then
        rx = vx * c - vz * s
        rz = vx * s + vz * c

        calculated_xpos = cx + rx
        calculated_ypos = ypos
        calculated_zpos = cz + rz
    endif

    ; --- YZ plane: keep X from CAD end ---
    if iMplane eq 19 then
        ry = vy * c - vz * s
        rz = vy * s + vz * c

        calculated_xpos = xpos
        calculated_ypos = cy + ry
        calculated_zpos = cz + rz
    endif
    dx = abs(calculated_xpos - xpos)
    dy = abs(calculated_ypos - ypos)
    dz = abs(calculated_zpos - zpos)
    call @usr_arc_check(dx, dy, dz)
    call @usr_arc_angle_check
    ; --- chord in the arc plane ---
    du = calculated_xpos - xstart
    dv = calculated_ypos - ystart
    if iMplane eq 19 then
        du = calculated_ypos - ystart
        dv = calculated_zpos - zstart
    endif
    call @usr_arc_chord_check(du, dv)

    ; --- point halfway for an arc above 180 degrees (AR= above 180 with nArcAR_f); the normal axis
    ; moves linearly (helix) ---
    if arc_size > 180.000005 then
        c = cos(angle_deg / 2)
        s = sin(angle_deg / 2)
        if iMplane eq 17 then
            nArcMidX = cx + vx * c - vy * s
            nArcMidY = cy + vx * s + vy * c
            nArcMidZ = (zstart + calculated_zpos) / 2
        endif
        if iMplane eq 19 then
            nArcMidX = (xstart + calculated_xpos) / 2
            nArcMidY = cy + vy * c - vz * s
            nArcMidZ = cz + vy * s + vz * c
        endif
    endif
    ; --- commit end point ---
    xpos = calculated_xpos
    ypos = calculated_ypos
    zpos = calculated_zpos
endp

@usr_arc
    ; G2/G3 block with the end point and the opening angle AR= (PGsl 03/2013 9.6.4 'G2/G3 X... Y...
    ; Z... AR='): start (the current position), end, angle and direction describe one arc, and the
    ; control derives the centre. The end point with the centre (I/J/K) describes the circle twice
    ; and rounding never makes the two radii equal: 'G1 X8.1412 Y-30.' 'G3 X8.0394 Y-30.0017 I0.0002
    ; J-3.04' (quoted in dc916d7), a 1.9 deg arc with radii 0.000012 mm apart, ran as a huge arc on
    ; this 828D while the simulator accepted it (owner). The centre with AR= ('G2/G3 I... J... AR=')
    ; would leave the end point to the control: AR= rounds to 0.00001 deg, which moves it by up to
    ; 0.00016 mm at radius 1800, and the next arc's centre is relative to it, so the error adds up
    ; over a run of arcs (runs of 33 in the reference trace). The end point keeps every block
    ; absolute. Above 180 degrees the centre from the chord turns ill-conditioned (an end moved
    ; 0.000005 mm along the chord changes the radius of a 359.99 deg arc of radius 10 by 0.03 mm),
    ; and AR= has no full circle (9.6.4), so such an arc is written in two halves.
    local numeric dummy_var nArcAR nArcEndX nArcEndY nArcEndZ
    if change(iDiametercomp)
        if iDiametercomp eq iCompActive
            ; Switched back before any move: the control state does not change.
            change(iDiametercomp) = false
        else
            ; Sinumerik selects/deselects cutter compensation only in G0/G1 blocks; G41/G42/G40 on G2/G3 alarms.
            dummy_var = 0
            input '"POST ERROR: Cutter compensation change on an arc. Use a linear lead-in/lead-out."'dummy_var
            {nb,"POST ERROR: Cutter compensation change on an arc. Use a linear lead-in/lead-out."}
            abort
        endif
    endif
    call @usr_feedmode_94
    call @usr_arc_math
    ; A completed arc starts a new link context at its actual endpoint.
    bCamLinkRetract = false
    nLastPathZ = zpos
    nLastPathWorkoffset = iWorkoffset
    bClimbZValid = true
    if bFeedoutput
        change(feed) = true
        bFeedoutput  = false
    endif
    {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],['G'iDiametercomp' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' ']}
    if arc_size > 180.000005 then
        ; First half to the point halfway, then the second half from there to the end.
        nArcAR = arc_size / 2
        nArcEndX = xpos
        nArcEndY = ypos
        nArcEndZ = zpos
        xpos = nArcMidX
        ypos = nArcMidY
        zpos = nArcMidZ
        call @usr_arc_point
        {'AR='nArcAR:nArcAR_f ' ',['F'feed ' ']}
        xpos = nArcEndX
        ypos = nArcEndY
        zpos = nArcEndZ
        {nb}
        call @usr_arc_point
        {'AR='nArcAR:nArcAR_f ' '}
    else
        call @usr_arc_point
        {'AR='arc_size:nArcAR_f ' ',['F'feed ' ']}
    endif
    change(nRapidfeed) = true
    bStopSinceMotion = false
    ; The next G93 block starts here; A does not turn on an arc, so its A reference stays.
    nFeedPrevX = xpos
    nFeedPrevY = ypos
    nFeedPrevZ = zpos
endp

;-------------------

@compensation
    ; SolidCAM event: cutter compensation side (iDiametercomp); the next G0/G1 block prints G40/G41/G42.
    if side eq COMP_LEFT then
        iDiametercomp = 41
    endif
    if side eq COMP_RIGHT then
        iDiametercomp = 42
    endif
    if side eq COMP_OFF then
        iDiametercomp = 40
    endif
endp

;-------------------

@usr_optionalstop
    ; M1 optional stop.
    {nb, 'M1 '}
    bBoundaryStop = true
    bStopSinceMotion = true
endp

@usr_forcedstop
    ; M0 program stop.
    {nb, 'M0 '}
    bBoundaryStop = true
    bStopSinceMotion = true
endp

@usr_stop_m00
    ; The M0 stop of a job boundary (VMID bStopM00): coolant and spindle off, the homing the caller
    ; put in sHomestr, M0, then the stop message.
    if bCoolExist
        call @usr_coolant_prep_all_off
        call @usr_coolant_output
    endif
    call @usr_spindle_stop
    call @usr_prep_home_axis
    call @usr_forcedstop
    call @usr_message
endp

@usr_StopM00_sametool
    ; M0 between two operations of the same tool: the stop, then the spindle back on and the XY
    ; return. The coolant stays off (PP-024).
    local logical bHomedBeforeReturn
    local numeric nZBeforeReturn
    sHomestr = sHomestrstpsame
    call @usr_stop_m00
    {nb}
    call @usr_abs_inc_output
    ; One WAITS after the M3/M4 of the restart, also when the S word is printed again before it.
    last_spin = spin
    call @m_feed_spin
    call @usr_spindle_mcode_output
    call @usr_spindle_wait
    change(xpos) = true
    change(ypos) = true
    change(zpos) = false
    ; This return is XY only, at the homed Z: a pending post homing stays pending, so the next move
    ; still programs Z.
    bHomedBeforeReturn = bPostHomed
    nZBeforeReturn = nLastPathZ
    bPostHomed = false
    call @rapid_move
    bPostHomed = bHomedBeforeReturn
    ; The return programs no Z: the tool stays at its Z (RTP after a drill cycle, or the homed top).
    nLastPathZ = nZBeforeReturn
    nFeedPrevZ = nZBeforeReturn
    if bPostHomed
        bClimbZValid = false
        bFeedPrevValid = false
    endif
endp

@usr_StopM00_difftool
    ; M0 before a tool change.
    sHomestr = sHomestrstpdiff
    call @usr_stop_m00
    bStopM00difftool = true
endp

;-------------------

@change_ref_point
    ; SolidCAM reference point change (a G10 offset write): not supported.
    call @usr_unsupported_event
endp

;-------------------

@rotate
    ; With SoftwareTransform="0" SolidCAM may leave the transformation to the post (PP-047); not supported.
    call @usr_unsupported_transform
endp

;-------------------

@mirror
    ; With SoftwareTransform="0" SolidCAM may leave the transformation to the post (PP-047); not supported.
    call @usr_unsupported_transform
endp

;-------------------

@fourth_axis
    ; SolidCAM 4x index (angle; it reaches A through nR1postransform, so apos = 0). position counts
    ; the index steps (index mode 1 steps the work offset by position-1). The index ends a CAM link.
    bIndexClearancePending = true
    bCamLinkRetract = false
    if angle eq 0
        position = 1
    else
        position = position + 1
    endif
    ; The post zeroes the CAM A, CAM does not: keep the CAM-side references (usr_r1pos_calc).
    bR1StepReset = true
    apos = 0
    call @usr_4x_index
endp
;-------------------

@message
    ; SolidCAM @message texts are not printed (the stop message goes through usr_message).
endp

@usr_message
    ; The stop message (VMID sStopMessage) as a comment; SolidCAM @message texts are not printed.
    if sStopMessage ne ''
        {nb, cCb,sStopMessage,cCe}
    endif
endp

;-------------------

@drill
    ; Sinumerik drilling cycle MCALL CYCLE8x(RTP, RFP, SDIS, DP, DPR, ...), modal on the following
    ; drill_point blocks until @end_drill. RTP = clearance Z, DP = hole bottom. Hole top above Z0:
    ; RFP = top - safety, SDIS = safety, DPR empty; otherwise RFP = top, SDIS empty and DPR 0.
    local numeric rtp rfp sdis dp
    rtp = drill_clearance_z
    rfp = (drill_upper_z - safety)
    sdis = safety
    dp = drill_lower_z

    ; Drilling cycles run in the reset settings of the control (usr_smoothing): the job asks for
    ; none from here, also when its CYCLE832 still waits for G40.
    call @usr_smoothing_set(0)
    if iCycle832Mode ne 0
        call @usr_smoothing_off
    endif
    call @rapid_move
    if drill_type eq G81 then
        gcode = 81
    endif
    if drill_type eq G82 then
        gcode = 82
    endif
    if drill_type eq G83 then
        gcode = 83
    endif
    if drill_type eq G84 then
        gcode = 84
    endif
    if drill_type eq G86 then
        gcode = 86
    endif
    call @usr_feedmode_94
    {nb,' F'feed }
    {nb,'MCALL CYCLE',gcode}
    if drill_upper_z > 0
        {' (',rtp,','rfp,','sdis,',',dp,','}
    else
        {' (',rtp,','drill_upper_z,',,',dp,',','0.'}
    endif
    ; The parameters after DPR. CYCLE81(RTP,RFP,SDIS,DP,DPR) has none.
    if drill_type eq G82 then
        ; CYCLE82(RTP,RFP,SDIS,DP,DPR,DTB): DTB = dwell at the bottom.
        {','delay}
    endif
    if drill_type eq G83 then
        ; CYCLE83(RTP,RFP,SDIS,DP,DPR,FDEP,FDPR,DAM,DTB,DTS,FRF,VARI): FDEP empty, FDPR and DAM = down_step,
        ; DTB empty/0, DTS 0.5 sec, FRF 1, VARI 1 (swarf removal). DTS = dwell at the start point during
        ; swarf removal.
        {',,',down_step,','down_step,',,0.5,1,1'}
    endif
    if drill_type eq G84 then
        ; CYCLE84(RTP,RFP,SDIS,DP,DPR,DTB,SDAC,MPIT,PIT,POSS,SST,SST1,AXN,PTAB,TECHNO,VARI,DAM,VRT): DTB 0.
        ; The sign of PIT selects the thread hand and SDAC the spindle direction after the cycle:
        ; right-hand (CW) +FEED/SPIN and 3, left-hand (CCW) -FEED/SPIN and 4. POSS 0, SST = SPIN,
        ; SST1 = 2 x SPIN (retract), AXN and PTAB empty, TECHNO 1221; with Step_Down: VARI 1 (chip
        ; breaking), DAM = Step_Down, VRT = VarRetract (Step_Down when 0).
        if tool_direction eq CW then
            {',0.,3,,',(FEED/SPIN)}
        else
            {',0.,4,,',((0-FEED)/SPIN)}
        endif
        {',0,',SPIN:INTEGER_DEF_F,','(SPIN*2):INTEGER_DEF_F,',,,1221'}
        if Step_Down ne 0
            if VarRetract ne 0
                {',1,'Step_Down:feed_f ',' VarRetract:feed_f}
            else
                {',1,'Step_Down:feed_f ',' Step_Down:feed_f}
            endif
        endif
    endif
    if drill_type eq G86 then
        ; CYCLE86(RTP,RFP,SDIS,DP,DPR,DTB,SDIR,RPA,RPO,RPAP,POSS): DTB empty, SDIR 3 (spindle M3).
        {',,3'}
    endif
    {')'}
    ; The cycle retracts to RTP after every hole: that is the Z the next move starts from.
    nLastPathZ = rtp
    bStopSinceMotion = false
endp

;-------------------

@drill_point
    ; Next hole of the modal cycle: the positioning block runs it. Its X/Y are the last programmed
    ; position (usr_trc_cancel, the G93 start point).
    {nb,['X'xpos ' '], ['Y'ypos ' '], ['Z'zpos ' ']}
    nFeedPrevX = xpos
    nFeedPrevY = ypos
    bStopSinceMotion = false
endp

;-------------------

@end_drill
    ; Cancel the modal cycle (bare MCALL); G94 back after tapping.
    {nb, 'MCALL '}
    if drill_type eq G84
        {nb, 'G94'}
    endif
endp

;-------------------

@m_feed_spin
    ; Spindle speed change within a job. When the running spindle (last_spin set) gets a new speed and
    ; a WAITS follows (usr_spindle_wait), the block restates M3/M4 with the new S: WAITS waits for the
    ; setpoint speed after M3/M4 (PGsl 03/2013 7.4); the signal is "spindle in setpoint range" (FB1 S1,
    ; tolerance MD35150). Not for a tapping job (CYCLE84 runs the spindle, start_tool) and not for the
    ; S that SolidCAM flags again at a job start with the same value.
    call @usr_spindle_dir
    if change(spin)
        if bSpinWait and last_spin ne 0 and spin ne last_spin and d_drill_type ne D_Tapping and iCompActive ne 41 and iCompActive ne 42
            skipline = true
            {nb, 'M'iSpindleDir:mcode_f ' '}
            skipline = false
        endif
        call @usr_spindle_output
    endif
endp

@start_tool
    ; Spindle start (M3/M4 and S). Tapping prints only an empty block: CYCLE84 runs the spindle (SST).
    call @usr_spindle_dir
    if d_drill_type ne D_Tapping
        call @usr_spindle_mcode_output
        call @usr_spindle_output
    else
        {nb ' '}
    endif
endp

@usr_spindle_dir
    ; iSpindleDir: M3 for a CW tool, M4 otherwise.
    if tool_direction eq CW then
        iSpindleDir = 3
    else
        iSpindleDir = 4
    endif
endp

@usr_spindle_output
    ; S word, then WAITS (usr_spindle_wait) when the speed changes, also from standstill after M5.
    {nb,'S'spin:integer_def_f ' '}
    if spin ne last_spin
        call @usr_spindle_wait
    endif
    last_spin = spin
endp

@usr_spindle_wait
    ; WAITS on a block of its own (bSpinWait; PGsl 03/2013 7.4: "Programming in a separate NC block"):
    ; after M3/M4 the program goes on when the spindle reaches its setpoint speed, after M5 when it
    ; stands still (FB1 S1: "spindle in setpoint range", tolerance MD35150; "spindle stationary"),
    ; instead of a G04 dwell timed by the post. Feed blocks wait for the speed anyway (MD35500 = 2:
    ; the path stops before the first machining block); WAITS also holds G0, the cycles and the tool
    ; change. The trailing new block keeps later words off the WAITS line. None while cutter
    ; compensation is on at the control: blocks without motion in the plane count toward MD20250
    ; CUTCOM_MAXNUM_DUMMY_BLOCKS (5 here, alarm 10762 above), e.g. at an M0 between two operations of
    ; the same tool that CAM leaves with G41 on; the next feed block still waits for the speed.
    if bSpinWait and iCompActive ne 41 and iCompActive ne 42
        skipline = true
        {nb, 'WAITS'}
        {nb}
    endif
endp

@usr_spindle_stop
    ; M5 in its own block, then WAITS until the spindle stands still (usr_spindle_wait).
    iSpindleDir = 5
    {nb}
    call @usr_spindle_mcode_output
    call @usr_spindle_wait
endp

@usr_spindle_mcode_output
    ; M3/M4/M5. After a stop the next S counts as a start from 0 rpm (WAITS in usr_spindle_output).
    if iSpindleDir ne 3 and iSpindleDir ne 4
        last_spin = 0
    endif
    {'M'iSpindleDir:mcode_f ' '}
endp

;-------------------

@offset_change
    ; SolidCAM offset change event: not needed, D is always D1 (usr_ct_toolchange).
endp

;-------------------

@job_plane
    ; Not used: the machining plane comes from @machine_plane.
endp

;-------------------

@call_proc
    ; SolidCAM subprogram call (VMID GenProc=0): not supported.
    call @usr_unsupported_event
endp

;-------------------

@proc
    ; Start of a SolidCAM subprogram: not supported (see @call_proc).
    call @usr_unsupported_event
endp

;-------------------

@end_proc
    ; End of a SolidCAM subprogram: not supported (see @call_proc).
    call @usr_unsupported_event
endp

;----------------

@loop_matrix_info
    ; SolidCAM information event: not needed.
endp

@loop
    ; SolidCAM loop (VMID LoopExist=0; the template wrote a Fanuc WHILE macro): not supported.
    call @usr_unsupported_event
endp

@end_loop
    ; End of a SolidCAM loop: not supported (see @loop).
    call @usr_unsupported_event
endp

;-------------------

@usr_prep_home_axis
    ; Home with the homing string sHomestr ('' = no homing): entries 'mode:prefix:line' separated by
    ; ';', e.g. '8::G75 Z1=0. ;8::G75 Y1=0 X1=0'. usr_home_axis outputs each entry in string order.
    local integer iPos
    local numeric dummy_var
    local string sRest sEntry
    sRest = sHomestr
    while sRest ne ''
        iPos = instr(sRest, ';')
        if iPos eq 0
            sEntry = sRest
            sRest = ''
        else
            sEntry = left(sRest, iPos - 1)
            sRest = substr(sRest, iPos + 1, strlen(sRest))
        endif
        iHomingmode = 0
        iPos = instr(sEntry, ':')
        if iPos ne 0
            iHomingmode = tonum(left(sEntry, iPos - 1))
            sEntry = substr(sEntry, iPos + 1, strlen(sEntry))
        endif
        cHomep = ''
        iPos = instr(sEntry, ':')
        if iPos ne 0
            cHomep = left(sEntry, iPos - 1)
            sEntry = substr(sEntry, iPos + 1, strlen(sEntry))
        endif
        sHomeline = sEntry
        if (iCompActive eq 41 or iCompActive eq 42) and instr(sHomeline,'Z') > 0 and (instr(sHomeline,'X') > 0 or instr(sHomeline,'Y') > 0)
            ; Compensation still on and no Z-only homing to deselect it after: G40 here would run low
            ; near the part, after the line it would undo the XY homing.
            dummy_var = 0
            input '"POST ERROR: Cutter compensation is still on at a homing line that moves Z with X/Y. Home Z alone first."'dummy_var
            {nb,"POST ERROR: Cutter compensation is still on at a homing line that moves Z with X/Y. Home Z alone first."}
            abort
        endif
        call @usr_home_axis
        if (iCompActive eq 41 or iCompActive eq 42) and instr(sHomeline,'Z') > 0
            ; Compensation is still on at the control: no linear block deselected it before this
            ; homing. Deselect it now, with Z at the homing height, before the XY homing.
            call @usr_trc_cancel
        endif
    endw
endp

@usr_trc_cancel
    ; G40 for compensation still on at the control, in a G0 block with the last programmed X and Y:
    ; Sinumerik deselects it only in a G0/G1 block with an axis of the working plane (X and Y cover
    ; G17, G18 and G19). The deselection move (one tool radius) runs at the current height. CAM
    ; compensation still requested is selected again on the next linear block.
    {nb,'G0 G40 X'nFeedPrevX:xpos_f ' ','Y'nFeedPrevY:ypos_f ' '}
    ; The control is in G0 now: the caller's next motion block prints its G code again.
    change(iMotionmode) = true
    bStopSinceMotion = false
    iCompActive = 40
    if iDiametercomp eq 40
        change(iDiametercomp) = false
    else
        change(iDiametercomp) = true
    endif
endp

@usr_home_axis
    ; Output one homing line (cHomep + sHomeline, e.g. 'G75 Z1=0.'), then mark the axes as homed.
    local numeric dummy_var
    if iHomingmode ne 8
        dummy_var = 0
        input '"POST ERROR: Homing string entries must start with 8: (the line as given), e.g. 8::G75 Z1=0."'dummy_var
        {nb,"POST ERROR: Homing string entries must start with 8: (the line as given), e.g. 8::G75 Z1=0."}
        abort
    endif
    {nb,cHomep,sHomeline}
    ; The axes now stand at the homing position: the next positioning move must reprogram X, Y and Z
    ; even when the CAM values did not change.
    if !bPostHomed
        bPostHomedZ = false
    endif
    if instr(sHomeline, 'Z') > 0
        bPostHomedZ = true
    endif
    bPostHomed = true
    bClimbZValid = false
    bFeedPrevValid = false
    bStopSinceMotion = false
endp

;-------------------

@usr_r1pos_calc
    ; A position (nR1pos) of the current CAM state: the CAM angle nR1postemp (tmatrix + 4x transform +
    ; C-axis cutting + 4/5x apos, in the machine direction iR1dir) wrapped into 0 <= A < 360. Also sets
    ; change(nR1pos) (A moves), iR1dirMode (the A word's ACN/ACP/DC) and the CAM step nR1camstep.
    local numeric dummy_var
    call @usr_r1_cam_angle
    call @usr_r1_range
    iR1dirMode = 0
    ; Second rotary axis of the swivel-head template; this machine has none, only a CoordSys turned
    ; about Z or a CAM bpos makes nR2pos non-zero (usr_rapid_head_check).
    nR2postmatrix = (-x_angle_const_z) * iR2dir                        ;Rotary from CoordSys (tmatrix)
    nR2pos5x = (-bpos) * iR2dir                                       ;Rotary from 4/5x simultaneous
    nR2pos = nR2postmatrix + nR2pos5x
    ; A moves when its position changes; a 3-axis job (bLimit_3axis) never turns A.
    if nPR1pos ne nR1pos
        change(nR1pos) = TRUE
    else
        change(nR1pos) = false
    endif
    if bLimit_3axis
        change(nR1pos) = false
    endif
    ; Direction word: DC for a forced A word (program start: the A position is unknown), else the
    ; CAM direction. nR1pos and nPR1pos are printed positions (usr_r1_range), so a CAM change below
    ; the output step prints no A word.
    if bR1forceOutput
        iR1dirMode = 3
    else
        if change(nR1pos)
            call @usr_r1_select_dir
        endif
    endif
    ; The step since the last A position, and CAM's step nR1camstep that the control's turn must match
    ; (usr_r1_check_travel; usr_line, usr_rapid stop on a mismatch). For a 4x/5x event it is CAM's own
    ; cpos/apos change from their last CAM values. Owner rule 2026-10-28: after the post's own A reset
    ; (tool change, @fourth_axis, work offset change: bR1StepReset) the control starts from the
    ; post's A, not CAM's, so a move whose turn differs from CAM's own step stops (no extra turn in a
    ; cut). The reset keeps the references until a 4x/5x event (usr_line, usr_rapid); usr_ct_target
    ; sets the cpos one to cnext.
    nR1posstep = nR1postemp - nPR1postemp
    nR1camstep = nR1posstep
    if bR1useDir5a
        nR1camstep = nR1poscpos - nPR1camcpos + nR1pos5x - nPR1camapos
    endif
    if !bR1StepReset
        nPR1camcpos = nR1poscpos
        nPR1camapos = nR1pos5x
    endif
    if bLimit_3axis and abs(nR1posstep) >= 0.0005
        ; A 3-axis machine (VMID bLimit_3axis) cannot follow CAM's A: stop instead of dropping it.
        dummy_var = 0
        input '"POST ERROR: bLimit_3axis is set (3-axis machine) but this job turns A."'dummy_var
        {nb,"POST ERROR: bLimit_3axis is set (3-axis machine) but this job turns A."}
        abort
    endif
    call @usr_r1_check_travel
    ; The references for the next move.
    nPR1postemp = nR1postemp
    nPR1pos = nR1pos
endp

@usr_r1_cam_angle
    ; The unwrapped CAM angle of A in the machine direction (nR1postemp). The difference of two
    ; successive values is the step of a move (nR1posstep in usr_r1pos_calc).
    nR1postmatrix = (-angle_4x_around_x) * iR1dir                       ;Rotary from CoordSys (tmatrix)
    nR1postransform = (-angle) * iR1dir                                 ;Rotary from 4x-Transform
    nR1poscpos = (-cpos) * iR1dir                                       ;Rotary from C-axis cutting
    nR1pos5x = (-apos) * iR1dir                                         ;Rotary from 4/5x simultaneous
    nR1postemp = nR1postmatrix + nR1postransform + nR1poscpos + nR1pos5x
endp

@usr_r1_range
    ; nR1pos: the CAM angle nR1postemp in the position range 0 <= A < 360 of the modulo A axis
    ; (whole turns added or removed), rounded to the output step 0.001 (nR1pos_f '7.3'): the position
    ; the A word prints and the control receives.
    local numeric nShift nTarget nSteps nWeight
    nShift = 0
    nR1pos = nR1postemp
    while nR1pos < 0
        nShift = nShift + 360
        nR1pos = nR1postemp + nShift
    endw
    while nR1pos >= 360
        nShift = nShift - 360
        nR1pos = nR1postemp + nShift
    endw
    ; 360.000 and -0.000 with nR1pos_f '7.3' (sums of angles carry float noise) are the position 0.
    if nR1pos >= 359.9995 or nR1pos < 0.0005
        nR1pos = 0
    endif
    ; GPPL has no round(): count the 0.001 steps with powers of two (2^18 + ... + 1 > 360000).
    nTarget = nR1pos * 1000 + 0.5
    nSteps = 0
    nWeight = 262144
    while nWeight >= 1
        if nSteps + nWeight <= nTarget
            nSteps = nSteps + nWeight
        endif
        nWeight = nWeight / 2
    endw
    nR1pos = nSteps / 1000
endp

@usr_r1_check_travel
    ; How the control turns A for this move, against CAM's turn nR1camstep. nR1travel: the A word's
    ; turn from the printed previous position to the printed new one (ACP positive, ACN negative; 0
    ; without an A word). CAM may turn whole turns more in the same direction: the control drops
    ; them (bR1turnDropped; usr_line stops a cutting block). Any other difference is bR1wrongWay: the
    ; control would turn A another way than CAM. Tolerance: the rounding of the two positions.
    ; Not checked: a DC word (program start, the control's A is unknown), 3-axis jobs (no A words)
    ; and a missing direction (usr_r1_output stops).
    local numeric camstep
    bR1wrongWay = false
    bR1turnDropped = false
    nR1from = nPR1pos
    nR1travel = 0
    if change(nR1pos)
        nR1travel = nR1pos - nPR1pos
        if iR1dirMode eq 1
            while nR1travel > 0
                nR1travel = nR1travel - 360
            endw
        endif
        if iR1dirMode eq 2
            while nR1travel < 0
                nR1travel = nR1travel + 360
            endw
        endif
    endif
    if !bLimit_3axis and iR1dirMode ne 3 and (iR1dirMode ne 0 or !change(nR1pos))
        camstep = nR1camstep
        while abs(nR1travel - camstep) > 0.0015 and abs(camstep) >= 359.9985
            if camstep > 0
                camstep = camstep - 360
            else
                camstep = camstep + 360
            endif
            bR1turnDropped = true
        endw
        if abs(nR1travel - camstep) > 0.0015
            bR1wrongWay = true
        endif
    endif
endp

@usr_r1_wrong_way_stop
    ; ACP/ACN would turn A another way than CAM (usr_r1_check_travel): stop instead of cutting or
    ; swinging through angles CAM did not check.
    local numeric dummy_var
    dummy_var = 0
    input '"POST ERROR: A would turn another way than in CAM (ACP/ACN). Check the A angles of this move."'dummy_var
    {nb,"POST ERROR: A would turn another way than in CAM (ACP/ACN): A", nR1from, " to A", nR1pos, ", CAM ", nR1camstep, " deg, control ", nR1travel, " deg."}
    abort
endp

@usr_r1_select_dir
    ; ACN (1) or ACP (2) from the CAM rotation direction: dir5a for 4x/5x moves (bR1useDir5a), else the
    ; 4x transform direction. Any other value leaves iR1dirMode as it is.
    if bR1useDir5a
        if dir5a eq cw
            iR1dirMode = 1
        else
            if dir5a eq ccw
                iR1dirMode = 2
            endif
        endif
    else
        if angle_4x_around_x_dir eq cw
            iR1dirMode = 1
        else
            if angle_4x_around_x_dir eq ccw
                iR1dirMode = 2
            endif
        endif
    endif
endp

@usr_r1_output
    ; The A word of a block, as usr_r1pos_calc chose it: A=ACN(..) / A=ACP(..) turn the modulo axis in a
    ; given direction (iR1dirMode 1 / 2), A=DC(..) the shortest way (3). The only place an A word is
    ; printed. Callers and their condition:
    ;   usr_rapid A block: change(nR1pos); usr_rapid_tc_block: change(nR1pos) or bR1forceOutput;
    ;   usr_line: change(nR1pos); usr_4x_index_rotate: change(nR1pos) tested in usr_4x_index.
    ; No 'last printed A' is kept: usr_r1pos_calc updates nPR1pos on every call, printed or not; it
    ; changes only with the printed value (both are rounded to the output step).
    local numeric dummy_var
    if iR1dirMode ne 1 and iR1dirMode ne 2 and iR1dirMode ne 3
        dummy_var = 0
        input '"POST ERROR: A-axis output direction mode is not ACP/ACN/DC."'dummy_var
        {nb,"POST ERROR: A-axis output direction mode is not ACP/ACN/DC. A=", nR1pos}
        abort
    endif
    ; Track only emitted A words, at their 0.001 degree output resolution.
    if abs(nR1pos) >= 0.0005
        bWorkpieceUsesA = true
    endif
    if iR1dirMode eq 1
        {cR1,'=ACN(' nR1pos ') '}
    endif
    if iR1dirMode eq 2
        {cR1,'=ACP(' nR1pos ') '}
    endif
    if iR1dirMode eq 3
        {cR1,'=DC(' nR1pos ') '}
    endif
    iR1dirMode = 0
    bR1forceOutput = false
endp

@usr_4x_index
    ; Index A between operations (tmatrix in start_of_job, fourth_axis): M1 (bOptstpindex), then the turn.
    ;   i4xIndexMode: 0 = turn A in the current work offset, 1 = also step the work offset by
    ;   position-1 (G54, G55, ...).
    ;   i4xIndexClearanceMode: 0 = home first (sHomestrrot, the last A-turn or head homing string;
    ;   sHomestrrotv before the first rapid), 1 = tool Z level, 2 = tool start plane. Modes 1/2: the
    ;   previous job's level before the turn, this job's after it.
    call @usr_r1pos_calc
    if change(nR1pos)
        ; Turning A does not move Z. A homing clears bClimbZValid itself; a clearance move sets nLastPathZ.
        ; The index is not a tracked feed start (A and possibly Z moved).
        bFeedPrevValid = false
        if bOptstpindex and !bStopSinceMotion
            ; Not right after another stop with no motion since (the job M1 of a same-tool job).
            call @usr_optionalstop
        endif
        call @usr_4x_index_rotate
    endif
endp

@usr_4x_index_rotate
    ; Index modes 0 and 1: clearance, the G0 A block (in mode 1 with the next work offset), clearance.
    iMotionmode = 0
    if i4xIndexClearanceMode eq 0
        sHomestr = sHomestrrot
        if sHomestr eq ''
            ; An index before the first rapid of the program: no head or A-turn homing string is
            ; chosen yet. Home with the head homing string, like every later index after its M1 (the
            ; axes may have moved during the stop, the program start homing may be off; PP-053).
            sHomestr = sHomestrrotv
        endif
        call @usr_prep_home_axis
    endif
    if i4xIndexClearanceMode eq 1
        if tool_z_level < tool_start_plane
            Print 'WARNING!! Tool Z Level is below Tool Start Plane in CoordSys'
            {nl,'WARNING!! Tool Z Level is below Tool Start Plane in CoordSys'}
        endif
        {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' '],'Z'nPtool_z_level ' '}
    endif
    if i4xIndexClearanceMode eq 2
        {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' '],'Z'nPtool_start_plane ' '}
    endif
    if i4xIndexClearanceMode ne 0 and (iCompActive eq 41 or iCompActive eq 42)
        ; Compensation still on: deselect it at the clearance height, before A turns.
        call @usr_trc_cancel
    endif
    if i4xIndexMode eq 1
        iWorkoffset = iWorkoffset + (position-1)
    endif
    {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' ']}
    call @usr_r1_output
    if i4xIndexClearanceMode eq 1
        {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' '],'Z'tool_z_level ' '}
        nLastPathZ = tool_z_level
    endif
    if i4xIndexClearanceMode eq 2
        {nb,['G'iMotionmode:mcode_f ' '],['G'iMplane' '],[cWo,iWorkoffset' '],['G'iAbsincmode ' '],'Z'tool_start_plane ' '}
        nLastPathZ = tool_start_plane
    endif
    if i4xIndexMode eq 1 and i4xIndexClearanceMode ne 0
        nLastPathWorkoffset = iWorkoffset
    endif
endp

@move_4x
    ; SolidCAM event: 4x rapid (usr_rapid; the A direction comes from dir5a, bR1useDir5a).
    ; A rotates around X on this machine: X is the axial coordinate and is posted as given.
    call @usr_camdbg_move(4)
    bR1useDir5a = true
    call @usr_rapid
    bR1useDir5a = false
endp

@line_4x
    ; SolidCAM event: 4x feed move (usr_smoothing_feed, usr_line; the A direction comes from dir5a,
    ; bR1useDir5a).
    call @usr_smoothing_feed
    bR1useDir5a = true
    call @usr_line
    bR1useDir5a = false
endp

@chng_tool_cnext
    ; SolidCAM information event: not needed.
endp

@rotary_info
    ; SolidCAM information event: not needed.
endp

@tmatrix
    ; SolidCAM CoordSys change: the index runs at the next @start_of_job (bTmatrixIndexPending). It ends
    ; a CAM link; clearance is required even when only the translation changed.
    bIndexClearancePending = true
    bCamLinkRetract = false
    bTmatrixIndexPending = true
endp

@move_5x
    ; SolidCAM event: 5x rapid (usr_rapid; the A direction comes from dir5a, bR1useDir5a).
    call @usr_camdbg_move(5)
    bR1useDir5a = true
    call @usr_rapid
    bR1useDir5a = false
endp

@line_5x
    ; SolidCAM event: 5x feed move (usr_smoothing_feed, usr_line; the A direction comes from dir5a,
    ; bR1useDir5a).
    call @usr_smoothing_feed
    bR1useDir5a = true
    call @usr_line
    bR1useDir5a = false
endp

@tool_path_info
    ; SolidCAM information event: not needed.
endp

@transform_info
    ; SolidCAM information event: not needed.
endp

@home_data
    ; SolidCAM CoordSys data event (VMID HomeDataAtStart). The post needs none of its data: the work
    ; offset comes from @home_number; no frame (CTRANS) is written.
endp
